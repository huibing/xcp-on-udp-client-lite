<div class="grid">
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="margin: 0;">Measurements</h2>
            <button id="addVarsBtn" class="btn" onclick="openModal()">+ Add Variables</button>
        </div>

        <div id="selectedList" style="max-height: 400px; overflow-y: auto;">
            <!-- Populated by JavaScript -->
        </div>

        <div id="emptyState" style="text-align: center; padding: 2rem; color: #666;">
            <p>No variables selected.</p>
            <p>Click "Add Variables" to select measurements.</p>
        </div>
    </div>

    <div class="card">
        <h2>Live Data <span id="daqStatus" class="tag stopped">STOPPED</span> <span id="elapsedTime" style="font-size: 0.8em; color: #888; margin-left: 12px;"></span></h2>
        <div id="liveData" style="max-height: 400px; overflow-y: auto;">
            <p style="color: #666; text-align: center;">No data (DAQ not running)</p>
        </div>
        <br>
        <div class="btn-group">
            <button id="startBtn" onclick="startDaq()">Start</button>
            <button id="recordBtn" onclick="startRecording()" class="danger" style="display: none;" title="Start Recording">⏺ Record</button>
            <button id="stopRecordBtn" onclick="stopRecording()" class="danger" style="display: none;" title="Stop Recording">⏹ Stop Rec</button>
            <button id="stopBtn" onclick="stopDaq()" class="secondary" style="display: none;">Stop</button>
            <button onclick="clearData()" class="secondary">Clear</button>
            <button id="graphBtn" onclick="toggleGraph()" class="secondary" title="Toggle Graph">📊 Graph</button>
        </div>
    </div>
</div>

<!-- Graph Panel (hidden by default) -->
<div id="graphPanel" class="card" style="display: none; margin-top: 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <h2 style="margin: 0;">Graph</h2>
        <div class="btn-group">
            <button class="secondary" onclick="clearChartData()" style="font-size: 0.85em;">Clear</button>
            <button class="secondary" onclick="toggleGraph()" style="font-size: 0.85em;">✕ Close</button>
        </div>
    </div>
    <div id="graphSignals" style="margin-bottom: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <span style="color: #888;">No data yet. Start DAQ to collect data.</span>
    </div>
    <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.85em;">
        <label style="display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
            <input type="checkbox" id="chartAutoFollow" checked onchange="chartAutoFollow = this.checked; drawChart();">
            Auto-follow
        </label>
        <button class="secondary" onclick="chartResetView()" style="font-size: 0.85em; padding: 2px 10px;">Reset View</button>
        <span style="color: #666; font-size: 0.8em;">Scroll: zoom X &nbsp;|&nbsp; Shift+Scroll: zoom Y &nbsp;|&nbsp; Drag: pan &nbsp;|&nbsp; Dbl-click: reset</span>
    </div>
    <canvas id="chartCanvas" style="width: 100%; height: 350px; background: #111; border-radius: 4px; cursor: crosshair;"></canvas>
    <div id="chartTooltip" style="display: none; position: absolute; background: rgba(30,30,50,0.95); color: #eee; padding: 6px 10px; border-radius: 4px; font-size: 0.8em; pointer-events: none; border: 1px solid #555; z-index: 10;"></div>
</div>
<div id="varModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 80%; min-width: 600px; max-width: 1200px; max-height: 80vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <h3 style="margin: 0;">Select Measurements</h3>
            <button onclick="closeModal()" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>

        <div class="modal-search" style="padding: 0.75rem 1rem; border-bottom: 1px solid #333;">
            <input type="text" id="varSearch" placeholder="Search measurements..." style="width: 100%;" oninput="filterVars()">
        </div>

        <div class="modal-body" id="modalBody" style="flex: 1; overflow-y: auto; padding: 0.5rem 0;">
            <table class="modal-table" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                <thead style="position: sticky; top: 0; background: #2a2a2a; z-index: 1;">
                    <tr>
                        <th style="width: 40px; padding: 0.5rem;"><input type="checkbox" id="selectAll" onclick="toggleSelectAll()"></th>
                        <th style="text-align: left; padding: 0.5rem; width: 35%;">Name</th>
                        <th style="text-align: left; padding: 0.5rem; width: 25%;">Device</th>
                        <th style="text-align: left; padding: 0.5rem; width: 15%;">Type</th>
                        <th style="text-align: left; padding: 0.5rem; width:15%;">Address</th>
                    </tr>
                </thead>
                <tbody id="availableVars">
                    <!-- Populated by JavaScript (lazy loading) -->
                </tbody>
            </table>
            <div id="loadingIndicator" style="text-align: center; padding: 1rem; color: #666; display: none;">
                Loading more variables...
            </div>
        </div>

        <div class="modal-footer" style="padding: 1rem; border-top: 1px solid #444; display: flex; justify-content: space-between; align-items: center;">
            <span id="selectedCount">0 variables selected</span>
            <div>
                <button class="secondary" onclick="closeModal()" style="margin-right: 0.5rem;">Cancel</button>
                <button class="btn" onclick="applySelection()">Apply Selection</button>
            </div>
        </div>
    </div>
</div>

<!-- Variable Info Modal -->
<div id="infoModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 600px; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <h3 id="infoTitle" style="margin: 0;">Variable Information</h3>
            <button onclick="closeInfoModal()" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" id="infoBody" style="flex: 1; overflow: auto; padding: 1rem;">
            <!-- Info content will be rendered here -->
        </div>
        <div class="modal-footer" style="padding: 1rem; border-top: 1px solid #444; display: flex; justify-content: space-between;">
            <button onclick="copyInfoToClipboard()" title="Copy all information">📋 Copy All</button>
            <button class="secondary" onclick="closeInfoModal()">Close</button>
        </div>
    </div>
</div>

<style>
