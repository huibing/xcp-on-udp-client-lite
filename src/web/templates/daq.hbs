function copyInfoToClipboard() {
    if (!currentInfoData) return;

    let text = `Measurement Information\n`;
    text += `======================\n`;
    text += `Name: ${currentInfoData.name}\n`;
    text += `Device: ${currentInfoData.device_name}\n`;
    text += `Type: ${currentInfoData.type}\n`;
    text += `Address: ${currentInfoData.address}\n`;
    text += `Address Extension: ${currentInfoData.address_ext}\n`;
    text += `Unit: ${currentInfoData.unit}\n`;
    text += `Data Size: ${currentInfoData.data_size}\n`;

    navigator.clipboard.writeText(text).then(() => {
        const btn = document.querySelector('#infoModal .modal-footer button');
        const originalText = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(() => {
            btn.textContent = originalText;
        }, 1500);
    }).catch(e => {
        alert('Failed to copy: ' + e.message);
    });
}

