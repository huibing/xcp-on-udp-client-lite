let availableEvents = [];
let selectedEventChannel = 0;
let measurementEvents = {}; // { measurement_idx: event_channel }

async function loadEvents() {
    try {
        const response = await fetch('/api/daq/events');
        const data = await response.json();
        if (data.success && data.events && data.events.length > 0) {
            availableEvents = data.events;
            selectedEventChannel = data.selected_channel;
            if (data.measurement_events) {
                measurementEvents = data.measurement_events;
            }
        }
    } catch (e) {
        console.error('Failed to load DAQ events:', e);
    }
}

function buildEventOptions(selectedChannel) {
    if (availableEvents.length === 0) return '';
    return availableEvents.map(e => {
        const selected = e.channel === selectedChannel ? 'selected' : '';
        return `<option value="${e.channel}" ${selected}>${escapeHtml(e.display_label)}</option>`;
    }).join('');
}

async function setMeasurementEvent(measurementIdx, channel) {
    channel = parseInt(channel);
    measurementEvents[measurementIdx.toString()] = channel;
    try {
        await fetch('/api/daq/measurement-events', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ assignments: [{ measurement_idx: measurementIdx, channel: channel }] })
        });
    } catch (e) {
        console.error('Failed to set measurement event:', e);
    }
}

async function setAllMeasurementEvents(channel) {
    channel = parseInt(channel);
    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );
    const assignments = selectedVars.map(v => ({
        measurement_idx: v.idx,
        channel: channel
    }));
    // Update local state
    assignments.forEach(a => {
        measurementEvents[a.measurement_idx.toString()] = channel;
    });
    try {
        await fetch('/api/daq/measurement-events', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ assignments })
        });
    } catch (e) {
        console.error('Failed to set all measurement events:', e);
    }
    renderSelectedVars();
}

// ========== Graph / Chart ==========
const MAX_CHART_POINTS = 2000;
const CHART_COLORS = [
    '#00ff88', '#ff4488', '#44aaff', '#ffaa00', '#aa44ff',
    '#ff6644', '#44ffaa', '#ff44ff', '#88ff44', '#4488ff',
    '#ff8800', '#00cccc', '#cc44cc', '#88ccff', '#ffcc44'
];

let chartTimestamps = [];
let chartSeries = {};      // { "device_id:var_name": [val, ...] }
let chartSignalNames = {}; // { "device_id:var_name": "display_name" }
let chartVisible = false;
let chartSelectedSignals = new Set();
// Chart layout constants
const CHART_ML = 70, CHART_MR = 20, CHART_MT = 10, CHART_MB = 30;

// Zoom/pan state (null = auto-scale)
let chartViewTMin = null;
let chartViewTMax = null;
let chartViewYMin = null;
let chartViewYMax = null;
let chartAutoFollow = true;

// Drag state
let chartDragging = false;
let chartDragStartX = 0;
let chartDragStartY = 0;
let chartDragTMin = 0;
let chartDragTMax = 0;
let chartDragYMin = 0;
let chartDragYMax = 0;

function toggleGraph() {
    chartVisible = !chartVisible;
    const panel = document.getElementById('graphPanel');
    panel.style.display = chartVisible ? 'block' : 'none';
    const btn = document.getElementById('graphBtn');
    btn.textContent = chartVisible ? '📊 Hide Graph' : '📊 Graph';
    if (chartVisible) {
        updateGraphSignalCheckboxes();
        drawChart();
    }
}

function accumulateChartData(data) {
    if (!data.values || data.values.length === 0) return;
    const ts = parseFloat(data.timestamp_s);
    if (isNaN(ts)) return;
    if (chartTimestamps.length > 0 && chartTimestamps[chartTimestamps.length - 1] === ts) return;

    chartTimestamps.push(ts);
    let newSignalAdded = false;

    data.values.forEach(v => {
        const key = `${v.device_id}:${v.var_name}`;
        if (!chartSeries[key]) {
            chartSeries[key] = new Array(chartTimestamps.length - 1).fill(NaN);
            chartSignalNames[key] = v.var_name;
            chartSelectedSignals.add(key);
            newSignalAdded = true;
        }
        chartSeries[key].push(parseFloat(v.value));
    });

    // Fill missing signals with last known value
    for (const key of Object.keys(chartSeries)) {
        while (chartSeries[key].length < chartTimestamps.length) {
            const arr = chartSeries[key];
            arr.push(arr.length > 0 ? arr[arr.length - 1] : NaN);
        }
    }

    // Trim to max points
    if (chartTimestamps.length > MAX_CHART_POINTS) {
        const excess = chartTimestamps.length - MAX_CHART_POINTS;
        chartTimestamps.splice(0, excess);
        for (const key of Object.keys(chartSeries)) {
            chartSeries[key].splice(0, excess);
        }
    }

    if (newSignalAdded && chartVisible) {
        updateGraphSignalCheckboxes();
    }
}

function clearChartData() {
    chartTimestamps = [];
    chartSeries = {};
    chartSignalNames = {};
    chartSelectedSignals.clear();
    chartResetView();
    updateGraphSignalCheckboxes();
    drawChart();
}

function chartResetView() {
    chartViewTMin = null;
    chartViewTMax = null;
    chartViewYMin = null;
    chartViewYMax = null;
    chartAutoFollow = true;
    const cb = document.getElementById('chartAutoFollow');
    if (cb) cb.checked = true;
    if (chartVisible) drawChart();
}

// Compute the full data range for Y-axis across selected signals
function chartFullYRange() {
    const allKeys = Object.keys(chartSeries);
    const signalKeys = allKeys.filter(k => chartSelectedSignals.has(k));
    let yMin = Infinity, yMax = -Infinity;
    signalKeys.forEach(key => {
        chartSeries[key].forEach(v => {
            if (!isNaN(v) && isFinite(v)) {
                if (v < yMin) yMin = v;
                if (v > yMax) yMax = v;
            }
        });
    });
    if (!isFinite(yMin)) { yMin = 0; yMax = 1; }
    let yRange = yMax - yMin;
    if (yRange === 0) { yRange = 1; yMin -= 0.5; yMax += 0.5; }
    yMin -= yRange * 0.05;
    yMax += yRange * 0.05;
    return { yMin, yMax };
}

function updateGraphSignalCheckboxes() {
    const container = document.getElementById('graphSignals');
    const signalKeys = Object.keys(chartSeries);
    if (signalKeys.length === 0) {
        container.innerHTML = '<span style="color: #888;">No data yet. Start DAQ to collect data.</span>';
        return;
    }

    let html = '';
    signalKeys.forEach((key, i) => {
        const color = CHART_COLORS[i % CHART_COLORS.length];
        const checked = chartSelectedSignals.has(key) ? 'checked' : '';
        const name = chartSignalNames[key] || key;
        html += `<label style="display: inline-flex; align-items: center; gap: 4px; cursor: pointer; padding: 2px 8px; border-radius: 4px; background: #2a2a3a;">
            <input type="checkbox" ${checked} onchange="toggleChartSignal('${key.replace(/'/g, "\\'")}')">
            <span style="display: inline-block; width: 14px; height: 3px; background: ${color}; border-radius: 1px;"></span>
            <span style="font-size: 0.85em;">${escapeHtml(name)}</span>
        </label>`;
    });
    container.innerHTML = html;
}

function toggleChartSignal(key) {
    if (chartSelectedSignals.has(key)) {
        chartSelectedSignals.delete(key);
    } else {
        chartSelectedSignals.add(key);
    }
    drawChart();
}

function drawChart() {
    const canvas = document.getElementById('chartCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    // Handle high DPI and actual dimensions
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
    const W = rect.width;
    const H = rect.height;

    const ML = CHART_ML, MR = CHART_MR, MT = CHART_MT, MB = CHART_MB;
    const plotW = W - ML - MR;
    const plotH = H - MT - MB;

    // Clear
    ctx.fillStyle = '#111';
    ctx.fillRect(0, 0, W, H);

    // Get selected signal keys (preserve insertion order)
    const allKeys = Object.keys(chartSeries);
    const signalKeys = allKeys.filter(k => chartSelectedSignals.has(k));

    if (chartTimestamps.length < 2 || signalKeys.length === 0) {
        ctx.fillStyle = '#666';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(chartTimestamps.length < 2 ? 'Waiting for data...' : 'Select signals to display', W / 2, H / 2);
        return;
    }

    // Determine X range (time)
    const dataT0 = chartTimestamps[0];
    const dataT1 = chartTimestamps[chartTimestamps.length - 1];
    let tMin, tMax;
    if (chartViewTMin !== null && chartViewTMax !== null) {
        tMin = chartViewTMin;
        tMax = chartViewTMax;
        // Auto-follow: shift window to include latest data
        if (chartAutoFollow && dataT1 > tMax) {
            const span = tMax - tMin;
            tMax = dataT1;
            tMin = tMax - span;
            chartViewTMin = tMin;
            chartViewTMax = tMax;
        }
    } else {
        tMin = dataT0;
        tMax = dataT1;
    }
    const tRange = tMax - tMin || 1;

    // Determine Y range
    let yMin, yMax;
    if (chartViewYMin !== null && chartViewYMax !== null) {
        yMin = chartViewYMin;
        yMax = chartViewYMax;
    } else {
        // Auto Y: scan only visible data range for better scaling
        yMin = Infinity;
        yMax = -Infinity;
        signalKeys.forEach(key => {
            const data = chartSeries[key];
            for (let i = 0; i < data.length; i++) {
                const t = chartTimestamps[i];
                if (t < tMin || t > tMax) continue;
                const v = data[i];
                if (!isNaN(v) && isFinite(v)) {
                    if (v < yMin) yMin = v;
                    if (v > yMax) yMax = v;
                }
            }
        });
        if (!isFinite(yMin)) { yMin = 0; yMax = 1; }
        let yR = yMax - yMin;
        if (yR === 0) { yR = 1; yMin -= 0.5; yMax += 0.5; }
        yMin -= yR * 0.05;
        yMax += yR * 0.05;
    }
    const yRange = yMax - yMin || 1;

    const toX = t => ML + ((t - tMin) / tRange) * plotW;
    const toY = v => MT + plotH - ((v - yMin) / yRange) * plotH;

    // Draw grid
    ctx.strokeStyle = '#2a2a2a';
    ctx.lineWidth = 0.5;

    const yTicks = 5;
    for (let i = 0; i <= yTicks; i++) {
        const y = MT + (plotH / yTicks) * i;
        ctx.beginPath();
        ctx.moveTo(ML, y);
        ctx.lineTo(ML + plotW, y);
        ctx.stroke();

        const val = yMax - (i / yTicks) * yRange;
        ctx.fillStyle = '#888';
        ctx.font = '10px monospace';
        ctx.textAlign = 'right';
        ctx.fillText(fmtAxis(val), ML - 5, y + 3);
    }

    const xTicks = 5;
    for (let i = 0; i <= xTicks; i++) {
        const x = ML + (plotW / xTicks) * i;
        ctx.beginPath();
        ctx.moveTo(x, MT);
        ctx.lineTo(x, MT + plotH);
        ctx.stroke();

        const t = tMin + (i / xTicks) * tRange;
        ctx.fillStyle = '#888';
        ctx.font = '10px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(t.toFixed(2) + 's', x, MT + plotH + 15);
    }

    // Plot border
    ctx.strokeStyle = '#444';
    ctx.lineWidth = 1;
    ctx.strokeRect(ML, MT, plotW, plotH);

    // Clip to plot area for signal drawing
    ctx.save();
    ctx.beginPath();
    ctx.rect(ML, MT, plotW, plotH);
    ctx.clip();

    // Draw signal lines
    signalKeys.forEach(key => {
        const colorIdx = allKeys.indexOf(key);
        const color = CHART_COLORS[colorIdx % CHART_COLORS.length];
        const data = chartSeries[key];
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        let started = false;
        for (let i = 0; i < data.length; i++) {
            if (isNaN(data[i])) { started = false; continue; }
            const x = toX(chartTimestamps[i]);
            const y = toY(data[i]);
            if (!started) { ctx.moveTo(x, y); started = true; }
            else { ctx.lineTo(x, y); }
        }
        ctx.stroke();
    });

    ctx.restore();
}

function fmtAxis(v) {
    const a = Math.abs(v);
    if (a === 0) return '0';
    if (a >= 10000) return v.toFixed(0);
    if (a >= 100) return v.toFixed(1);
    if (a >= 1) return v.toFixed(2);
    if (a >= 0.01) return v.toFixed(4);
    return v.toExponential(2);
}

// Chart interaction: zoom, pan, tooltip, double-click reset
(function() {
    const canvas = document.getElementById('chartCanvas');
    if (!canvas) return;

    // Helper: get effective view ranges (matching drawChart logic)
    function getViewRanges() {
        if (chartTimestamps.length < 2) return null;
        const dataT0 = chartTimestamps[0];
        const dataT1 = chartTimestamps[chartTimestamps.length - 1];
        let tMin = chartViewTMin !== null ? chartViewTMin : dataT0;
        let tMax = chartViewTMax !== null ? chartViewTMax : dataT1;
        const tRange = tMax - tMin || 1;

        let yMin, yMax;
        if (chartViewYMin !== null && chartViewYMax !== null) {
            yMin = chartViewYMin;
            yMax = chartViewYMax;
        } else {
            const yr = chartFullYRange();
            yMin = yr.yMin;
            yMax = yr.yMax;
        }
        const yRange = yMax - yMin || 1;
        return { tMin, tMax, tRange, yMin, yMax, yRange };
    }

    // Mouse wheel: zoom
    canvas.addEventListener('wheel', function(e) {
        e.preventDefault();
        if (chartTimestamps.length < 2) return;

        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        const plotW = rect.width - CHART_ML - CHART_MR;
        const plotH = rect.height - CHART_MT - CHART_MB;

        const ranges = getViewRanges();
        if (!ranges) return;

        const zoomFactor = e.deltaY > 0 ? 1.15 : 0.87; // scroll down = zoom out

        if (e.shiftKey) {
            // Zoom Y-axis centered on cursor
            const yFrac = 1 - (my - CHART_MT) / plotH;
            const yCenter = ranges.yMin + yFrac * ranges.yRange;
            const newYRange = ranges.yRange * zoomFactor;
            chartViewYMin = yCenter - yFrac * newYRange;
            chartViewYMax = yCenter + (1 - yFrac) * newYRange;
        } else {
            // Zoom X-axis centered on cursor
            const xFrac = (mx - CHART_ML) / plotW;
            const tCenter = ranges.tMin + xFrac * ranges.tRange;
            const newTRange = ranges.tRange * zoomFactor;
            chartViewTMin = tCenter - xFrac * newTRange;
            chartViewTMax = tCenter + (1 - xFrac) * newTRange;
            // Disable auto-follow when user zooms X
            chartAutoFollow = false;
            const cb = document.getElementById('chartAutoFollow');
            if (cb) cb.checked = false;
        }

        drawChart();
    }, { passive: false });

    // Mouse drag: pan
    canvas.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (chartTimestamps.length < 2) return;

        const ranges = getViewRanges();
        if (!ranges) return;

        chartDragging = true;
        chartDragStartX = e.clientX;
        chartDragStartY = e.clientY;
        chartDragTMin = ranges.tMin;
        chartDragTMax = ranges.tMax;
        chartDragYMin = ranges.yMin;
        chartDragYMax = ranges.yMax;
        canvas.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', function(e) {
        const tooltip = document.getElementById('chartTooltip');

        if (chartDragging) {
            const rect = canvas.getBoundingClientRect();
            const plotW = rect.width - CHART_ML - CHART_MR;
            const plotH = rect.height - CHART_MT - CHART_MB;

            const dx = e.clientX - chartDragStartX;
            const dy = e.clientY - chartDragStartY;

            const tSpan = chartDragTMax - chartDragTMin;
            const ySpan = chartDragYMax - chartDragYMin;

            chartViewTMin = chartDragTMin - (dx / plotW) * tSpan;
            chartViewTMax = chartDragTMax - (dx / plotW) * tSpan;
            chartViewYMin = chartDragYMin + (dy / plotH) * ySpan;
            chartViewYMax = chartDragYMax + (dy / plotH) * ySpan;

            chartAutoFollow = false;
            const cb = document.getElementById('chartAutoFollow');
            if (cb) cb.checked = false;

            tooltip.style.display = 'none';
            drawChart();
            return;
        }

        // Tooltip (only when not dragging)
        if (!chartVisible || chartTimestamps.length < 2) {
            tooltip.style.display = 'none';
            return;
        }

        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const plotW = rect.width - CHART_ML - CHART_MR;

        if (mx < CHART_ML || mx > CHART_ML + plotW) {
            tooltip.style.display = 'none';
            return;
        }

        const ranges = getViewRanges();
        if (!ranges) { tooltip.style.display = 'none'; return; }

        const t = ranges.tMin + ((mx - CHART_ML) / plotW) * ranges.tRange;

        // Find nearest timestamp index (binary search for performance)
        let lo = 0, hi = chartTimestamps.length - 1;
        while (lo < hi) {
            const mid = (lo + hi) >> 1;
            if (chartTimestamps[mid] < t) lo = mid + 1;
            else hi = mid;
        }
        if (lo > 0 && Math.abs(chartTimestamps[lo - 1] - t) < Math.abs(chartTimestamps[lo] - t)) lo--;
        const idx = lo;

        const allKeys = Object.keys(chartSeries);
        const signalKeys = allKeys.filter(k => chartSelectedSignals.has(k));
        if (signalKeys.length === 0) { tooltip.style.display = 'none'; return; }

        let html = `<b>t = ${chartTimestamps[idx].toFixed(4)}s</b><br>`;
        signalKeys.forEach(key => {
            const colorIdx = allKeys.indexOf(key);
            const color = CHART_COLORS[colorIdx % CHART_COLORS.length];
            const v = chartSeries[key][idx];
            const name = chartSignalNames[key] || key;
            html += `<span style="color:${color}">●</span> ${escapeHtml(name)}: ${isNaN(v) ? '-' : v.toFixed(6)}<br>`;
        });

        tooltip.innerHTML = html;
        tooltip.style.display = 'block';
        tooltip.style.left = (e.clientX + 12) + 'px';
        tooltip.style.top = (e.clientY - 10) + 'px';
    });

    window.addEventListener('mouseup', function() {
        if (chartDragging) {
            chartDragging = false;
            canvas.style.cursor = 'crosshair';
        }
    });

    canvas.addEventListener('mouseleave', function() {
        document.getElementById('chartTooltip').style.display = 'none';
    });

    // Double-click: reset view
    canvas.addEventListener('dblclick', function() {
        chartResetView();
    });
})();
</script>
