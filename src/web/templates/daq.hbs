    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}
.modal-content {
    background: #1e1e1e;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}
.modal-table th, .modal-table td {
    text-align: left;
    padding: 0.5rem;
    border-bottom: 1px solid #333;
}
.modal-table tr:hover {
    background: #2a2a2a;
}
.modal-table tr.selected-row {
    background: #1a4a1a;
}
.modal-table tr.selected-row:hover {
    background: #2a5a2a;
}
.tag.running { background: #00ff88; color: #000; }
.tag.stopped { background: #555; color: #fff; }
.daq-item {
