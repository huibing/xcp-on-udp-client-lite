</style>

<!-- Download Popup Modal (shown after recording stops) -->
<div id="downloadModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 400px; max-width: 90vw;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <h3 style="margin: 0;">📁 Recording Complete</h3>
            <button onclick="closeDownloadModal()" style="background: none; border: none; color: #aaa; font-size: 1.2em; cursor: pointer;">✕</button>
        </div>
        <div style="padding: 1.5rem;">
            <p style="color: #ccc; margin-bottom: 1rem;">Recording has been saved. Choose a format to download:</p>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <button onclick="downloadFile('csv')" class="btn" style="width: 100%; padding: 0.75rem;">⬇ Download CSV</button>
                <button onclick="downloadFile('mf4')" class="btn" style="width: 100%; padding: 0.75rem;">⬇ Download MDF4</button>
                <button onclick="downloadBoth()" class="btn secondary" style="width: 100%; padding: 0.75rem;">⬇ Download Both</button>
            </div>
            <div style="margin-top: 1rem; text-align: right;">
                <button onclick="closeDownloadModal()" class="secondary" style="padding: 0.5rem 1rem;">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
let allVariables = [];
let selectedKeys = new Set();
let tempSelectedKeys = new Set();
let daqRunning = false;
let daqRecording = false;
let refreshInterval = null;
// Lazy loading state
let displayedCount = 0;
const BATCH_SIZE = 50;
let isLoadingMore = false;
let filteredVariables = [];
const STORAGE_PREFIX = 'daq'; // Prefix for localStorage keys

document.addEventListener('DOMContentLoaded', async () => {
    await loadAvailableVars();
    await loadEvents();
    loadSelectionFromStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    renderSelectedVars();
    checkDaqStatus();

    // Reload variables when page becomes visible (after connecting device)
    document.addEventListener('visibilitychange', async () => {
        if (!document.hidden) {
            await loadAvailableVars();
            loadSelectionFromStorage(STORAGE_PREFIX, allVariables, selectedKeys);
            renderSelectedVars();
        }
    });
});

async function loadAvailableVars() {
    try {
        const response = await fetch('/api/daq/available');
        const data = await response.json();
        if (data.success) {
            allVariables = data.variables;
        }
    } catch (e) {
        console.error('Failed to load available variables:', e);
    }
}

function openModal() {
    // Check if DAQ is running
    if (daqRunning) {
        alert('Please stop DAQ before adding or removing variables.');
        return;
    }

    tempSelectedKeys = new Set(selectedKeys);
    // Reset lazy loading state
    displayedCount = 0;
    filteredVariables = [];
    isLoadingMore = false;
    renderAvailableVars();
    document.getElementById('varModal').style.display = 'flex';
    document.getElementById('varSearch').focus();
    // Setup scroll listener for lazy loading
    setupScrollListener();
}

function closeModal() {
    document.getElementById('varModal').style.display = 'none';
}

function setupScrollListener() {
    const modalBody = document.getElementById('modalBody');
    // Remove existing listener by cloning
    const newModalBody = modalBody.cloneNode(true);
    modalBody.parentNode.replaceChild(newModalBody, modalBody);
    // Re-get the reference after replacement
    const freshModalBody = document.getElementById('modalBody');
    freshModalBody.addEventListener('scroll', handleScroll);
}

function handleScroll() {
    const modalBody = document.getElementById('modalBody');
    const loadingIndicator = document.getElementById('loadingIndicator');

    // Check if scrolled near bottom
    if (modalBody.scrollTop + modalBody.clientHeight >= modalBody.scrollHeight - 100) {
        if (!isLoadingMore && displayedCount < filteredVariables.length) {
            loadMoreVars();
        }
    }
}

function loadMoreVars() {
    if (isLoadingMore || displayedCount >= filteredVariables.length) return;

    isLoadingMore = true;
    const loadingIndicator = document.getElementById('loadingIndicator');
    loadingIndicator.style.display = 'block';

    // Simulate small delay for better UX
    setTimeout(() => {
        const tbody = document.getElementById('availableVars');
        const nextBatch = filteredVariables.slice(displayedCount, displayedCount + BATCH_SIZE);

        const html = nextBatch.map(v => {
            const key = `${v.device_id}:${v.name}`;
            const selected = tempSelectedKeys.has(key);
            const rowClass = selected ? 'selected-row' : '';
            return `
                <tr class="${rowClass}" onclick="toggleVar('${key}')" style="cursor: pointer;">
                    <td style="width: 40px;">${selected ? '✓' : ''}</td>
                    <td style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(v.name)}">${escapeHtml(v.name)}</td>
                    <td style="color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(v.device_name)}</td>
                    <td>${v.type}</td>
                    <td style="font-family: monospace;">0x${v.address_hex}</td>
                </tr>
            `;
        }).join('');

        tbody.insertAdjacentHTML('beforeend', html);
        displayedCount += nextBatch.length;

        loadingIndicator.style.display = displayedCount < filteredVariables.length ? 'block' : 'none';
        isLoadingMore = false;
    }, 50);
}

function renderAvailableVars() {
    const tbody = document.getElementById('availableVars');
    const searchTerm = document.getElementById('varSearch').value.toLowerCase();

    // Filter all variables
    filteredVariables = allVariables.filter(v =>
        v.name.toLowerCase().includes(searchTerm) ||
        v.device_name.toLowerCase().includes(searchTerm)
    );

    // Reset display count
    displayedCount = 0;

    // Clear tbody
    tbody.innerHTML = '';

    // Render first batch
    const firstBatch = filteredVariables.slice(0, BATCH_SIZE);
    tbody.innerHTML = firstBatch.map(v => {
        const key = `${v.device_id}:${v.name}`;
        const selected = tempSelectedKeys.has(key);
        const rowClass = selected ? 'selected-row' : '';
        return `
            <tr class="${rowClass}" onclick="toggleVar('${key}')" style="cursor: pointer;">
                <td style="width: 40px;">${selected ? '✓' : ''}</td>
                <td style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(v.name)}">${escapeHtml(v.name)}</td>
                <td style="color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(v.device_name)}</td>
                <td>${v.type}</td>
                <td style="font-family: monospace;">0x${v.address_hex}</td>
            </tr>
        `;
    }).join('');

    displayedCount = firstBatch.length;

    const loadingIndicator = document.getElementById('loadingIndicator');
    loadingIndicator.style.display = displayedCount < filteredVariables.length ? 'block' : 'none';

    updateSelectedCount();
    updateSelectAllCheckbox();
}

function filterVars() {
    renderAvailableVars();
}

function toggleVar(key) {
    const wasSelected = tempSelectedKeys.has(key);
    if (wasSelected) {
        tempSelectedKeys.delete(key);
    } else {
        tempSelectedKeys.add(key);
    }
    updateSelectedCount();
    updateSelectAllCheckbox();

    // Update row style without re-rendering
    const rows = document.querySelectorAll('#availableVars tr');
    rows.forEach(row => {
        const onclick = row.getAttribute('onclick');
        if (onclick && onclick.includes(`'${key}'`)) {
            const firstTd = row.querySelector('td:first-child');
            if (wasSelected) {
                row.classList.remove('selected-row');
                if (firstTd) firstTd.textContent = '';
            } else {
                row.classList.add('selected-row');
                if (firstTd) firstTd.textContent = '✓';
            }
        }
    });
}

function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll');

    if (selectAll.checked) {
        filteredVariables.forEach(v => {
            tempSelectedKeys.add(`${v.device_id}:${v.name}`);
        });
    } else {
        filteredVariables.forEach(v => {
            tempSelectedKeys.delete(`${v.device_id}:${v.name}`);
        });
    }
    renderAvailableVars();
}

function updateSelectedCount() {
    document.getElementById('selectedCount').textContent =
        `${tempSelectedKeys.size} variable${tempSelectedKeys.size !== 1 ? 's' : ''} selected`;
}

function updateSelectAllCheckbox() {
    const selectAll = document.getElementById('selectAll');

    if (filteredVariables.length === 0) {
        selectAll.checked = false;
        selectAll.indeterminate = false;
        return;
    }

    const allSelected = filteredVariables.every(v => tempSelectedKeys.has(`${v.device_id}:${v.name}`));
    const someSelected = filteredVariables.some(v => tempSelectedKeys.has(`${v.device_id}:${v.name}`));

    selectAll.checked = allSelected;
    selectAll.indeterminate = someSelected && !allSelected;
}

function applySelection() {
    selectedKeys = new Set(tempSelectedKeys);
    saveSelectionToStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    closeModal();
    renderSelectedVars();
    // Sync selection to backend
    syncSelectionToBackend();
}

async function syncSelectionToBackend() {
    // Build selections array - first clear all, then set selected
    const selections = [];

    // Clear all variables
    for (const v of allVariables) {
        selections.push({
            device_id: v.device_id,
            idx: v.idx,
            selected: false
        });
    }

    // Set selected ones
    for (const key of selectedKeys) {
        const [deviceId, name] = key.split(':');
        const v = allVariables.find(v => v.device_id === deviceId && v.name === name);
        if (v) {
            // Find and update the selection
            const existing = selections.find(s => s.device_id === v.device_id && s.idx === v.idx);
            if (existing) {
                existing.selected = true;
            }
        }
    }

    // Send single batch request
    try {
        await fetch('/api/daq/select', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ selections })
        });
    } catch (e) {
        console.error('Failed to sync selection:', e);
    }
}

function renderSelectedVars() {
    const list = document.getElementById('selectedList');
    const emptyState = document.getElementById('emptyState');
    const liveData = document.getElementById('liveData');

    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );

    if (selectedVars.length === 0) {
        list.innerHTML = '';
        liveData.innerHTML = '<p style="color: #666; text-align: center;">No data (DAQ not running)</p>';
        emptyState.style.display = 'block';
        return;
    }

    emptyState.style.display = 'none';

    // Render selected list
    renderSelectedList(selectedVars);

    // Render live data placeholders (fixed positions)
    liveData.innerHTML = selectedVars.map(v => {
        const key = `${v.device_id}:${v.name}`.replace(/:/g, '-');
        return `
            <div class="daq-item" data-var-key="${key}">
                <span class="name">
                    <span style="color: #888; font-size: 0.85em;">[${escapeHtml(v.device_name)}]</span>
                    ${escapeHtml(v.name)}
                </span>
                <span class="value" id="live-${key}">-</span>
            </div>
        `;
    }).join('');
}

function renderSelectedList(selectedVars) {
    const list = document.getElementById('selectedList');
    const hasEvents = availableEvents.length > 0;

    // Add "Set All Events" header if events are available and not running
    let headerHtml = '';
    if (hasEvents && !daqRunning && selectedVars.length > 0) {
        headerHtml = `
            <div style="display: flex; justify-content: flex-end; padding: 0.3rem 0.5rem; border-bottom: 1px solid #444; background: #1a1a1a;">
                <label style="color: #aaa; font-size: 0.8rem; margin-right: 0.3rem;">Set all events:</label>
                <select class="event-select" onchange="setAllMeasurementEvents(this.value)">
                    ${buildEventOptions(-1)}
                </select>
            </div>
        `;
    }

    list.innerHTML = headerHtml + selectedVars.map(v => {
        const key = `${v.device_id}:${v.name}`;
        const removeBtn = daqRunning
            ? ''
            : `<button class="secondary" onclick="removeVar('${key}')" title="Remove" style="padding: 0.2rem 0.5rem;">&times;</button>`;
        const currentEvent = measurementEvents[v.idx.toString()] !== undefined
            ? measurementEvents[v.idx.toString()]
            : selectedEventChannel;
        const eventSelect = hasEvents
            ? `<select class="event-select" onchange="setMeasurementEvent(${v.idx}, this.value)" ${daqRunning ? 'disabled' : ''}>
                   ${buildEventOptions(currentEvent)}
               </select>`
            : '';
        return `
            <div class="daq-item">
                <span class="name" style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <span style="color: #888; font-size: 0.85em;">[${escapeHtml(v.device_name)}]</span>
                    ${escapeHtml(v.name)}
                </span>
                <div class="btn-group" style="display: flex; align-items: center; gap: 0.3rem; flex-shrink: 0;">
                    ${eventSelect}
                    <button onclick="openInfoModal('${v.device_id}', ${v.idx}, '${escapeHtml(v.name)}')" title="Info" style="padding: 0.2rem 0.5rem;">ℹ️</button>
                    ${removeBtn}
                </div>
            </div>
        `;
    }).join('');
}

function removeVar(key) {
    selectedKeys.delete(key);
    saveSelectionToStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    renderSelectedVars();
    syncSelectionToBackend();
}

async function startDaq() {
    if (selectedKeys.size === 0) {
        alert('Please select at least one variable first');
        return;
    }

    // Sync selection to backend before starting
    await syncSelectionToBackend();

    try {
        const response = await fetch('/api/daq/start');
        const data = await response.json();
        if (data.success) {
            daqRunning = true;
            daqRecording = false;
            updateDaqStatus();
            updateSelectedListButtons();
            resetLiveValues();
            startRefresh();
        } else {
            alert('Failed to start DAQ: ' + data.error);
        }
    } catch (e) {
        alert('Failed to start DAQ: ' + e.message);
    }
}

async function startRecording() {
    if (!daqRunning) {
        alert('Start DAQ first before recording');
        return;
    }
    try {
        const response = await fetch('/api/daq/record/start', { method: 'POST' });
        const data = await response.json();
        if (data.success) {
            daqRecording = true;
            updateDaqStatus();
        } else {
            alert('Failed to start recording: ' + data.error);
        }
    } catch (e) {
        alert('Failed to start recording: ' + e.message);
    }
}

async function stopRecording() {
    try {
        const response = await fetch('/api/daq/record/stop', { method: 'POST' });
        const data = await response.json();
        if (data.success) {
            daqRecording = false;
            updateDaqStatus();
            // Show download popup
            document.getElementById('downloadModal').style.display = 'flex';
        } else {
            alert('Failed to stop recording: ' + data.error);
        }
    } catch (e) {
        alert('Failed to stop recording: ' + e.message);
    }
}

async function stopDaq() {
    const wasRecording = daqRecording;
    try {
        // If recording, stop recording first (backend handles this, but we want the popup)
        if (daqRecording) {
            const recResp = await fetch('/api/daq/record/stop', { method: 'POST' });
            await recResp.json();
            daqRecording = false;
        }

        const response = await fetch('/api/daq/stop');
        const data = await response.json();
        if (data.success) {
            daqRunning = false;
            daqRecording = false;
            updateDaqStatus();
            document.getElementById('elapsedTime').textContent = '';
            updateSelectedListButtons();
            stopRefresh();
            // Show download popup if was recording
            if (wasRecording) {
                document.getElementById('downloadModal').style.display = 'flex';
            }
        } else {
            alert('Failed to stop DAQ: ' + data.error);
        }
    } catch (e) {
        alert('Failed to stop DAQ: ' + e.message);
    }
}

function downloadFile(format) {
    window.location.href = '/api/daq/download/' + format;
}

function downloadBoth() {
    window.location.href = '/api/daq/download/csv';
    setTimeout(() => { window.location.href = '/api/daq/download/mf4'; }, 500);
}

function closeDownloadModal() {
    document.getElementById('downloadModal').style.display = 'none';
}

function updateSelectedListButtons() {
    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );
    renderSelectedList(selectedVars);
}

function resetLiveValues() {
    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );
    selectedVars.forEach(v => {
        const key = `${v.device_id}:${v.name}`.replace(/:/g, '-');
        const valueCell = document.getElementById(`live-${key}`);
        if (valueCell) {
            valueCell.textContent = '-';
        }
    });
}

async function clearData() {
    try {
        await fetch('/api/daq/clear');
        // Just reset values, don't re-render structure
        resetLiveValues();
    } catch (e) {
        console.error('Failed to clear data:', e);
    }
}

function updateDaqStatus() {
    const status = document.getElementById('daqStatus');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const recordBtn = document.getElementById('recordBtn');
    const stopRecordBtn = document.getElementById('stopRecordBtn');

    if (daqRecording) {
        // RECORDING state
        status.className = 'tag running';
        status.textContent = '⏺ RECORDING';
        status.style.color = '#ff4444';
        startBtn.style.display = 'none';
        recordBtn.style.display = 'none';
        stopRecordBtn.style.display = 'inline-block';
        stopBtn.style.display = 'inline-block';
    } else if (daqRunning) {
        // RUNNING (streaming only) state
        status.className = 'tag running';
        status.textContent = 'RUNNING';
        status.style.color = '';
        startBtn.style.display = 'none';
        recordBtn.style.display = 'inline-block';
        stopRecordBtn.style.display = 'none';
        stopBtn.style.display = 'inline-block';
    } else {
        // STOPPED state
        status.className = 'tag stopped';
        status.textContent = 'STOPPED';
        status.style.color = '';
        startBtn.style.display = 'inline-block';
        recordBtn.style.display = 'none';
        stopRecordBtn.style.display = 'none';
        stopBtn.style.display = 'none';
    }
}

async function checkDaqStatus() {
    try {
        const response = await fetch('/api/daq/status');
        const data = await response.json();
        daqRunning = data.running;
        daqRecording = data.recording || false;
        updateDaqStatus();
        updateSelectedListButtons();
        if (daqRunning) {
            startRefresh();
        }
    } catch (e) {
        console.error('Failed to check DAQ status:', e);
    }
}

function startRefresh() {
    if (refreshInterval) return;
    refreshInterval = setInterval(fetchLiveData, 500);
    fetchLiveData();
}

function stopRefresh() {
    if (refreshInterval) {
        clearInterval(refreshInterval);
        refreshInterval = null;
    }
}

async function fetchLiveData() {
    if (selectedKeys.size === 0) return;

    try {
        // Build filter for selected variables
        const selectedVars = allVariables.filter(v =>
            selectedKeys.has(`${v.device_id}:${v.name}`)
        );

        const response = await fetch('/api/daq/data', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                variables: selectedVars.map(v => ({
                    device_id: v.device_id,
                    name: v.name
                }))
            })
        });
        const data = await response.json();

        if (data.values && data.values.length > 0) {
            // Update elapsed timestamp display
            if (data.timestamp_s !== undefined) {
                const ts = parseFloat(data.timestamp_s);
                document.getElementById('elapsedTime').textContent = 't = ' + ts.toFixed(3) + ' s';
            }
            // Update values in place without re-rendering
            data.values.forEach(v => {
                const key = `${v.device_id}:${v.var_name}`.replace(/:/g, '-');
                const valueCell = document.getElementById(`live-${key}`);
                if (valueCell) {
                    valueCell.textContent = v.value;
                }
            });

            // Accumulate data for graph
            accumulateChartData(data);
            if (chartVisible) {
                drawChart();
            }
        }
    } catch (e) {
        console.error('Failed to fetch live data:', e);
    }
}

// Variable Info Modal functions
let currentInfoData = null;

async function openInfoModal(deviceId, idx, name) {
    document.getElementById('infoTitle').textContent = name;
    document.getElementById('infoModal').style.display = 'flex';
    document.getElementById('infoBody').innerHTML = '<p style="text-align: center; color: #888;">Loading...</p>';

    try {
        const response = await fetch(`/api/daq/detail/${deviceId}/${idx}`);
        const data = await response.json();

        if (data.success) {
            currentInfoData = data.detail;
            renderInfoContent(data.detail);
        } else {
            document.getElementById('infoBody').innerHTML = `<p style="color: #ff4444;">Error: ${escapeHtml(data.error)}</p>`;
        }
    } catch (e) {
        document.getElementById('infoBody').innerHTML = `<p style="color: #ff4444;">Failed to load: ${escapeHtml(e.message)}</p>`;
    }
}

function closeInfoModal() {
    document.getElementById('infoModal').style.display = 'none';
    currentInfoData = null;
}

function renderInfoContent(detail) {
    const container = document.getElementById('infoBody');

    let html = '<table style="width: 100%; border-collapse: collapse;">';
    html += createInfoRow('Name', detail.name);
    html += createInfoRow('Device', detail.device_name);
    html += createInfoRow('Type', detail.type);
    html += createInfoRow('Address', detail.address);
    html += createInfoRow('Address Extension', detail.address_ext);
    html += createInfoRow('Unit', detail.unit);
    html += createInfoRow('Data Size', detail.data_size);
