<style>
.compare-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
.compare-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}
.compare-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    flex: 1;
}
.compare-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    background: #25253a;
    border: 1px solid #303050;
    cursor: pointer;
    white-space: nowrap;
}
.compare-tab.active {
    border-color: #00ff88;
    color: #00ff88;
}
.compare-tab .count {
    color: #888;
    font-size: 0.8rem;
}
.compare-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}
.compare-toolbar .actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}
.compare-session-meta {
    color: #888;
    font-size: 0.9rem;
}
.compare-source-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}
.compare-source-card {
    background: #16213e;
    border: 1px solid #0f3460;
    border-radius: 8px;
    padding: 1rem;
}
.compare-source-card h3 {
    margin-bottom: 0.75rem;
    color: #00ff88;
}
.compare-source-summary {
    margin-bottom: 0.75rem;
    padding: 0.75rem;
    background: #1a1a2e;
    border-radius: 6px;
    min-height: 4rem;
}
.compare-source-summary .detail {
    color: #888;
    font-size: 0.85rem;
    margin-top: 0.35rem;
}
.compare-upload-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
}
.compare-upload-actions button {
    flex: 1;
}
.compare-load-status {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    min-height: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 4px;
    padding: 0.3rem 0;
    transition: opacity 0.3s;
}
.compare-load-status:empty { opacity: 0; }
.compare-load-status-uploading { color: #56b0ff; }
.compare-load-status-processing { color: #ffaa00; }
.compare-load-status-success { color: #00ff88; }
.compare-load-status-error { color: #ff7b72; }
.compare-file-info {
    font-size: 0.8rem;
    color: #7ec8ff;
    margin-top: 0.25rem;
    min-height: 1rem;
}
.compare-file-info.warn { color: #ffa657; }
.compare-drop-zone {
    border: 2px dashed #2a3f5f;
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.5rem;
    transition: border-color 0.2s, background 0.2s;
}
.compare-drop-zone.dragover {
    border-color: #58a6ff;
    background: rgba(88, 166, 255, 0.07);
}
.compare-drop-hint {
    font-size: 0.75rem;
    color: #4a6e96;
    text-align: center;
    margin-bottom: 0.4rem;
    pointer-events: none;
    user-select: none;
}
.compare-spinner {
    display: inline-block;
    width: 13px;
    height: 13px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    flex-shrink: 0;
    animation: compareSpinAnim 0.7s linear infinite;
}
@keyframes compareSpinAnim { to { transform: rotate(360deg); } }
.compare-hidden {
    display: none;
}
.compare-empty {
    text-align: center;
    color: #888;
    padding: 2rem 1rem;
    border: 1px dashed #2d4d78;
    border-radius: 8px;
}
.compare-results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}
.compare-result-card {
    background: #16213e;
    border: 1px solid #0f3460;
    border-radius: 8px;
    overflow: visible;
}
.compare-result-card.diff {
    border-color: #ff7b72;
}
.compare-result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: #1b284a;
    border-bottom: 1px solid #0f3460;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    user-select: none;
}
.compare-result-header:hover {
    background: #1f3158;
}
.compare-result-card.collapsed .compare-result-header {
    border-bottom: none;
    border-radius: 8px;
}
.compare-result-card.collapsed .compare-merged-body {
    display: none;
}
.compare-collapse-btn {
    background: none;
    border: none;
    color: #8b97b8;
    font-size: 1rem;
    padding: 0 0.25rem;
    cursor: pointer;
    transition: transform 0.2s;
    flex-shrink: 0;
    line-height: 1;
}
.compare-result-card.collapsed .compare-collapse-btn {
    transform: rotate(-90deg);
}
.compare-merged-body {
    padding: 1rem;
    overflow-x: auto;
}
.compare-merged-scalar {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: "Courier New", monospace;
    font-size: 1rem;
    padding: 0.65rem 0.85rem;
    background: #101726;
    border-radius: 4px;
    min-width: 6rem;
}
.compare-merged-scalar.compare-diff-cell {
    background: #4a1f24;
}
.compare-merged-cell {
    vertical-align: top;
    padding: 0.2rem 0.5rem !important;
    min-width: 4.5rem;
}
.compare-cell-left {
    font-family: "Courier New", monospace;
    font-size: 0.82em;
    color: #58a6ff;
}
.compare-cell-right {
    font-family: "Courier New", monospace;
    font-size: 0.82em;
    color: #ffa657;
    border-top: 1px solid #2a2a44;
    margin-top: 0.15rem;
    padding-top: 0.15rem;
}
.compare-src-tag {
    display: inline-block;
    font-size: 0.65em;
    font-weight: 700;
    padding: 0.05rem 0.22rem;
    border-radius: 2px;
    margin-right: 0.2rem;
    vertical-align: middle;
}
.compare-src-tag.left {
    background: #1a3c5e;
    color: #58a6ff;
}
.compare-src-tag.right {
    background: #4a2c10;
    color: #ffa657;
}
.compare-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 1rem;
    font-size: 0.8rem;
    color: #aaa;
    font-weight: normal;
}
.compare-legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex-shrink: 0;
}
.compare-grid-wrapper {
    overflow-x: auto;
    max-width: 100%;
    margin-top: 0.25rem;
}
.compare-grid {
    border-collapse: collapse;
    width: auto;
    min-width: 100%;
    white-space: nowrap;
}
.compare-grid th,
.compare-grid td {
    border: 1px solid #303050;
    padding: 0.45rem 0.55rem;
    text-align: center;
    font-family: "Courier New", monospace;
}
.compare-grid th {
    color: #aaa;
    background: #23233a;
}
.compare-diff-cell {
    background: #4a1f24;
    color: #ffb3ad;
    font-weight: bold;
}
.compare-raw {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: #aaa;
    overflow-x: auto;
    word-break: break-all;
}
.compare-badge {
    display: inline-block;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
}
.compare-badge.match {
    background: #0f3d0f;
    color: #00ff88;
}
.compare-badge.diff {
    background: #4a1f24;
    color: #ff7b72;
}
.compare-badge.missing {
    background: #3d3410;
    color: #ffd33d;
}
.compare-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1200;
}
.compare-modal.compare-hidden {
    display: none;
}
.compare-modal-content {
    width: min(1100px, 92vw);
    max-height: 85vh;
    background: #1a1a2e;
    border: 1px solid #2d4d78;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.compare-modal-header,
.compare-modal-footer {
    padding: 1rem;
    border-bottom: 1px solid #303050;
}
.compare-modal-footer {
    border-bottom: none;
    border-top: 1px solid #303050;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}
.compare-modal-filters {
    padding: 0.75rem 1rem;
    display: flex;
    gap: 0.75rem;
    border-bottom: 1px solid #303050;
}
.compare-modal-filters input {
    flex: 1;
}
.compare-modal-body {
    overflow: auto;
}
.compare-variable-table {
    width: 100%;
    border-collapse: collapse;
}
.compare-variable-table th,
.compare-variable-table td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid #303050;
}
.compare-variable-table tbody tr {
    cursor: pointer;
}
.compare-variable-table tbody tr:hover {
    background: #24243a;
}
.compare-variable-table tbody tr.selected {
    background: #153828;
}
@media (max-width: 900px) {
    .compare-source-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="compare-page">
    <div class="compare-header">
        <div class="compare-tabs" id="compareTabs"></div>
        <button onclick="compareCreateSession()">+ New Session</button>
    </div>

    <div class="compare-toolbar">
        <div class="actions">
            <button class="secondary" onclick="compareRenameSession()">Rename Session</button>
            <button onclick="compareOpenVariableModal()">Select Variables</button>
            <button class="danger" onclick="compareDeleteSession()">Delete Session</button>
        </div>
        <div class="compare-session-meta" id="compareSessionMeta"></div>
    </div>

    <div class="compare-source-grid" id="compareSourceGrid"></div>

    <div class="compare-results" id="compareResults"></div>
</div>

<div id="compareVarModal" class="compare-modal compare-hidden" onclick="if(event.target===this)compareCloseVariableModal()">
    <div class="compare-modal-content">
        <div class="compare-modal-header">
            <h3 style="margin: 0;">Select Variables</h3>
        </div>
        <div class="compare-modal-filters">
            <input type="text" id="compareVarSearch" placeholder="Search variable name..." oninput="compareReloadVariables()">
            <select id="compareVarPresence" onchange="compareReloadVariables()">
                <option value="all">All Variables</option>
                <option value="common">Common Variables</option>
                <option value="left_only">Left Only</option>
                <option value="right_only">Right Only</option>
            </select>
        </div>
        <div class="compare-modal-body" id="compareVarModalBody" onscroll="compareMaybeLoadMoreVariables()">
            <table class="compare-variable-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">Pick</th>
                        <th>Name</th>
                        <th style="width: 140px;">Presence</th>
                        <th style="width: 180px;">Left Type</th>
                        <th style="width: 180px;">Right Type</th>
                    </tr>
                </thead>
                <tbody id="compareVarRows"></tbody>
            </table>
        </div>
        <div class="compare-modal-footer">
            <span id="compareVarSelectedCount">0 selected</span>
            <div style="display: flex; gap: 0.5rem;">
                <button class="secondary" onclick="compareCloseVariableModal()">Cancel</button>
                <button onclick="compareApplyVariableSelection()">Apply</button>
            </div>
        </div>
    </div>
</div>

<script>
const CompareState = {
    sessions: [],
    activeSessionId: null,
    rows: [],
    tempSelected: new Set(),
    variablePage: {
        offset: 0,
        limit: 100,
        total: 0,
        loading: false,
        exhausted: false,
    },
};

document.addEventListener('DOMContentLoaded', compareInit);

async function compareInit() {
    await compareRefreshSessions();
}

function compareActiveSession() {
    return CompareState.sessions.find(session => session.id === CompareState.activeSessionId) || null;
}

async function compareRefreshSessions(preferredId) {
    const response = await fetch('/api/compare/sessions');
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to load compare sessions');
        return;
    }
    CompareState.sessions = data.sessions || [];
    if (!CompareState.sessions.length) {
        CompareState.activeSessionId = null;
    } else if (preferredId && CompareState.sessions.some(session => session.id === preferredId)) {
        CompareState.activeSessionId = preferredId;
    } else if (!CompareState.sessions.some(session => session.id === CompareState.activeSessionId)) {
        CompareState.activeSessionId = CompareState.sessions[0].id;
    }
    compareRenderTabs();
    compareRenderSession();
    await compareRefreshResults();
}

function compareRenderTabs() {
    const container = document.getElementById('compareTabs');
    const activeId = CompareState.activeSessionId;
    container.innerHTML = CompareState.sessions.map(session => `
        <div class="compare-tab ${session.id === activeId ? 'active' : ''}" onclick="compareSelectSession('${session.id}')">
            <span>${escapeHtml(session.name)}</span>
            <span class="count">${(session.selected_variables || []).length}</span>
        </div>
    `).join('');
}

function compareRenderSession() {
    const session = compareActiveSession();
    const meta = document.getElementById('compareSessionMeta');
    const grid = document.getElementById('compareSourceGrid');
    if (!session) {
        meta.textContent = 'No active compare session';
        grid.innerHTML = '<div class="compare-empty">Create a compare session to start.</div>';
        return;
    }
    meta.textContent = `${session.name} - ${(session.selected_variables || []).length} variable(s) selected`;
    grid.innerHTML = [compareRenderSourceCard(session, 'left'), compareRenderSourceCard(session, 'right')].join('');
    compareSyncSourceInputs();
}

function compareRenderSourceCard(session, side) {
    const source = side === 'left' ? session.left_source : session.right_source;
    const title = side === 'left' ? 'Left Source' : 'Right Source';
    const selectedType = source?.kind || 'a2l_hex';
    return `
        <div class="compare-source-card">
            <h3>${title}</h3>
            <div class="compare-source-summary">
                ${source ? `
                    <div><strong>${escapeHtml(source.kind_label)}</strong>: ${escapeHtml(source.label)}</div>
                    <div class="detail">${escapeHtml(source.detail || '')}</div>
                    <div class="detail">${source.variable_count} variable(s)</div>
                ` : '<div class="detail">No source loaded.</div>'}
            </div>
            <div class="form-group">
                <label for="compareSourceType-${side}">Source Type</label>
                <select id="compareSourceType-${side}" onchange="compareToggleSourceInputs('${side}')">
                    <option value="a2l_hex" ${selectedType === 'a2l_hex' ? 'selected' : ''}>A2L + HEX</option>
                    <option value="dcm" ${selectedType === 'dcm' ? 'selected' : ''}>DCM</option>
                </select>
            </div>
            <div id="compareSourceA2lHex-${side}"
                 class="compare-drop-zone"
                 ondragover="compareDragOver(event,'${side}')"
                 ondragleave="compareDragLeave(event,'${side}')"
                 ondrop="compareDropFiles(event,'${side}','a2l_hex')">
                <div class="compare-drop-hint">⬇ Drop A2L + HEX files here, or browse below</div>
                <div class="form-group">
                    <label>A2L File</label>
                    <input type="file" id="compareA2lFile-${side}" accept=".a2l"
                           onchange="compareShowFilePick(this,'compareFileInfo-a2l-${side}')">
                    <div id="compareFileInfo-a2l-${side}" class="compare-file-info"></div>
                </div>
                <div class="form-group">
                    <label>HEX File</label>
                    <input type="file" id="compareHexFile-${side}" accept=".hex,.s19,.ihex,.txt"
                           onchange="compareShowFilePick(this,'compareFileInfo-hex-${side}')">
                    <div id="compareFileInfo-hex-${side}" class="compare-file-info"></div>
                </div>
            </div>
            <div id="compareSourceDcm-${side}" class="compare-hidden compare-drop-zone"
                 ondragover="compareDragOver(event,'${side}')"
                 ondragleave="compareDragLeave(event,'${side}')"
                 ondrop="compareDropFiles(event,'${side}','dcm')">
                <div class="compare-drop-hint">⬇ Drop DCM file here, or browse below</div>
                <div class="form-group">
                    <label>DCM File</label>
                    <input type="file" id="compareDcmFile-${side}" accept=".dcm,.DCM"
                           onchange="compareShowFilePick(this,'compareFileInfo-dcm-${side}')">
                    <div id="compareFileInfo-dcm-${side}" class="compare-file-info"></div>
                </div>
            </div>
            <div class="compare-upload-actions">
                <button id="compareLoadBtn-${side}" onclick="compareLoadSource('${side}')">Load</button>
                <button class="secondary" onclick="compareClearSource('${side}')">Clear</button>
            </div>
            <div id="compareLoadStatus-${side}" class="compare-load-status"></div>
        </div>
    `;
}

function compareSyncSourceInputs() {
    ['left', 'right'].forEach(compareToggleSourceInputs);
}

function compareShowFilePick(input, infoId) {
    const el = document.getElementById(infoId);
    if (!el) return;
    const file = input.files[0];
    if (!file) { el.textContent = ''; el.className = 'compare-file-info'; return; }
    const mb = (file.size / 1024 / 1024).toFixed(1);
    const warn = file.size > 20 * 1024 * 1024; // warn if >20 MB
    el.textContent = `✓ ${file.name}  (${mb} MB)${warn ? ' — large file, upload may take a moment' : ''}`;
    el.className = `compare-file-info${warn ? ' warn' : ''}`;
}

function compareDragOver(event, side) {
    event.preventDefault();
    event.dataTransfer.dropEffect = 'copy';
    // Find the actual drop zone element (may bubble up from child)
    const zone = event.currentTarget;
    if (zone) zone.classList.add('dragover');
}

function compareDragLeave(event, side) {
    // Only remove highlight when leaving the zone itself, not a child
    const zone = event.currentTarget;
    if (zone && !zone.contains(event.relatedTarget)) {
        zone.classList.remove('dragover');
    }
}

function compareSetFileInput(inputId, file, infoId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    try {
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
    } catch (_) { /* DataTransfer not supported; file won't show in native input */ }
    compareShowFilePick(input, infoId);
}

function compareDropFiles(event, side, zoneType) {
    event.preventDefault();
    const zone = event.currentTarget;
    if (zone) zone.classList.remove('dragover');
    const files = Array.from(event.dataTransfer.files);
    if (zoneType === 'a2l_hex') {
        files.forEach(file => {
            const ext = file.name.split('.').pop().toLowerCase();
            if (ext === 'a2l') {
                compareSetFileInput(`compareA2lFile-${side}`, file, `compareFileInfo-a2l-${side}`);
            } else if (['hex', 's19', 'ihex', 'mot', 'srec', 'txt'].includes(ext)) {
                compareSetFileInput(`compareHexFile-${side}`, file, `compareFileInfo-hex-${side}`);
            }
        });
    } else if (zoneType === 'dcm') {
        const dcmFile = files.find(f => /\.dcm$/i.test(f.name));
        if (dcmFile) {
            compareSetFileInput(`compareDcmFile-${side}`, dcmFile, `compareFileInfo-dcm-${side}`);
        }
    }
}

function compareToggleSourceInputs(side) {
    const sourceType = document.getElementById(`compareSourceType-${side}`).value;
    document.getElementById(`compareSourceA2lHex-${side}`).classList.toggle('compare-hidden', sourceType !== 'a2l_hex');
    document.getElementById(`compareSourceDcm-${side}`).classList.toggle('compare-hidden', sourceType !== 'dcm');
}

async function compareSelectSession(sessionId) {
    CompareState.activeSessionId = sessionId;
    compareRenderTabs();
    compareRenderSession();
    await compareRefreshResults();
}

async function compareCreateSession() {
    const response = await fetch('/api/compare/sessions', { method: 'POST' });
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to create compare session');
        return;
    }
    await compareRefreshSessions(data.session.id);
}

async function compareRenameSession() {
    const session = compareActiveSession();
    if (!session) return;
    const nextName = window.prompt('New session name', session.name);
    if (!nextName) return;
    const response = await fetch(`/api/compare/sessions/${session.id}/rename`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nextName }),
    });
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to rename session');
        return;
    }
    await compareRefreshSessions(session.id);
}

async function compareDeleteSession() {
    const session = compareActiveSession();
    if (!session) return;
    if (!window.confirm(`Delete ${session.name}?`)) return;
    const response = await fetch(`/api/compare/sessions/${session.id}/delete`, { method: 'POST' });
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to delete session');
        return;
    }
    await compareRefreshSessions();
}

async function compareLoadSource(side) {
    const session = compareActiveSession();
    if (!session) return;
    const formData = new FormData();
    const sourceType = document.getElementById(`compareSourceType-${side}`).value;
    formData.append('source_type', sourceType);
    if (sourceType === 'a2l_hex') {
        const a2lFile = document.getElementById(`compareA2lFile-${side}`).files[0];
        const hexFile = document.getElementById(`compareHexFile-${side}`).files[0];
        if (!a2lFile || !hexFile) {
            alert('Please choose both A2L and HEX files.');
            return;
        }
        formData.append('a2l_file', a2lFile);
        formData.append('hex_file', hexFile);
    } else {
        const dcmFile = document.getElementById(`compareDcmFile-${side}`).files[0];
        if (!dcmFile) {
            alert('Please choose a DCM file.');
            return;
        }
        formData.append('dcm_file', dcmFile);
    }

    const statusEl = document.getElementById(`compareLoadStatus-${side}`);
    const loadBtn = document.getElementById(`compareLoadBtn-${side}`);
    const setStatus = (state, msg) => {
        if (!statusEl) return;
        statusEl.className = `compare-load-status${state ? ' compare-load-status-' + state : ''}`;
        const spinner = (state === 'uploading' || state === 'processing')
            ? '<span class="compare-spinner"></span>' : '';
        statusEl.innerHTML = msg ? `${spinner}${escapeHtml(msg)}` : '';
    };

    if (loadBtn) { loadBtn.disabled = true; loadBtn.textContent = 'Uploading…'; }
    setStatus('uploading', 'Uploading files…');

    await new Promise((resolve) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', `/api/compare/sessions/${session.id}/sources/${side}/load`);

        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
                const pct = Math.round(e.loaded / e.total * 100);
                if (loadBtn) loadBtn.textContent = `Uploading ${pct}%…`;
                setStatus('uploading', `Uploading… ${pct}%`);
            }
        };
        xhr.upload.onload = () => {
            if (loadBtn) loadBtn.textContent = 'Processing…';
            setStatus('processing', 'Parsing calibration data on server…');
        };
        xhr.onload = () => resolve({ ok: true, text: xhr.responseText });
        xhr.onerror = () => resolve({ ok: false, text: null });
        xhr.send(formData);
    }).then(async ({ ok, text }) => {
        if (!ok || !text) {
            setStatus('error', 'Network error during upload.');
            return;
        }
        let data;
        try { data = JSON.parse(text); } catch { data = { success: false, error: 'Invalid server response.' }; }
        if (!data.success) {
            setStatus('error', data.error || 'Failed to load compare source.');
            return;
        }
        setStatus('success', 'Source loaded successfully!');
        setTimeout(() => setStatus('', ''), 3000);
        await compareRefreshSessions(session.id);
    }).finally(() => {
        if (loadBtn) { loadBtn.disabled = false; loadBtn.textContent = 'Load'; }
    });
}

async function compareClearSource(side) {
    const session = compareActiveSession();
    if (!session) return;
    const response = await fetch(`/api/compare/sessions/${session.id}/sources/${side}/clear`, { method: 'POST' });
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to clear compare source');
        return;
    }
    await compareRefreshSessions(session.id);
}

function compareToggleResultCard(headerEl) {
    headerEl.closest('.compare-result-card').classList.toggle('collapsed');
}

async function compareRefreshResults() {
    const session = compareActiveSession();
    const container = document.getElementById('compareResults');
    if (!session) {
        container.innerHTML = '';
        return;
    }
    const response = await fetch(`/api/compare/sessions/${session.id}/result`);
    const data = await response.json();
    if (!data.success) {
        container.innerHTML = `<div class="compare-empty">${escapeHtml(data.error || 'Failed to load compare result')}</div>`;
        return;
    }
    CompareState.rows = data.rows || [];
    if (!session.left_source && !session.right_source) {
        container.innerHTML = '<div class="compare-empty">Load one source on the left and one source on the right to compare values.</div>';
        return;
    }
    if (!CompareState.rows.length) {
        container.innerHTML = '<div class="compare-empty">No variables selected. Use "Select Variables" to choose compare targets.</div>';
        return;
    }
    container.innerHTML = CompareState.rows.map(compareRenderResultRow).join('');
}

function compareRenderResultRow(row) {
    const session = compareActiveSession();
    const leftName = session?.left_source?.name || 'Left';
    const rightName = session?.right_source?.name || 'Right';
    const badgeClass = row.matches ? 'match' : (row.presence === 'common' ? 'diff' : 'missing');
    const badgeLabel = row.matches ? 'MATCH' : (row.presence === 'common' ? 'DIFF' : row.presence.toUpperCase());
    return `
        <div class="compare-result-card ${row.matches ? '' : 'diff'}">
            <div class="compare-result-header" onclick="compareToggleResultCard(this)">
                <div>
                    <strong>${escapeHtml(row.name)}</strong>
                    <span class="compare-legend">
                        <span class="compare-legend-dot" style="background:#58a6ff"></span>${escapeHtml(leftName)}
                        <span class="compare-legend-dot" style="background:#ffa657"></span>${escapeHtml(rightName)}
                    </span>
                </div>
                <div style="display:flex;align-items:center;gap:0.6rem">
                    <span class="compare-badge ${badgeClass}">${badgeLabel}</span>
                    <button class="compare-collapse-btn" title="Collapse / expand" onclick="event.stopPropagation();compareToggleResultCard(this.closest('.compare-result-card').querySelector('.compare-result-header'))">▼</button>
                </div>
            </div>
            <div class="compare-merged-body">
                ${compareRenderMergedValue(row.left, row.right, row.diff_positions || [], row.left?.axis_values || row.right?.axis_values || [])}
                ${(row.left?.raw_hex || row.right?.raw_hex) ? `<div class="compare-raw" style="margin-top:0.5rem">
                    ${row.left?.raw_hex ? `<div><span style="color:#58a6ff">L</span> ${escapeHtml(row.left.raw_hex)}</div>` : ''}
                    ${row.right?.raw_hex ? `<div><span style="color:#ffa657">R</span> ${escapeHtml(row.right.raw_hex)}</div>` : ''}
                </div>` : ''}
            </div>
        </div>
    `;
}

function compareRenderMergedValue(leftData, rightData, diffPositions, axisValues) {
    const diffSet = new Set((diffPositions || []).map(p => `${p.row}:${p.col}`));
    const leftValue = leftData?.value || null;
    const rightValue = rightData?.value || null;
    const kind = (leftValue || rightValue)?.kind || 'scalar';
    const ax = axisValues || [];

    if (kind === 'scalar') {
        const ld = leftValue?.cells?.[0]?.[0]?.display ?? '—';
        const rd = rightValue?.cells?.[0]?.[0]?.display ?? '—';
        const isDiff = diffSet.has('0:0');
        return `
            <div class="compare-merged-scalar${isDiff ? ' compare-diff-cell' : ''}">
                <div class="compare-cell-left"><span class="compare-src-tag left">L</span>${escapeHtml(ld)}</div>
                <div class="compare-cell-right"><span class="compare-src-tag right">R</span>${escapeHtml(rd)}</div>
            </div>`;
    }

    const leftRows = leftValue?.cells || [];
    const rightRows = rightValue?.cells || [];
    const numRows = Math.max(leftRows.length, rightRows.length);
    if (numRows === 0) return '<div class="compare-empty">No value data.</div>';
    const numCols = Math.max((leftRows[0] || rightRows[0] || []).length, 0);
    const xAxis = ax[0]?.length ? ax[0] : null;
    const yAxis = ax[1]?.length ? ax[1] : null;
    const colLabel = (ci) => xAxis ? (xAxis[ci] !== undefined ? Number(xAxis[ci]).toFixed(3) : ci) : ci;
    const rowLabel = (ri) => yAxis ? (yAxis[ri] !== undefined ? Number(yAxis[ri]).toFixed(3) : ri) : ri;
    const header = `<tr><th></th>${Array.from({length: numCols}, (_, ci) => `<th>${escapeHtml(String(colLabel(ci)))}</th>`).join('')}</tr>`;
    const body = Array.from({length: numRows}, (_, ri) => {
        const lr = leftRows[ri] || [];
        const rr = rightRows[ri] || [];
        const cells = Array.from({length: numCols}, (_, ci) => {
            const isDiff = diffSet.has(`${ri}:${ci}`);
            const ld = lr[ci]?.display ?? '—';
            const rd = rr[ci]?.display ?? '—';
            return `<td class="compare-merged-cell${isDiff ? ' compare-diff-cell' : ''}">
                <div class="compare-cell-left">${escapeHtml(ld)}</div>
                <div class="compare-cell-right">${escapeHtml(rd)}</div>
            </td>`;
        }).join('');
        return `<tr><th>${escapeHtml(String(rowLabel(ri)))}</th>${cells}</tr>`;
    }).join('');
    return `<div class="compare-grid-wrapper"><table class="compare-grid"><thead>${header}</thead><tbody>${body}</tbody></table></div>`;
}

function compareOpenVariableModal() {
    const session = compareActiveSession();
    if (!session) return;
    CompareState.tempSelected = new Set(session.selected_variables || []);
    CompareState.variablePage.offset = 0;
    CompareState.variablePage.total = 0;
    CompareState.variablePage.exhausted = false;
    document.getElementById('compareVarSearch').value = '';
    document.getElementById('compareVarPresence').value = 'all';
    document.getElementById('compareVarRows').innerHTML = '';
    document.getElementById('compareVarModal').classList.remove('compare-hidden');
    compareUpdateSelectedCount();
    compareLoadVariablePage(true);
}

function compareCloseVariableModal() {
    document.getElementById('compareVarModal').classList.add('compare-hidden');
}

async function compareReloadVariables() {
    CompareState.variablePage.offset = 0;
    CompareState.variablePage.exhausted = false;
    document.getElementById('compareVarRows').innerHTML = '';
    await compareLoadVariablePage(true);
}

async function compareLoadVariablePage(reset) {
    const session = compareActiveSession();
    if (!session || CompareState.variablePage.loading || CompareState.variablePage.exhausted) return;
    CompareState.variablePage.loading = true;
    const search = encodeURIComponent(document.getElementById('compareVarSearch').value || '');
    const presence = encodeURIComponent(document.getElementById('compareVarPresence').value || 'all');
    const offset = reset ? 0 : CompareState.variablePage.offset;
    const limit = CompareState.variablePage.limit;
    const response = await fetch(`/api/compare/sessions/${session.id}/variables?search=${search}&presence=${presence}&offset=${offset}&limit=${limit}`);
    const data = await response.json();
    CompareState.variablePage.loading = false;
    if (!data.success) {
        alert(data.error || 'Failed to load variables');
        return;
    }
    const page = data.page || {};
    const items = page.items || [];
    CompareState.variablePage.total = page.total || 0;
    CompareState.variablePage.offset = offset + items.length;
    CompareState.variablePage.exhausted = CompareState.variablePage.offset >= CompareState.variablePage.total;
    compareAppendVariableRows(items, !reset);
}

function compareAppendVariableRows(items, append) {
    const tbody = document.getElementById('compareVarRows');
    if (!append) {
        tbody.innerHTML = '';
    }
    const html = items.map(item => {
        const selected = CompareState.tempSelected.has(item.name);
        return `
            <tr class="${selected ? 'selected' : ''}" onclick="compareToggleVariable(this,'${encodeURIComponent(item.name)}')">
                <td>${selected ? '✓' : ''}</td>
                <td>${escapeHtml(item.name)}</td>
                <td>${escapeHtml(item.presence)}</td>
                <td>${escapeHtml(item.left_type || '-')}</td>
                <td>${escapeHtml(item.right_type || '-')}</td>
            </tr>
        `;
    }).join('');
    tbody.insertAdjacentHTML('beforeend', html);
    compareUpdateSelectedCount();
}

function compareToggleVariable(rowEl, encodedName) {
    const name = decodeURIComponent(encodedName);
    if (CompareState.tempSelected.has(name)) {
        CompareState.tempSelected.delete(name);
        rowEl.className = '';
        rowEl.cells[0].textContent = '';
    } else {
        CompareState.tempSelected.add(name);
        rowEl.className = 'selected';
        rowEl.cells[0].textContent = '✓';
    }
    compareUpdateSelectedCount();
}

function compareMaybeLoadMoreVariables() {
    const body = document.getElementById('compareVarModalBody');
    if (body.scrollTop + body.clientHeight >= body.scrollHeight - 120) {
        compareLoadVariablePage(false);
    }
}

function compareUpdateSelectedCount() {
    document.getElementById('compareVarSelectedCount').textContent = `${CompareState.tempSelected.size} selected`;
}

async function compareApplyVariableSelection() {
    const session = compareActiveSession();
    if (!session) return;
    const response = await fetch(`/api/compare/sessions/${session.id}/variables/select`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ names: Array.from(CompareState.tempSelected) }),
    });
    const data = await response.json();
    if (!data.success) {
        alert(data.error || 'Failed to update variable selection');
        return;
    }
    compareCloseVariableModal();
    await compareRefreshSessions(session.id);
}
</script>
