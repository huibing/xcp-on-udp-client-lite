<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="margin: 0;">Calibration Parameters</h2>
        <div>
            <button class="secondary" onclick="readAllVars()" id="readAllBtn" style="margin-right: 0.5rem;">Read All</button>
            <button id="addVarsBtn" class="btn" onclick="openModal()">+ Add Variables</button>
        </div>
    </div>

    <!-- Page Mode Section -->
    <div id="pageModeSection" style="display: none; margin-bottom: 1rem; padding: 1rem; background: #2a2a2a; border-radius: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div id="pageModeDevices">
                <!-- Device page modes will be populated here -->
            </div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Device / Name</th>
                <th>Type</th>
                <th>Address</th>
                <th>Value</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="selectedVars">
            <!-- Populated by JavaScript -->
        </tbody>
    </table>

    <div id="emptyState" style="text-align: center; padding: 2rem; color: #666;">
        <p>No variables selected.</p>
        <p>Click "Add Variables" to select calibration parameters.</p>
    </div>
</div>

<!-- Matrix Editor Modal -->
<div id="matrixModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 95%; max-width: 1400px; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <div>
                <h3 id="matrixTitle" style="margin: 0;">Matrix Editor</h3>
                <div id="matrixAxisInfo" style="margin-top: 0.25rem; font-size: 0.85em; color: #888;"></div>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <span id="matrixPageMode" style="font-size: 0.9em; color: #888;"></span>
                <button onclick="closeMatrixModal()" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>
        </div>
        <div class="modal-body" id="matrixBody" style="flex: 1; overflow: auto; padding: 1rem;">
            <!-- Table will be rendered here -->
        </div>
        <div class="modal-footer" style="padding: 1rem; border-top: 1px solid #444; display: flex; justify-content: flex-end;">
            <button class="secondary" onclick="closeMatrixModal()">Close</button>
        </div>
    </div>
</div>

<!-- Variable Info Modal -->
<div id="infoModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 600px; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <h3 id="infoTitle" style="margin: 0;">Variable Information</h3>
            <button onclick="closeInfoModal()" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" id="infoBody" style="flex: 1; overflow: auto; padding: 1rem;">
            <!-- Info content will be rendered here -->
        </div>
        <div class="modal-footer" style="padding: 1rem; border-top: 1px solid #444; display: flex; justify-content: space-between;">
            <button onclick="copyInfoToClipboard()" title="Copy all information">📋 Copy All</button>
            <button class="secondary" onclick="closeInfoModal()">Close</button>
        </div>
    </div>
</div>

<!-- Modal for variable selection -->
<div id="varModal" class="modal" style="display: none;">
    <div class="modal-content" style="width: 80%; min-width: 600px; max-width: 1200px; max-height: 80vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #444;">
            <h3 style="margin: 0;">Select Calibration Variables</h3>
            <button onclick="closeModal()" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>

        <div class="modal-search" style="padding: 0.75rem 1rem; border-bottom: 1px solid #333;">
            <input type="text" id="varSearch" placeholder="Search variables..." style="width: 100%;" oninput="filterVars()">
        </div>

        <div class="modal-body" id="modalBody" style="flex: 1; overflow-y: auto; padding: 0.5rem 0;">
            <table class="modal-table" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                <thead style="position: sticky; top: 0; background: #2a2a2a; z-index: 1;">
                    <tr>
                        <th style="width: 40px; padding: 0.5rem;"><input type="checkbox" id="selectAll" onclick="toggleSelectAll()"></th>
                        <th style="text-align: left; padding: 0.5rem; width: 35%;">Name</th>
                        <th style="text-align: left; padding: 0.5rem; width: 25%;">Device</th>
                        <th style="text-align: left; padding: 0.5rem; width: 15%;">Type</th>
                        <th style="text-align: left; padding: 0.5rem; width: 15%;">Address</th>
                    </tr>
                </thead>
                <tbody id="availableVars">
                    <!-- Populated by JavaScript (lazy loading) -->
                </tbody>
            </table>
            <div id="loadingIndicator" style="text-align: center; padding: 1rem; color: #666; display: none;">
                Loading more variables...
            </div>
        </div>

        <div class="modal-footer" style="padding: 1rem; border-top: 1px solid #444; display: flex; justify-content: space-between; align-items: center;">
            <span id="selectedCount">0 variables selected</span>
            <div>
                <button class="secondary" onclick="closeModal()" style="margin-right: 0.5rem;">Cancel</button>
                <button class="btn" onclick="applySelection()">Apply Selection</button>
            </div>
        </div>
    </div>
</div>

<style>
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}
.modal-content {
    background: #1e1e1e;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}
.modal-table th, .modal-table td {
    text-align: left;
    padding: 0.5rem;
    border-bottom: 1px solid #333;
}
.modal-table tr:hover {
    background: #2a2a2a;
}
.modal-table tr.selected-row {
    background: #1a4a1a;
}
.modal-table tr.selected-row:hover {
    background: #2a5a2a;
}
/* Toggle Switch Styles */
.toggle-switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 24px;
}
.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}
.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #555;
    transition: 0.3s;
    border-radius: 24px;
}
.toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
}
.toggle-switch input:checked + .toggle-slider {
    background-color: #4CAF50;
}
.toggle-switch input:checked + .toggle-slider:before {
    transform: translateX(24px);
}
</style>

<script>
// All available variables from server
let allVariables = [];
// Currently selected variable keys (device_id:param_name)
let selectedKeys = new Set();
// Temporary selection in modal
let tempSelectedKeys = new Set();
// Page mode data for connected devices
let pageModeData = [];
// Lazy loading state
let displayedCount = 0;
const BATCH_SIZE = 50;
let isLoadingMore = false;
let filteredVariables = [];
const STORAGE_PREFIX = 'cal'; // Prefix for localStorage keys

// Load available variables on page load
document.addEventListener('DOMContentLoaded', async () => {
    await loadAvailableVars();
    await loadPageModes();
    loadSelectionFromStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    renderSelectedVars();
});

async function loadPageModes() {
    try {
        const response = await fetch('/api/cal/pagemode');
        const data = await response.json();
        if (data.success) {
            pageModeData = data.devices;
            renderPageModeSection();
        }
    } catch (e) {
        console.error('Failed to load page modes:', e);
    }
}

function renderPageModeSection() {
    const section = document.getElementById('pageModeSection');
    const container = document.getElementById('pageModeDevices');

    if (pageModeData.length === 0) {
        section.style.display = 'none';
        return;
    }

    section.style.display = 'block';
    container.innerHTML = pageModeData.map(device => {
        const isWorking = device.page_mode === 'working';
        return `
            <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; background: #1e1e1e; border-radius: 6px;">
                <span style="color: #888; font-size: 0.9em;">${escapeHtml(device.device_name)}</span>
                <label class="toggle-switch" title="Toggle between Working (calibration enabled) and Reference (read-only)">
                    <input type="checkbox"
                           ${isWorking ? 'checked' : ''}
                           onchange="switchPageMode('${device.device_id}', this.checked ? 'working' : 'reference')">
                    <span class="toggle-slider"></span>
                </label>
                <span style="font-size: 0.85em; color: ${isWorking ? '#4CAF50' : '#888'};">
                    ${isWorking ? '✏️ Working' : '📖 Reference'}
                </span>
            </div>
        `;
    }).join('');
}

async function switchPageMode(deviceId, mode) {
    try {
        const response = await fetch(`/api/cal/pagemode/${deviceId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: mode })
        });
        const data = await response.json();

        if (data.success) {
            // Update local state
            const device = pageModeData.find(d => d.device_id === deviceId);
            if (device) {
                device.page_mode = data.page_mode;
                device.page_mode_description = data.page_mode_description;
            }
            renderPageModeSection();
            // Re-render selected vars to update cell editability
            renderSelectedVars();
        } else {
            alert('Failed to switch page mode: ' + data.error);
            // Re-render to reset the toggle
            renderPageModeSection();
        }
    } catch (e) {
        alert('Error switching page mode: ' + e.message);
        renderPageModeSection();
    }
}

async function loadAvailableVars() {
    try {
        const response = await fetch('/api/cal/available');
        const data = await response.json();
        if (data.success) {
            allVariables = data.variables;
        }
    } catch (e) {
        console.error('Failed to load available variables:', e);
    }
}

function openModal() {
    tempSelectedKeys = new Set(selectedKeys);
    // Reset lazy loading state
    displayedCount = 0;
    filteredVariables = [];
    isLoadingMore = false;
    renderAvailableVars();
    document.getElementById('varModal').style.display = 'flex';
    document.getElementById('varSearch').focus();
    // Setup scroll listener for lazy loading
    setupScrollListener();
}

function closeModal() {
    document.getElementById('varModal').style.display = 'none';
}

function setupScrollListener() {
    const modalBody = document.getElementById('modalBody');
    // Remove existing listener by cloning
    const newModalBody = modalBody.cloneNode(true);
    modalBody.parentNode.replaceChild(newModalBody, modalBody);
    // Re-get the reference after replacement
    const freshModalBody = document.getElementById('modalBody');
    freshModalBody.addEventListener('scroll', handleScroll);
}

function handleScroll() {
    const modalBody = document.getElementById('modalBody');
    const loadingIndicator = document.getElementById('loadingIndicator');

    // Check if scrolled near bottom
    if (modalBody.scrollTop + modalBody.clientHeight >= modalBody.scrollHeight - 100) {
        if (!isLoadingMore && displayedCount < filteredVariables.length) {
            loadMoreVars();
        }
    }
}

function loadMoreVars() {
    if (isLoadingMore || displayedCount >= filteredVariables.length) return;

    isLoadingMore = true;
    const loadingIndicator = document.getElementById('loadingIndicator');
    loadingIndicator.style.display = 'block';

    // Simulate small delay for better UX
    setTimeout(() => {
        const tbody = document.getElementById('availableVars');
        const nextBatch = filteredVariables.slice(displayedCount, displayedCount + BATCH_SIZE);

        const html = nextBatch.map(v => {
            const key = `${v.device_id}:${v.name}`;
            const selected = tempSelectedKeys.has(key);
            const rowClass = selected ? 'selected-row' : '';
            return `
                <tr class="${rowClass}" onclick="toggleVar('${key}')" style="cursor: pointer;">
                    <td style="width: 40px;">${selected ? '✓' : ''}</td>
                    <td style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(v.name)}">${escapeHtml(v.name)}</td>
                    <td style="color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(v.device_name)}</td>
                    <td>${v.type}</td>
                    <td style="font-family: monospace;">0x${v.address_hex}</td>
                </tr>
            `;
        }).join('');

        tbody.insertAdjacentHTML('beforeend', html);
        displayedCount += nextBatch.length;

        loadingIndicator.style.display = displayedCount < filteredVariables.length ? 'block' : 'none';
        isLoadingMore = false;
    }, 50);
}

function renderAvailableVars() {
    const tbody = document.getElementById('availableVars');
    const searchTerm = document.getElementById('varSearch').value.toLowerCase();

    // Filter all variables
    filteredVariables = allVariables.filter(v =>
        v.name.toLowerCase().includes(searchTerm) ||
        v.device_name.toLowerCase().includes(searchTerm)
    );

    // Reset display count
    displayedCount = 0;

    // Clear tbody
    tbody.innerHTML = '';

    // Render first batch
    const firstBatch = filteredVariables.slice(0, BATCH_SIZE);
    tbody.innerHTML = firstBatch.map(v => {
        const key = `${v.device_id}:${v.name}`;
        const selected = tempSelectedKeys.has(key);
        const rowClass = selected ? 'selected-row' : '';
        return `
            <tr class="${rowClass}" onclick="toggleVar('${key}')" style="cursor: pointer;">
                <td style="width: 40px;">${selected ? '✓' : ''}</td>
                <td style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(v.name)}">${escapeHtml(v.name)}</td>
                <td style="color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(v.device_name)}</td>
                <td>${v.type}</td>
                <td style="font-family: monospace;">0x${v.address_hex}</td>
            </tr>
        `;
    }).join('');

    displayedCount = firstBatch.length;

    const loadingIndicator = document.getElementById('loadingIndicator');
    loadingIndicator.style.display = displayedCount < filteredVariables.length ? 'block' : 'none';

    updateSelectedCount();
    updateSelectAllCheckbox();
}

function filterVars() {
    renderAvailableVars();
}

function toggleVar(key) {
    const wasSelected = tempSelectedKeys.has(key);
    if (wasSelected) {
        tempSelectedKeys.delete(key);
    } else {
        tempSelectedKeys.add(key);
    }
    updateSelectedCount();
    updateSelectAllCheckbox();

    // Update row style without re-rendering
    // Find the row by looking for onclick attribute containing the key
    const rows = document.querySelectorAll('#availableVars tr');
    rows.forEach(row => {
        const onclick = row.getAttribute('onclick');
        if (onclick && onclick.includes(`'${key}'`)) {
            const firstTd = row.querySelector('td:first-child');
            if (wasSelected) {
                row.classList.remove('selected-row');
                if (firstTd) firstTd.textContent = '';
            } else {
                row.classList.add('selected-row');
                if (firstTd) firstTd.textContent = '✓';
            }
        }
    });
}

function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll');

    if (selectAll.checked) {
        filteredVariables.forEach(v => {
            tempSelectedKeys.add(`${v.device_id}:${v.name}`);
        });
    } else {
        filteredVariables.forEach(v => {
            tempSelectedKeys.delete(`${v.device_id}:${v.name}`);
        });
    }
    renderAvailableVars();
}

function updateSelectedCount() {
    document.getElementById('selectedCount').textContent =
        `${tempSelectedKeys.size} variable${tempSelectedKeys.size !== 1 ? 's' : ''} selected`;
}

function updateSelectAllCheckbox() {
    const selectAll = document.getElementById('selectAll');

    if (filteredVariables.length === 0) {
        selectAll.checked = false;
        selectAll.indeterminate = false;
        return;
    }

    const allSelected = filteredVariables.every(v => tempSelectedKeys.has(`${v.device_id}:${v.name}`));
    const someSelected = filteredVariables.some(v => tempSelectedKeys.has(`${v.device_id}:${v.name}`));

    selectAll.checked = allSelected;
    selectAll.indeterminate = someSelected && !allSelected;
}

function applySelection() {
    selectedKeys = new Set(tempSelectedKeys);
    saveSelectionToStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    closeModal();
    renderSelectedVars();
}

function renderSelectedVars() {
    const tbody = document.getElementById('selectedVars');
    const emptyState = document.getElementById('emptyState');

    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );

    if (selectedVars.length === 0) {
        tbody.innerHTML = '';
        emptyState.style.display = 'block';
        return;
    }

    emptyState.style.display = 'none';

    tbody.innerHTML = selectedVars.map((v, idx) => {
        const key = `${v.device_id}:${v.name}`;
        const isComplex = isComplexType(v.type);
        // Check if device is in working page mode
        const devicePageMode = pageModeData.find(d => d.device_id === v.device_id);
        // Default to editable when no page mode info available (assumes working page)
        const isWorking = !devicePageMode || devicePageMode.page_mode === 'working';
        const editableAttr = (!isComplex && isWorking) ? `data-editable="true" data-device-id="${v.device_id}" data-idx="${v.idx}" style="cursor: pointer;" title="Click to edit"` : '';
        return `
            <tr>
                <td>
                    <span style="color: #888; font-size: 0.85em;">[${escapeHtml(v.device_name)}]</span><br>
                    ${escapeHtml(v.name)}
                </td>
                <td>${v.type}</td>
                <td style="font-family: monospace;">0x${v.address_hex}</td>
                <td id="value-${key.replace(/:/g, '-')}" ${editableAttr}>-</td>
                <td>
                    <div class="btn-group">
                        <button onclick="readVar('${v.device_id}', ${v.idx})" title="Read">R</button>
                        ${isComplex ? `<button onclick="openMatrixEditor('${v.device_id}', ${v.idx}, '${escapeHtml(v.name)}')" title="Table View">📊</button>` : ''}
                        <button onclick="openInfoModal('cal', '${v.device_id}', ${v.idx}, '${escapeHtml(v.name)}')" title="Info">ℹ️</button>
                        <button class="secondary" onclick="removeVar('${key}')" title="Remove">&times;</button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');

    // Setup click handlers for editable cells using event delegation
    setupEditableCellHandlers();
}

// Setup click handlers for editable value cells
let editableClickHandler = null;

function setupEditableCellHandlers() {
    const tbody = document.getElementById('selectedVars');

    // Remove existing handler if any
    if (editableClickHandler) {
        tbody.removeEventListener('click', editableClickHandler);
    }

    // Create new handler
    editableClickHandler = (e) => {
        const cell = e.target.closest('td[data-editable="true"]');
        if (cell) {
            const deviceId = cell.dataset.deviceId;
            const idx = parseInt(cell.dataset.idx, 10);
            makeEditable(deviceId, idx, cell);
        }
    };

    tbody.addEventListener('click', editableClickHandler);
}

// Check if type is complex (array/matrix/curve/map)
function isComplexType(type) {
    return type.includes('[') || type.includes('Matrix') || type.includes('Array');
}

// Matrix editor functions
let currentMatrixData = null;
let currentMatrixDeviceId = null;
let currentMatrixIdx = null;

async function openMatrixEditor(deviceId, idx, name) {
    currentMatrixDeviceId = deviceId;
    currentMatrixIdx = idx;
    document.getElementById('matrixTitle').textContent = name;
    document.getElementById('matrixPageMode').textContent = 'Loading...';
    document.getElementById('matrixModal').style.display = 'flex';
    document.getElementById('matrixBody').innerHTML = '<p style="text-align: center; color: #888;">Loading data...</p>';

    try {
        const response = await fetch(`/api/cal/value/${deviceId}/${idx}`);
        const data = await response.json();

        if (data.success) {
            currentMatrixData = data;
            console.log('Matrix data:', {
                name: data.name,
                characteristic_type: data.characteristic_type,
                axis_info: data.axis_info,
                axis_values: data.axis_values,
                rows: data.rows,
                cols: data.cols,
                is_1d: data.is_1d
            });
            renderMatrixTable(data);
        } else {
            document.getElementById('matrixBody').innerHTML = `<p style="color: #ff4444;">Error: ${escapeHtml(data.error)}</p>`;
        }
    } catch (e) {
        document.getElementById('matrixBody').innerHTML = `<p style="color: #ff4444;">Failed to load: ${escapeHtml(e.message)}</p>`;
    }
}

function closeMatrixModal() {
    document.getElementById('matrixModal').style.display = 'none';
    currentMatrixData = null;
    currentMatrixDeviceId = null;
    currentMatrixIdx = null;
}

function renderMatrixTable(data) {
    const container = document.getElementById('matrixBody');
    const isWorking = data.is_working_page;
    const axisValues = data.axis_values || [];
    const axisInfo = data.axis_info || [];

    // Update page mode indicator
    const pageModeSpan = document.getElementById('matrixPageMode');
    if (isWorking) {
        pageModeSpan.innerHTML = '<span style="color: #4CAF50;">✏️ Working Page (editable)</span>';
    } else {
        pageModeSpan.innerHTML = '<span style="color: #888;">📖 Reference Page (read-only)</span>';
    }

    // Update axis info description
    const axisInfoDiv = document.getElementById('matrixAxisInfo');
    if (axisInfo.length === 2) {
        // MAP: show both X and Y axis names
        axisInfoDiv.innerHTML = `X: ${escapeHtml(axisInfo[0].name)} | Y: ${escapeHtml(axisInfo[1].name)}`;
    } else if (axisInfo.length === 1) {
        // CURVE: show X axis name
        axisInfoDiv.innerHTML = `X: ${escapeHtml(axisInfo[0].name)}`;
    } else {
        axisInfoDiv.innerHTML = '';
    }

    if (data.is_1d) {
        // Render 1D array
        render1DTable(container, data, isWorking, axisValues, axisInfo);
    } else {
        // Render 2D matrix
        render2DTable(container, data, isWorking, axisValues, axisInfo);
    }
}

function render1DTable(container, data, isWorking, axisValues, axisInfo) {
    const values = data.value;
    const cols = data.cols;

    // Get axis values if available
    let xLabels = [];
    if (axisValues.length > 0 && axisValues[0]) {
        xLabels = axisValues[0].map(v => formatAxisValue(v));
    } else if (axisInfo.length > 0) {
        // Show axis name
        const xAxis = axisInfo[0];
        const unit = xAxis.unit ? ` (${xAxis.unit})` : '';
        xLabels = Array(cols).fill('').map((_, i) => `${xAxis.name}${unit}`);
    }

    let html = '<table class="matrix-table" style="width: 100%; border-collapse: collapse;">';

    // Header row with axis values
    html += '<thead><tr><th style="padding: 0.5rem; background: #2a2a2a; border: 1px solid #444;">Index</th>';
    for (let c = 0; c < cols; c++) {
        const label = xLabels[c] || c.toString();
        html += `<th style="padding: 0.5rem; background: #2a2a2a; border: 1px solid #444;">${escapeHtml(label)}</th>`;
    }
    html += '</tr></thead><tbody>';

    // Value row
    html += '<tr><td style="padding: 0.5rem; background: #1e1e1e; border: 1px solid #444; font-weight: bold;">Value</td>';
    for (let c = 0; c < cols; c++) {
        const val = values[c] !== undefined ? values[c] : '-';
        if (isWorking) {
            html += `<td style="padding: 0.25rem; border: 1px solid #444; text-align: center;">
                <input type="text" class="matrix-cell" data-row="0" data-col="${c}" value="${val}"
                       style="width: 80px; text-align: center; background: #1e1e1e; border: 1px solid #0f3460; color: #00ff88; padding: 0.25rem;"
                       onchange="saveCell(0, ${c}, this.value)" onkeydown="handleCellKeydown(event, 0, ${c})">
            </td>`;
        } else {
            html += `<td style="padding: 0.5rem; border: 1px solid #444; text-align: center; color: #00ff88;">${val}</td>`;
        }
    }
    html += '</tr></tbody></table>';

    container.innerHTML = html;
}

function render2DTable(container, data, isWorking, axisValues, axisInfo) {
    let values = data.value;
    let rows = data.rows;
    let cols = data.cols;

    // Get axis values if available
    // A2L: First axis = X (horizontal/columns), Second axis = Y (vertical/rows)
    let xLabels = [], yLabels = [];
    if (axisValues.length > 1) {
        // MAP has 2 axes: axisValues[0] = X axis (columns), axisValues[1] = Y axis (rows)
        xLabels = axisValues[0] ? axisValues[0].map(v => formatAxisValue(v)) : [];
        yLabels = axisValues[1] ? axisValues[1].map(v => formatAxisValue(v)) : [];
    } else if (axisValues.length > 0) {
        yLabels = axisValues[0] ? axisValues[0].map(v => formatAxisValue(v)) : [];
    }

    // Transpose the data matrix for correct display
    // Current: values[r][c] where r=X_points, c=Y_points
    // Needed: values[r][c] where r=Y_points, c=X_points
    const transposed = [];
    for (let c = 0; c < cols; c++) {
        transposed[c] = [];
        for (let r = 0; r < rows; r++) {
            transposed[c][r] = values[r][c];
        }
    }
    // Swap dimensions
    const displayRows = cols;
    const displayCols = rows;
    values = transposed;

    let html = '<table class="matrix-table" style="width: 100%; border-collapse: collapse;">';

    // Header row with X axis values (now from Y axis after swap)
    html += '<thead><tr><th style="padding: 0.5rem; background: #2a2a2a; border: 1px solid #444;"></th>';
    for (let c = 0; c < displayCols; c++) {
        const label = xLabels[c] || `Col ${c}`;
        html += `<th style="padding: 0.5rem; background: #2a2a2a; border: 1px solid #444;">${escapeHtml(label)}</th>`;
    }
    html += '</tr></thead><tbody>';

    // Data rows with Y axis labels (now from X axis after swap)
    for (let r = 0; r < displayRows; r++) {
        const rowLabel = yLabels[r] || `Row ${r}`;
        html += `<tr><td style="padding: 0.5rem; background: #1e1e1e; border: 1px solid #444; font-weight: bold;">${escapeHtml(rowLabel)}</td>`;
        for (let c = 0; c < displayCols; c++) {
            const val = values[r] && values[r][c] !== undefined ? values[r][c] : '-';
            if (isWorking) {
                html += `<td style="padding: 0.25rem; border: 1px solid #444; text-align: center;">
                    <input type="text" class="matrix-cell" data-row="${r}" data-col="${c}" value="${val}"
                           style="width: 80px; text-align: center; background: #1e1e1e; border: 1px solid #0f3460; color: #00ff88; padding: 0.25rem;"
                           onchange="saveCell(${r}, ${c}, this.value)" onkeydown="handleCellKeydown(event, ${r}, ${c})">
                </td>`;
            } else {
                html += `<td style="padding: 0.5rem; border: 1px solid #444; text-align: center; color: #00ff88;">${val}</td>`;
            }
        }
        html += '</tr>';
    }
    html += '</tbody></table>';

    container.innerHTML = html;
}

function formatAxisValue(v) {
    if (typeof v === 'number') {
        return Number.isInteger(v) ? v.toString() : v.toFixed(2);
    }
    return v.toString();
}

async function saveCell(row, col, value) {
    if (!currentMatrixDeviceId || currentMatrixIdx === null) {
        return;
    }

    const input = document.querySelector(`input[data-row="${row}"][data-col="${col}"]`);
    if (input) {
        input.style.borderColor = '#ffaa00'; // Show saving state
    }

    // For 2D MAP, coordinates need to be swapped back to original data layout
    // Display is transposed: displayRow=Y, displayCol=X
    // Original: row=X, col=Y
    // So we send: originalRow=displayCol, originalCol=displayRow
    let sendRow = row;
    let sendCol = col;
    if (currentMatrixData && !currentMatrixData.is_1d) {
        sendRow = col;
        sendCol = row;
    }

    try {
        const response = await fetch(`/api/cal/write-element/${currentMatrixDeviceId}/${currentMatrixIdx}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ row: sendRow, col: sendCol, value })
        });
        const data = await response.json();

        if (data.success) {
            if (input) {
                input.style.borderColor = '#4CAF50'; // Show success
                setTimeout(() => {
                    input.style.borderColor = '#0f3460';
                }, 1000);
            }
            // Update local data (in original/transposed format)
            if (currentMatrixData) {
                if (currentMatrixData.is_1d) {
                    currentMatrixData.value[col] = value;
                } else {
                    // Update in transposed format (what we display)
                    currentMatrixData.value[row][col] = value;
                }
            }
        } else {
            alert('Error: ' + data.error);
            if (input) {
                input.style.borderColor = '#ff4444'; // Show error
                setTimeout(() => {
                    input.style.borderColor = '#0f3460';
                }, 2000);
            }
        }
    } catch (e) {
        alert('Failed to save: ' + e.message);
        if (input) {
            input.style.borderColor = '#ff4444';
        }
    }
}

function handleCellKeydown(event, row, col) {
    if (event.key === 'Enter') {
        event.target.blur();
    } else if (event.key === 'Escape') {
        // Reset to original value
        // For 2D MAP, the displayed matrix is transposed, so we need to swap coordinates
        if (currentMatrixData) {
            if (currentMatrixData.is_1d) {
                event.target.value = currentMatrixData.value[col];
            } else {
                // Original data: value[originalRow][originalCol]
                // Displayed: transposed[row][col] = original[col][row]
                event.target.value = currentMatrixData.value[col][row];
            }
        }
        event.target.blur();
    }
}

async function readVar(deviceId, idx) {
    try {
        const response = await fetch(`/api/cal/read/${deviceId}/${idx}`);
        const data = await response.json();

        if (data.success) {
            // Find the variable and update its value
            const v = allVariables.find(v => v.device_id === deviceId && v.idx === idx);
            if (v) {
                const key = `${v.device_id}:${v.name}`.replace(/:/g, '-');
                const valueCell = document.getElementById(`value-${key}`);
                if (valueCell) {
                    valueCell.textContent = data.value;
                    valueCell.style.color = '#00ff88';
                    // Store enum info for inline editing
                    valueCell.dataset.isEnum = data.is_enum ? 'true' : 'false';
                    if (data.is_enum && data.enum_options) {
                        valueCell.dataset.enumOptions = JSON.stringify(data.enum_options);
                    }
                }
            }
        } else {
            alert('Error: ' + data.error);
        }
    } catch (e) {
        alert('Failed to read: ' + e.message);
    }
}

// Inline editing for scalar values in working page mode
async function makeEditable(deviceId, idx, cell) {
    // Don't create another input if already editing
    if (cell.querySelector('input') || cell.querySelector('select')) return;

    const currentValue = cell.textContent.trim();
    const isEnum = cell.dataset.isEnum === 'true';

    // If value is "-" (not read yet), read it first
    if (currentValue === '-') {
        cell.innerHTML = '<span style="color: #ffaa00;">Reading...</span>';
        try {
            const response = await fetch(`/api/cal/read/${deviceId}/${idx}`);
            const data = await response.json();
            if (data.success) {
                cell.textContent = data.value;
                cell.style.color = '#00ff88';
                // Store enum info
                cell.dataset.isEnum = data.is_enum ? 'true' : 'false';
                if (data.is_enum && data.enum_options) {
                    cell.dataset.enumOptions = JSON.stringify(data.enum_options);
                }
                // Now proceed to edit with the read value
                if (data.is_enum) {
                    createEnumSelect(deviceId, idx, cell, data.value.toString(), data.enum_options);
                } else {
                    createEditInput(deviceId, idx, cell, data.value.toString());
                }
            } else {
                cell.textContent = '-';
                alert('Failed to read value: ' + data.error);
            }
        } catch (e) {
            cell.textContent = '-';
            alert('Failed to read: ' + e.message);
        }
        return;
    }

    // Check if this is an enum type
    if (isEnum) {
        const enumOptions = cell.dataset.enumOptions ? JSON.parse(cell.dataset.enumOptions) : [];
        createEnumSelect(deviceId, idx, cell, currentValue, enumOptions);
    } else {
        createEditInput(deviceId, idx, cell, currentValue);
    }
}

function createEditInput(deviceId, idx, cell, currentValue) {
    const originalValue = currentValue;

    // Create input element
    const input = document.createElement('input');
    input.type = 'text';
    input.value = currentValue;
    input.style.cssText = 'width: 80px; background: #1e1e1e; border: 1px solid #4CAF50; color: #00ff88; padding: 0.25rem; text-align: center;';

    // Clear cell and add input
    cell.textContent = '';
    cell.appendChild(input);
    input.focus();
    input.select();

    // Save on blur
    input.addEventListener('blur', () => {
        saveInlineEdit(deviceId, idx, cell, input.value, originalValue);
    });

    // Save on Enter, cancel on Escape
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            input.blur();
        } else if (e.key === 'Escape') {
            cell.textContent = originalValue;
        }
    });
}

// Create enum dropdown select for scalar values
function createEnumSelect(deviceId, idx, cell, currentValue, enumOptions) {
    const originalValue = currentValue;

    // Create select element
    const select = document.createElement('select');
    select.style.cssText = 'background: #1e1e1e; border: 1px solid #4CAF50; color: #00ff88; padding: 0.25rem; min-width: 100px;';

    // Add options
    enumOptions.forEach(opt => {
        const option = document.createElement('option');
        option.value = opt.text;
        option.textContent = `${opt.text} (${opt.raw})`;
        if (opt.text === currentValue) {
            option.selected = true;
        }
        select.appendChild(option);
    });

    // Clear cell and add select
    cell.textContent = '';
    cell.appendChild(select);
    select.focus();

    // Save on blur
    select.addEventListener('blur', () => {
        const selectedText = select.value;
        saveInlineEdit(deviceId, idx, cell, selectedText, originalValue);
    });

    // Save on Enter, cancel on Escape
    select.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            select.blur();
        } else if (e.key === 'Escape') {
            cell.textContent = originalValue;
        }
    });

    // Save on change
    select.addEventListener('change', () => {
        select.blur();
    });
}

async function saveInlineEdit(deviceId, idx, cell, newValue, originalValue) {
    if (newValue === originalValue) {
        cell.textContent = originalValue;
        return;
    }

    cell.innerHTML = '<span style="color: #ffaa00;">Saving...</span>';

    try {
        // Use write-element API with row=0, col=0 for scalar values
        const response = await fetch(`/api/cal/write-element/${deviceId}/${idx}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ row: 0, col: 0, value: newValue })
        });
        const data = await response.json();

        if (data.success) {
            cell.textContent = newValue;
            cell.style.color = '#4CAF50';
            setTimeout(() => {
                cell.style.color = '#00ff88';
            }, 1000);
        } else {
            cell.textContent = originalValue;
            alert('Error: ' + data.error);
        }
    } catch (e) {
        cell.textContent = originalValue;
        alert('Failed to write: ' + e.message);
    }
}

function removeVar(key) {
    selectedKeys.delete(key);
    saveSelectionToStorage(STORAGE_PREFIX, allVariables, selectedKeys);
    renderSelectedVars();
}

async function readAllVars() {
    const selectedVars = allVariables.filter(v =>
        selectedKeys.has(`${v.device_id}:${v.name}`)
    );

    if (selectedVars.length === 0) {
        alert('No variables selected');
        return;
    }

    const btn = document.getElementById('readAllBtn');
    btn.disabled = true;
    btn.textContent = 'Reading...';

    let successCount = 0;
    let failCount = 0;

    for (const v of selectedVars) {
        try {
            const response = await fetch(`/api/cal/read/${v.device_id}/${v.idx}`);
            const data = await response.json();

            if (data.success) {
                const key = `${v.device_id}:${v.name}`.replace(/:/g, '-');
                const valueCell = document.getElementById(`value-${key}`);
                if (valueCell) {
                    valueCell.textContent = data.value;
                    valueCell.style.color = '#00ff88';
                }
                successCount++;
            } else {
                failCount++;
            }
        } catch (e) {
            failCount++;
        }
    }

    btn.disabled = false;
    btn.textContent = 'Read All';

    if (failCount > 0) {
        console.log(`Read ${successCount} variables, ${failCount} failed`);
    }
}

// Variable Info Modal functions
let currentInfoData = null;

async function openInfoModal(varType, deviceId, idx, name) {
    document.getElementById('infoTitle').textContent = name;
    document.getElementById('infoModal').style.display = 'flex';
    document.getElementById('infoBody').innerHTML = '<p style="text-align: center; color: #888;">Loading...</p>';

    try {
        const apiPath = varType === 'cal' ? `/api/cal/detail/${deviceId}/${idx}` : `/api/daq/detail/${deviceId}/${idx}`;
        const response = await fetch(apiPath);
        const data = await response.json();

        if (data.success) {
            currentInfoData = data.detail;
            renderInfoContent(data.detail, varType);
        } else {
            document.getElementById('infoBody').innerHTML = `<p style="color: #ff4444;">Error: ${escapeHtml(data.error)}</p>`;
        }
    } catch (e) {
        document.getElementById('infoBody').innerHTML = `<p style="color: #ff4444;">Failed to load: ${escapeHtml(e.message)}</p>`;
    }
}

function closeInfoModal() {
    document.getElementById('infoModal').style.display = 'none';
    currentInfoData = null;
}

function renderInfoContent(detail, varType) {
    const container = document.getElementById('infoBody');

    // Build info table
    let html = '<table style="width: 100%; border-collapse: collapse;">';

    // Basic info
    html += createInfoRow('Name', detail.name);
    html += createInfoRow('Device', detail.device_name);
    html += createInfoRow('Type', detail.type);
    html += createInfoRow('Address', detail.address);
    html += createInfoRow('Address Extension', detail.address_ext);

    if (varType === 'cal') {
        // Calibration specific fields
        html += createInfoRow('Description', detail.description);
        html += createInfoRow('Unit', detail.unit);
        html += createInfoRow('Range', detail.range);
        html += createInfoRow('Characteristic Type', detail.characteristic_type);
        html += createInfoRow('Storage Order', detail.storage_order);
        html += createInfoRow('Data Size', detail.data_size);

        // Axis info for CURVE/MAP
        if (detail.axis_info && detail.axis_info.length > 0) {
            html += '<tr><td colspan="2" style="padding: 1rem 0.5rem 0.5rem; border: none; font-weight: bold; color: #00ff88;">Axis Information</td></tr>';
            detail.axis_info.forEach((axis, i) => {
                // Determine axis role label
                let axisRole = '';
                if (detail.characteristic_type === 'MAP' && detail.axis_info.length === 2) {
                    axisRole = i === 0 ? ' (X, horizontal/columns)' : ' (Y, vertical/rows)';
                } else if (detail.characteristic_type === 'CURVE' && detail.axis_info.length === 1) {
                    axisRole = ' (X, horizontal)';
                }

                html += `<tr><td colspan="2" style="padding: 0.5rem; background: #2a2a2a; border: 1px solid #444;">`;
                html += `<strong>Axis ${i + 1}${axisRole}: ${escapeHtml(axis.name)}</strong>`;
                if (axis.unit) html += ` (${escapeHtml(axis.unit)})`;
                html += '<br>';
                html += `Points: ${axis.num_points}, Range: ${axis.min} ~ ${axis.max}`;

                // Use axis_values from top-level (includes XCP-read values) or axis.values (static)
                {{!-- const axisValues = (detail.axis_values && detail.axis_values[i]) ? detail.axis_values[i] : axis.values;
                if (axisValues && axisValues.length > 0) {
                    const displayCount = Math.min(axisValues.length, 8);
                    html += `<br><span style="color: #888; font-size: 0.85em;">Values: ${axisValues.slice(0, displayCount).map(v => formatAxisValue(v)).join(', ')}${axisValues.length > displayCount ? '...' : ''}</span>`;
                } --}}
                html += '</td></tr>';
            });
        }
    } else {
        // Measurement specific fields
        html += createInfoRow('Unit', detail.unit);
        html += createInfoRow('Data Size', detail.data_size);
    }

    html += '</table>';
    container.innerHTML = html;
}

function copyInfoToClipboard() {
    if (!currentInfoData) return;

    // Build plain text for clipboard
    let text = `Variable Information\n`;
    text += `==================\n`;
    text += `Name: ${currentInfoData.name}\n`;
    text += `Device: ${currentInfoData.device_name}\n`;
    text += `Type: ${currentInfoData.type}\n`;
    text += `Address: ${currentInfoData.address}\n`;
    text += `Address Extension: ${currentInfoData.address_ext}\n`;

    if (currentInfoData.description !== undefined) {
        text += `Description: ${currentInfoData.description}\n`;
        text += `Unit: ${currentInfoData.unit}\n`;
        text += `Range: ${currentInfoData.range}\n`;
        text += `Characteristic Type: ${currentInfoData.characteristic_type}\n`;
        text += `Storage Order: ${currentInfoData.storage_order}\n`;
        text += `Data Size: ${currentInfoData.data_size}\n`;

        if (currentInfoData.axis_info && currentInfoData.axis_info.length > 0) {
            text += `\nAxis Information\n`;
            text += `----------------\n`;
            currentInfoData.axis_info.forEach((axis, i) => {
                // Determine axis role label
                let axisRole = '';
                if (currentInfoData.characteristic_type === 'MAP' && currentInfoData.axis_info.length === 2) {
                    axisRole = i === 0 ? ' (X, horizontal/columns)' : ' (Y, vertical/rows)';
                } else if (currentInfoData.characteristic_type === 'CURVE' && currentInfoData.axis_info.length === 1) {
                    axisRole = ' (X, horizontal)';
                }
                text += `Axis ${i + 1}${axisRole}: ${axis.name}`;
                if (axis.unit) text += ` (${axis.unit})`;
                text += `\n  Points: ${axis.num_points}, Range: ${axis.min} ~ ${axis.max}\n`;
                // Use axis_values from top-level (includes XCP-read values) or axis.values (static)
                const axisValues = (currentInfoData.axis_values && currentInfoData.axis_values[i]) ? currentInfoData.axis_values[i] : axis.values;
                if (axisValues && axisValues.length > 0) {
                    text += `  Values: ${axisValues.map(v => formatAxisValue(v)).join(', ')}\n`;
                }
            });
        }
    } else {
        text += `Unit: ${currentInfoData.unit}\n`;
        text += `Data Size: ${currentInfoData.data_size}\n`;
    }

    navigator.clipboard.writeText(text).then(() => {
        // Show brief feedback
        const btn = document.querySelector('#infoModal .modal-footer button');
        const originalText = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(() => {
            btn.textContent = originalText;
        }, 1500);
    }).catch(e => {
        alert('Failed to copy: ' + e.message);
    });
}

// Close modal on outside click
document.getElementById('varModal').addEventListener('click', (e) => {
    if (e.target.id === 'varModal') {
        closeModal();
    }
});

// Close matrix modal on outside click
document.getElementById('matrixModal').addEventListener('click', (e) => {
    if (e.target.id === 'matrixModal') {
        closeMatrixModal();
    }
});

// Close info modal on outside click
document.getElementById('infoModal').addEventListener('click', (e) => {
    if (e.target.id === 'infoModal') {
        closeInfoModal();
    }
});

// Close modal on Escape key, Enter to confirm
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeModal();
        closeMatrixModal();
        closeInfoModal();
    } else if (e.key === 'Enter' && !e.target.matches('input, textarea, select')) {
        var vm = document.getElementById('varModal');
        if (vm && vm.style.display !== 'none') {
            applySelection();
        }
    }
});
