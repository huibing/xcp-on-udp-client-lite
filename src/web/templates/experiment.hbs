/* Status bar */
.exp-status-bar {
    display: flex;
    align-items: center;
    padding: 0.2rem 1rem;
    background: #252535;
    border-top: 1px solid #333;
    font-size: 0.75rem;
    color: #888;
    gap: 1rem;
    min-height: 24px;
    flex-wrap: nowrap;
    overflow: hidden;
}
.exp-status-bar .status-item {
