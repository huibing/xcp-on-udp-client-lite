<!-- Experiment Page Template -->
<!-- VSCode-like layout with toolbar, tabs, and status bar -->

<style>
/* ===== Experiment Page Layout ===== */
.exp-container {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 80px);
    margin: -2rem;
    overflow: hidden;
}

/* Title Bar */
.exp-title-bar {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #1e1e2e;
    border-bottom: 1px solid #333;
    gap: 0.5rem;
}
.exp-title-bar input {
    background: transparent;
    border: 1px solid transparent;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    width: 300px;
}
.exp-title-bar input:hover { border-color: #555; }
.exp-title-bar input:focus { border-color: #00ff88; outline: none; }

/* Body: sidebar + main */
.exp-body {
    flex: 1;
    display: flex;
    overflow: hidden;
}

/* Vertical Sidebar (VSCode Activity Bar) */
.exp-sidebar {
    display: flex;
    flex-direction: column;
    background: #1e1e2e;
    border-right: 1px solid #333;
    width: 48px;
    min-width: 48px;
    align-items: center;
    padding: 0.5rem 0;
    gap: 2px;
    overflow-y: auto;
}
.exp-sidebar::-webkit-scrollbar { width: 3px; }
.exp-sidebar::-webkit-scrollbar-thumb { background: #555; border-radius: 2px; }
.exp-sidebar .sidebar-separator {
    width: 28px;
    height: 1px;
    background: #444;
    margin: 4px 0;
}
.exp-sb-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    border-radius: 6px;
    color: #888;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.15s;
    position: relative;
}
.exp-sb-btn:hover { background: #3a3a4a; color: #fff; }
.exp-sb-btn:disabled { opacity: 0.3; cursor: not-allowed; }
.exp-sb-btn:disabled:hover { background: none; color: #888; }
.exp-sb-btn.active { color: #00ff88; background: #00ff8818; }
.exp-sb-btn.danger { color: #ff6666; }
.exp-sb-btn.danger:hover { background: #4a2020; color: #ff4444; }
.exp-sb-btn.recording { color: #ff4444; animation: pulse-rec 1.5s infinite; }
@keyframes pulse-rec { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
a.exp-sb-btn { text-decoration: none; }

/* Toolbar button (still used in modals and map cards) */
.exp-tb-btn {
    background: none;
    border: 1px solid transparent;
    color: #ccc;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
    transition: all 0.15s;
}
.exp-tb-btn:hover { background: #3a3a4a; color: #fff; border-color: #555; }
.exp-tb-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.exp-tb-btn:disabled:hover { background: none; color: #ccc; border-color: transparent; }
.exp-tb-btn.active { background: #00ff88; color: #1a1a2e; }
.exp-tb-btn.danger { color: #ff6666; }
.exp-tb-btn.danger:hover { background: #4a2020; }
.exp-tb-btn.recording { color: #ff4444; animation: pulse-rec 1.5s infinite; }

/* Page mode toggle */
.exp-pagemode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}
.exp-pagemode label { color: #666; font-size: 0.55rem; cursor: pointer; }
.exp-pagemode .toggle {
    position: relative;
    width: 32px;
    height: 16px;
    background: #555;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s;
}
.exp-pagemode .toggle.working { background: #00ff88; }
.exp-pagemode .toggle::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    background: #fff;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    transition: left 0.3s;
}
.exp-pagemode .toggle.working::after { left: 18px; }

/* Right side: main area */
.exp-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Tab bar */
.exp-tab-bar {
    display: flex;
    align-items: center;
    background: #1e1e2e;
    border-bottom: 1px solid #333;
    overflow-x: auto;
    min-height: 36px;
}
.exp-tab-bar::-webkit-scrollbar { height: 3px; }
.exp-tab-bar::-webkit-scrollbar-thumb { background: #555; border-radius: 2px; }
.exp-tab {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    background: #252535;
    border-right: 1px solid #333;
    cursor: pointer;
    font-size: 0.85rem;
    color: #888;
    white-space: nowrap;
    min-width: 100px;
    max-width: 200px;
    gap: 0.5rem;
    transition: all 0.15s;
}
.exp-tab:hover { background: #2a2a3a; color: #ccc; }
.exp-tab.active { background: #1a1a2e; color: #fff; border-bottom: 2px solid #00ff88; }
.exp-tab .tab-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}
.exp-tab .tab-close {
    opacity: 0;
    font-size: 0.75rem;
    padding: 0 2px;
    border-radius: 3px;
    transition: opacity 0.15s;
}
.exp-tab:hover .tab-close, .exp-tab.active .tab-close { opacity: 0.7; }
.exp-tab .tab-close:hover { opacity: 1; background: #ff444444; }
.exp-tab-add {
    padding: 0.4rem 0.6rem;
    color: #666;
    cursor: pointer;
    font-size: 1rem;
    border: none;
    background: none;
}
.exp-tab-add:hover { color: #00ff88; }

/* Tab content area */
.exp-tab-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    background: #1a1a2e;
}

/* Variable cards */
.exp-cards-section { margin-bottom: 1.5rem; }
.exp-cards-section h3 {
    color: #888;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
}
.exp-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
}
.exp-var-card {
    background: #252535;
    border: 1px solid #333;
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    position: relative;
    transition: border-color 0.15s;
}
.exp-var-card:hover { border-color: #555; }
.exp-var-card .card-name {
    font-size: 0.8rem;
    color: #aaa;
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.exp-var-card .card-device {
    font-size: 0.65rem;
    color: #666;
    margin-bottom: 0.15rem;
}
.exp-var-card .card-value {
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    color: #00ff88;
    font-weight: 600;
}
.exp-var-card .card-unit {
    font-size: 0.7rem;
    color: #888;
    margin-left: 0.25rem;
}
.exp-var-card.measurement { border-left: 3px solid #4488ff; }
.exp-var-card.calibration { border-left: 3px solid #ff8844; }
.exp-var-card.calibration.editable { cursor: pointer; }
.exp-var-card.calibration.editable:hover { border-color: #ff8844; }
.exp-var-card.calibration.readonly { opacity: 0.7; }
.exp-var-card .card-remove {
    position: absolute;
    top: 4px;
    right: 4px;
    opacity: 0;
    color: #ff4444;
    cursor: pointer;
    font-size: 0.7rem;
    padding: 2px 4px;
    border-radius: 3px;
    transition: opacity 0.15s;
}
.exp-var-card:hover .card-remove { opacity: 0.7; }
.exp-var-card .card-remove:hover { opacity: 1; background: #ff444433; }
.exp-var-card .card-info-btn {
    position: absolute;
    bottom: 4px;
    right: 4px;
    opacity: 0;
    cursor: pointer;
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 3px;
    color: #4488ff;
    transition: opacity 0.15s;
}
.exp-var-card:hover .card-info-btn { opacity: 1; }
.exp-var-card .card-info-btn:hover { background: #4488ff33; }
.exp-var-card.map-curve {
    border-left-color: #ff8844;
}
.exp-info-row td {
    padding: 0.5rem;
    border-bottom: 1px solid #333;
}
.exp-info-row td:first-child {
    color: #888;
    width: 40%;
}

/* Map/Curve section */
.exp-map-section {
    margin-top: 1rem;
    border-top: 1px solid #333;
    padding-top: 1rem;
}
.exp-map-section h3 { color: #ff8844; }
.exp-map-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
}
.exp-map-table th, .exp-map-table td {
    padding: 0.4rem 0.6rem;
    border: 1px solid #333;
    text-align: center;
    font-size: 0.85rem;
}
.exp-map-table th { background: #252535; color: #888; }
.exp-map-table td { font-family: monospace; }
.exp-map-table td.editable { cursor: pointer; }
.exp-map-table td.editable:hover { background: #2a3a2a; }
.exp-map-table input {
    width: 80px;
    background: #1a1a2e;
    border: 1px solid #00ff88;
    color: #fff;
    padding: 2px 4px;
    text-align: center;
    font-family: monospace;
}

/* Empty tab state */
.exp-empty-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #555;
    gap: 1rem;
}
.exp-empty-tab .icon { font-size: 3rem; }
.exp-empty-tab button { margin-top: 0.5rem; }

/* Status bar */
.exp-status-bar {
    display: flex;
    align-items: center;
    padding: 0.2rem 1rem;
    background: #252535;
    border-top: 1px solid #333;
    font-size: 0.75rem;
    color: #888;
    gap: 1rem;
    min-height: 24px;
    flex-wrap: nowrap;
    overflow: hidden;
}
.exp-status-bar .status-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
}
.exp-status-bar .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.exp-status-bar .status-dot.connected { background: #00ff88; }
.exp-status-bar .status-dot.disconnected { background: #ff4444; }
.exp-status-bar .status-separator {
    width: 1px;
    height: 14px;
    background: #444;
}

/* Modals */
.exp-modal {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}
.exp-modal-content {
    background: #1e1e1e;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.exp-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #444;
}
.exp-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
}
.exp-modal-footer {
    padding: 1rem;
    border-top: 1px solid #444;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}
.exp-modal-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
}

/* Variable selection modal (wide) */
#expVarModal .exp-modal-content { width: 80%; min-width: 600px; max-width: 1200px; }

/* Filter bar in variable modal */
.exp-filter-bar {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #333;
    flex-wrap: wrap;
}
.exp-filter-bar input, .exp-filter-bar select {
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
}
.exp-filter-bar input { flex: 1; min-width: 200px; }
.exp-filter-bar select { min-width: 120px; }

/* Toast notification */
.exp-toast {
    position: fixed;
    bottom: 40px;
    right: 20px;
    background: #333;
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    font-size: 0.85rem;
    z-index: 2000;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s;
    max-width: 400px;
}
.exp-toast.show { opacity: 1; transform: translateY(0); }
.exp-toast.error { border-left: 3px solid #ff4444; }
.exp-toast.success { border-left: 3px solid #00ff88; }

/* Inline edit */
.exp-inline-edit {
    background: #1a1a2e;
    border: 1px solid #00ff88;
    color: #fff;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
    width: 100px;
}

/* Calibration change marks (triangles) */
.change-mark {
    display: inline-block;
    width: 0;
    height: 0;
    margin-left: 5px;
    vertical-align: middle;
    flex-shrink: 0;
}
.change-mark-up {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: 8px solid #ff4444;
}
.change-mark-down {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 8px solid #44cc66;
}

/* Event badge on measurement cards */
.exp-evt-badge {
    font-size: 0.68rem;
    color: #4488ff;
    background: rgba(68, 136, 255, 0.1);
    border: 1px solid rgba(68, 136, 255, 0.3);
    border-radius: 3px;
    padding: 1px 5px;
    margin-top: 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}
/* Change-event button on measurement cards */
.card-evt-btn {
    position: absolute;
    bottom: 0.4rem;
    right: 1.8rem;
    cursor: pointer;
    opacity: 0.5;
    font-size: 0.85rem;
    line-height: 1;
    padding: 2px 3px;
    border-radius: 2px;
    transition: opacity 0.15s;
}
.card-evt-btn:hover { opacity: 1; background: rgba(68,136,255,0.15); }

/* Signal Graph Panel */
.exp-graph-panel {
    flex-shrink: 0;
    border-top: 1px solid #333;
    background: #0d0d1a;
    display: flex;
    flex-direction: column;
}
.exp-graph-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 10px;
    background: #1a1a2e;
    border-bottom: 1px solid #333;
    min-height: 32px;
}
.exp-graph-title {
    font-size: 12px;
    font-weight: 700;
    color: #ccc;
    white-space: nowrap;
}
.exp-graph-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex: 1;
    overflow: hidden;
}
.exp-graph-legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #ccc;
    white-space: nowrap;
}
.exp-graph-legend-line {
    width: 20px;
    height: 2px;
    border-radius: 1px;
    flex-shrink: 0;
}
.exp-graph-live-badge {
    font-size: 11px;
    font-weight: 700;
    color: #00ff66;
    white-space: nowrap;
    animation: exp-graph-blink 1.2s ease-in-out infinite;
}
@keyframes exp-graph-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
.exp-graph-close-btn {
    background: none;
    border: none;
    color: #666;
    font-size: 14px;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 3px;
    line-height: 1;
    transition: color 0.15s, background 0.15s;
}
.exp-graph-close-btn:hover { color: #ff5555; background: rgba(255,85,85,0.12); }
.exp-graph-canvas-wrap {
    height: 220px;
    padding: 6px 8px 4px;
    background: #0d0d1a;
    position: relative;
}
.exp-graph-canvas-wrap canvas {
    width: 100%;
    height: 100%;
}
.exp-graph-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 10px;
    background: #1a1a2e;
    border-top: 1px solid #333;
}
.exp-graph-slider {
    flex: 1;
    accent-color: #00ff88;
    cursor: pointer;
    height: 4px;
}
/* Graph toggle button on measurement cards */
.card-graph-btn {
    position: absolute;
    bottom: 0.4rem;
    right: 3.5rem;
    cursor: pointer;
    opacity: 0.4;
    font-size: 0.85rem;
    line-height: 1;
    padding: 2px 3px;
    border-radius: 2px;
    transition: opacity 0.15s;
    user-select: none;
}
.card-graph-btn:hover { opacity: 1; background: rgba(0,255,136,0.1); }
.card-graph-btn.graphed { opacity: 1; color: #00ff88; background: rgba(0,255,136,0.15); }

/* Matrix/array cell changed indicator */
.matrix-cell-changed {
    position: relative;
}
.matrix-cell-changed::after {
    content: '';
    position: absolute;
    top: 2px;
    right: 2px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #ff4444;
}
.matrix-cell-changed-down::after {
    border-bottom: none;
    border-top: 6px solid #44cc66;
}
</style>

<div class="exp-container">
    <!-- Title Bar -->
    <div class="exp-title-bar">
        <span style="color: #00ff88; font-size: 1.2rem;">🧪</span>
        <input type="text" id="expTitle" value="New Experiment" placeholder="Experiment name..." title="Click to rename experiment">
        <span style="flex:1;"></span>
        <span id="expStateLabel" style="font-size: 0.8rem; color: #888;">IDLE</span>
    </div>

    <!-- Body: sidebar + main -->
    <div class="exp-body">
        <!-- Vertical Sidebar -->
        <div class="exp-sidebar">
            <button class="exp-sb-btn" onclick="expConnect()" title="Connect to devices">🔌</button>
            <button class="exp-sb-btn" id="btnAddVars" onclick="expOpenVarModal()" title="Add variables to current tab">📋</button>
            <div class="sidebar-separator"></div>
            <button class="exp-sb-btn" id="btnStart" onclick="expStart()" title="Start DAQ on all devices">▶️</button>
            <button class="exp-sb-btn" id="btnRefreshCal" onclick="expRefreshCalValues()" title="Refresh calibration values">🔄</button>
            <button class="exp-sb-btn danger" id="btnRecord" onclick="expRecord()" title="Start MF4 recording" style="display:none;">⏺</button>
            <button class="exp-sb-btn danger" id="btnStop" onclick="expStop()" title="Stop DAQ and recording" style="display:none;">⏹</button>
            <div class="sidebar-separator"></div>
            <div class="exp-pagemode">
                <label>R</label>
                <div class="toggle" id="pageModeToggle" onclick="expTogglePageMode()" title="Switch Reference/Working page"></div>
                <label>W</label>
            </div>
            <div class="sidebar-separator"></div>
            <button class="exp-sb-btn" onclick="expConfig()" title="Experiment settings">⚙️</button>
            <button class="exp-sb-btn" onclick="expSave()" title="Save experiment to JSON">💾</button>
            <button class="exp-sb-btn" onclick="expLoad()" title="Load experiment from JSON">📂</button>
            <div class="sidebar-separator"></div>
            <button class="exp-sb-btn" onclick="expChecksum()" title="Verify checksum on all slaves">✓</button>
            <button class="exp-sb-btn" onclick="expOpenDcmExport()" title="Export changed calibrations to DCM file">📤</button>
            <button class="exp-sb-btn" onclick="expAddTab()" title="Add new tab">+</button>
            <div style="flex:1;"></div>
            <a href="/experiment/help" class="exp-sb-btn" title="Help &amp; user guide">❓</a>
        </div>

        <!-- Right side: tabs + content + graph -->
        <div class="exp-right">
            <div class="exp-tab-bar" id="expTabBar">
            </div>
            <div class="exp-tab-content" id="expTabContent"></div>
            <!-- Signal Graph Panel -->
            <div id="expGraphPanel" class="exp-graph-panel" style="display:none;">
                <div class="exp-graph-header">
                    <span class="exp-graph-title">📈 Graph</span>
                    <div class="exp-graph-legend" id="expGraphLegend"></div>
                    <span id="expGraphLiveBadge" class="exp-graph-live-badge" style="display:none;">● LIVE</span>
                    <button class="exp-graph-close-btn" onclick="expCloseGraph()" title="Close graph panel">✕</button>
                </div>
                <div class="exp-graph-canvas-wrap">
                    <canvas id="expGraphCanvas"></canvas>
                </div>
                <div class="exp-graph-controls">
                    <span id="expGraphWinLabel" style="font-size:12px; min-width:48px; text-align:right; color:#ccc;">30 s</span>
                    <input type="range" id="expGraphWindowSlider" class="exp-graph-slider" min="0" max="6" value="3" oninput="expGraphOnWindowChange(this.value)">
                    <span style="font-size:11px; color:#666;">time window</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Bar -->
    <div class="exp-status-bar" id="expStatusBar">
        <span class="status-item">No devices connected</span>
    </div>
</div>

<!-- Variable Selection Modal -->
<div id="expVarModal" class="exp-modal" style="display:none;">
    <div class="exp-modal-content">
        <div class="exp-modal-header">
            <h3 style="margin:0;">Select Variables</h3>
            <button class="exp-modal-close" onclick="expCloseVarModal()">&times;</button>
        </div>
        <div class="exp-filter-bar">
            <input type="text" id="expVarSearch" placeholder="Search by name..." oninput="expFilterVars()">
            <select id="expVarFilterDevice" onchange="expFilterVars()">
                <option value="">All Devices</option>
            </select>
            <select id="expVarFilterType" onchange="expFilterVars()">
                <option value="">All Types</option>
                <option value="measurement">Measurements</option>
                <option value="calibration">Calibration</option>
            </select>
        </div>
        <div class="exp-modal-body" style="padding: 0;">
            <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
