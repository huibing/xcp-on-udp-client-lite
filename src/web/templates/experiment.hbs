<script>
// ===== Utility =====
function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ===== Experiment Page State =====
const EXP_MAX_TABS = 20;

const ExpState = {
    mode: 'idle',          // 'idle' | 'running' | 'recording'
    pageMode: 'reference', // 'reference' | 'working'
    tabs: [],
    activeTabId: null,
    allMeasurements: [],
    allCalibrations: [],
    liveValues: {},        // "device_id:name" -> value
    calValues: {},         // "device_id:idx" -> value string
    pageModeResults: {},   // device_id -> {success, read_only}
    config: {
        mf4Pattern: '{title}_{YYYYMMDD}_{HHMMSS}.mf4',
        mf4Dir: 'records/',
    },
    pollingInterval: null,
    statusInterval: null,
};

// ===== Tab Management =====
let tabCounter = 0;

// ===== Initialization =====
(function init() {
    expAddTab();
    expStartStatusPolling();
    expRefreshVariables();
})();

function expAddTab() {
    if (ExpState.tabs.length >= EXP_MAX_TABS) {
        expToast('Maximum ' + EXP_MAX_TABS + ' tabs reached', 'error');
        return;
    }
    tabCounter++;
    const tab = { id: 'tab-' + tabCounter, title: 'Tab ' + tabCounter, variables: [] };
    ExpState.tabs.push(tab);
    ExpState.activeTabId = tab.id;
    expRenderTabs();
    expRenderTabContent();
}

function expCloseTab(tabId, ev) {
    if (ev) ev.stopPropagation();
    if (ExpState.tabs.length <= 1) {
        expToast('Cannot close the last tab', 'error');
        return;
    }
    const idx = ExpState.tabs.findIndex(t => t.id === tabId);
    ExpState.tabs.splice(idx, 1);
    if (ExpState.activeTabId === tabId) {
        ExpState.activeTabId = ExpState.tabs[Math.min(idx, ExpState.tabs.length - 1)].id;
    }
    expRenderTabs();
    expRenderTabContent();
}

function expSelectTab(tabId) {
    ExpState.activeTabId = tabId;
    expRenderTabs();
    expRenderTabContent();
}

function expRenameTab(tabId, ev) {
    if (ev) ev.stopPropagation();
    const tabEl = document.querySelector('.exp-tab[data-id="' + tabId + '"] .tab-title');
    if (!tabEl) return;
    const input = document.getElementById('expTabRenameInput');
    const rect = tabEl.getBoundingClientRect();
    input.style.display = 'block';
    input.style.left = rect.left + 'px';
    input.style.top = rect.top + 'px';
    input.style.width = rect.width + 'px';
    const tab = ExpState.tabs.find(t => t.id === tabId);
    input.value = tab.title;
    input.focus();
    input.select();
    input.onblur = function() {
        tab.title = input.value.trim() || tab.title;
        input.style.display = 'none';
        expRenderTabs();
    };
    input.onkeydown = function(e) {
        if (e.key === 'Enter') input.blur();
        if (e.key === 'Escape') { input.value = tab.title; input.blur(); }
    };
}

function expRenderTabs() {
    const bar = document.getElementById('expTabBar');
    const addBtn = bar.querySelector('.exp-tab-add');
    bar.querySelectorAll('.exp-tab').forEach(function(el) { el.remove(); });
    ExpState.tabs.forEach(function(tab) {
        const el = document.createElement('div');
        el.className = 'exp-tab' + (tab.id === ExpState.activeTabId ? ' active' : '');
        el.dataset.id = tab.id;
        el.onclick = function() { expSelectTab(tab.id); };
        el.ondblclick = function(ev) { expRenameTab(tab.id, ev); };
        el.innerHTML =
            '<span class="tab-title">' + escapeHtml(tab.title) + '</span>' +
            '<span class="tab-close" onclick="expCloseTab(\'' + tab.id + '\', event)" title="Close tab">&times;</span>';
        bar.insertBefore(el, addBtn);
    });
}

// ===== Tab Content Rendering =====
function expRenderTabContent() {
    var container = document.getElementById('expTabContent');
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (!tab) {
        container.innerHTML = '<div class="exp-empty-tab"><div class="icon">📋</div><p>No tabs open</p></div>';
        return;
    }

    if (tab.variables.length === 0) {
        container.innerHTML =
            '<div class="exp-empty-tab">' +
            '<div class="icon">📋</div>' +
            '<p>No variables in this tab</p>' +
            '<p style="font-size:0.85rem;">Click "Variables" in the toolbar to add measurements and calibration parameters</p>' +
            '<button class="exp-tb-btn" onclick="expOpenVarModal()" ' + (ExpState.mode !== 'idle' ? 'disabled' : '') + '>📋 Add Variables</button>' +
            '</div>';
        return;
    }

    var measurements = tab.variables.filter(function(v) { return v.kind === 'measurement'; });
    var scalarCals = tab.variables.filter(function(v) { return v.kind === 'calibration' && !v.isMapCurve; });
    var mapCurveCals = tab.variables.filter(function(v) { return v.kind === 'calibration' && v.isMapCurve; });

    var html = '';

    // Measurement cards
    if (measurements.length > 0) {
        html += '<div class="exp-cards-section"><h3>📊 Measurements (' + measurements.length + ')</h3><div class="exp-cards-grid">';
        measurements.forEach(function(v) {
            var key = v.device_id + ':' + v.name;
            var val = ExpState.liveValues[key];
            var displayVal = val !== undefined ? formatValue(val) : '—';
            html +=
                '<div class="exp-var-card measurement" title="' + escapeHtml(v.device_name + ' / ' + v.name) + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-value"><span data-live-key="' + escapeHtml(key) + '">' + displayVal + '</span><span class="card-unit">' + escapeHtml(v.unit || '') + '</span></div>' +
                '<span class="card-info-btn" onclick="event.stopPropagation(); expShowInfo(\'measurement\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')" title="Variable info">ℹ️</span>' +
                (ExpState.mode === 'idle' ? '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' : '') +
                '</div>';
        });
        html += '</div></div>';
    }

    // Scalar calibration cards
    if (scalarCals.length > 0) {
        var isWorking = ExpState.pageMode === 'working';
        html += '<div class="exp-cards-section"><h3>🔧 Calibration (' + scalarCals.length + ')</h3><div class="exp-cards-grid">';
        scalarCals.forEach(function(v) {
            var calKey = v.device_id + ':' + v.idx;
            var val = ExpState.calValues[calKey];
            var displayVal = val !== undefined ? val : '—';
            var deviceResult = ExpState.pageModeResults[v.device_id];
            var readOnly = !isWorking || (deviceResult && deviceResult.read_only);
            var editableClass = isWorking && !readOnly ? 'editable' : 'readonly';
            var clickHandler = isWorking && !readOnly ? 'onclick="expEditCal(\'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')"' : '';
            html +=
                '<div class="exp-var-card calibration ' + editableClass + '" ' + clickHandler + ' title="' + escapeHtml(v.device_name + ' / ' + v.name) + (readOnly ? ' (read-only)' : '') + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-value"><span data-cal-key="' + escapeHtml(calKey) + '">' + escapeHtml(String(displayVal)) + '</span><span class="card-unit">' + escapeHtml(v.unit || '') + '</span></div>' +
                '<span class="card-info-btn" onclick="event.stopPropagation(); expShowInfo(\'cal\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')" title="Variable info">ℹ️</span>' +
                (ExpState.mode === 'idle' ? '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' : '') +
                '</div>';
        });
        html += '</div></div>';
    }

    // Map/Curve calibration cards (no value, info + table buttons)
    if (mapCurveCals.length > 0) {
        html += '<div class="exp-cards-section"><h3>📐 Maps & Curves (' + mapCurveCals.length + ')</h3><div class="exp-cards-grid">';
        mapCurveCals.forEach(function(v) {
            html +=
                '<div class="exp-var-card calibration map-curve" title="' + escapeHtml(v.device_name + ' / ' + v.name) + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-type" style="color:#888; font-size:0.75rem; margin-top:0.15rem;">' + escapeHtml(v.calType || '') + '</div>' +
                '<div class="card-map-actions" style="display:flex; gap:0.5rem; margin-top:0.5rem;">' +
                '<button class="exp-tb-btn" style="font-size:0.75rem; padding:0.25rem 0.5rem;" onclick="event.stopPropagation(); expShowInfo(\'cal\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')">ℹ️ Info</button>' +
                '<button class="exp-tb-btn" style="font-size:0.75rem; padding:0.25rem 0.5rem;" onclick="event.stopPropagation(); expShowMatrix(\'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')">📊 Table</button>' +
                '</div>' +
                (ExpState.mode === 'idle' ? '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' : '') +
                '</div>';
        });
        html += '</div></div>';
    }

    container.innerHTML = html;
}

function formatValue(val) {
    if (typeof val === 'number') {
        return Number.isInteger(val) ? val.toString() : val.toFixed(4);
    }
    return String(val);
}

// ===== Variable Removal =====
function expRemoveVar(tabId, deviceId, idx, kind) {
    if (ExpState.mode !== 'idle') return;
    var tab = ExpState.tabs.find(function(t) { return t.id === tabId; });
    if (!tab) return;
    tab.variables = tab.variables.filter(function(v) {
        return !(v.device_id === deviceId && v.idx === idx && v.kind === kind);
    });
    expRenderTabContent();
}

// ===== Variable Selection Modal =====
var expVarModalSelection = {};  // "kind:device_id:idx" -> true
var expFilteredItems = [];
var expDisplayedCount = 0;
var expIsLoadingMore = false;
var EXP_VAR_BATCH_SIZE = 500;

function expOpenVarModal() {
    if (ExpState.mode !== 'idle') {
        expToast('Cannot change variables while DAQ is running', 'error');
        return;
    }
    document.getElementById('expVarModal').style.display = 'flex';
    expVarModalSelection = {};
    expFilteredItems = [];
    expDisplayedCount = 0;
    expIsLoadingMore = false;
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (tab) {
        tab.variables.forEach(function(v) {
            expVarModalSelection[v.kind + ':' + v.device_id + ':' + v.idx] = true;
        });
    }
    expPopulateVarModal();
    expSetupVarScrollListener();
}

function expCloseVarModal() {
    document.getElementById('expVarModal').style.display = 'none';
}

function expRefreshVariables() {
    fetch('/api/experiment/variables')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                ExpState.allMeasurements = data.measurements || [];
                ExpState.allCalibrations = data.calibrations || [];
                expPopulateVarFilterDevices();
            }
        })
        .catch(function(e) { console.error('Failed to load variables:', e); });
}

function expPopulateVarFilterDevices() {
    var sel = document.getElementById('expVarFilterDevice');
    var devices = {};
    ExpState.allMeasurements.forEach(function(v) { devices[v.device_id] = v.device_name; });
    ExpState.allCalibrations.forEach(function(v) { devices[v.device_id] = v.device_name; });
    sel.innerHTML = '<option value="">All Devices</option>';
    Object.keys(devices).forEach(function(id) {
        sel.innerHTML += '<option value="' + escapeHtml(id) + '">' + escapeHtml(devices[id]) + '</option>';
    });
}

function expPopulateVarModal() {
    var tbody = document.getElementById('expVarList');
    var search = document.getElementById('expVarSearch').value.toLowerCase();
    var deviceFilter = document.getElementById('expVarFilterDevice').value;
    var typeFilter = document.getElementById('expVarFilterType').value;

    var items = [];

    if (typeFilter !== 'calibration') {
        ExpState.allMeasurements.forEach(function(m) {
            items.push({
                kind: 'measurement', device_id: m.device_id, device_name: m.device_name,
                idx: m.idx, name: m.name, type: m.type || '', address: m.address_hex || '',
                unit: m.unit || '', connected: m.connected,
            });
        });
    }

    if (typeFilter !== 'measurement') {
        ExpState.allCalibrations.forEach(function(c) {
            var tn = c.type_name || c.type || '';
            var ct = (c.characteristic_type || '').toUpperCase();
            items.push({
                kind: 'calibration', device_id: c.device_id, device_name: c.device_name,
                idx: c.idx, name: c.name, type: tn,
                address: c.address_hex || (c.address ? ('0x' + Number(c.address).toString(16).toUpperCase().padStart(8, '0')) : ''),
                unit: c.unit || '', connected: c.connected, calType: c.characteristic_type || tn,
                isMapCurve: ct === 'MAP' || ct === 'CURVE' || ct === 'VAL_BLK' || tn.indexOf('Matrix') >= 0 || tn.indexOf('Array') >= 0,
            });
        });
    }

    if (search) {
        items = items.filter(function(v) { return v.name.toLowerCase().indexOf(search) >= 0 || v.device_name.toLowerCase().indexOf(search) >= 0; });
    }
    if (deviceFilter) {
        items = items.filter(function(v) { return v.device_id === deviceFilter; });
    }

    expFilteredItems = items;
    expDisplayedCount = 0;
    tbody.innerHTML = '';

    var firstBatch = expFilteredItems.slice(0, EXP_VAR_BATCH_SIZE);
    tbody.innerHTML = expRenderVarRows(firstBatch);
    expDisplayedCount = firstBatch.length;

    var indicator = document.getElementById('expLoadingIndicator');
    indicator.style.display = expDisplayedCount < expFilteredItems.length ? 'block' : 'none';

    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expRenderVarRows(items) {
    var html = '';
    items.forEach(function(v) {
        var key = v.kind + ':' + v.device_id + ':' + v.idx;
        var checked = expVarModalSelection[key] ? 'checked' : '';
        var kindLabel = v.kind === 'measurement' ? '📊 Meas' : '🔧 Cal';
        var kindColor = v.kind === 'measurement' ? '#4488ff' : '#ff8844';
        html +=
            '<tr onclick="expToggleVarCheckbox(\'' + key + '\')" style="cursor:pointer;" class="' + (checked ? 'selected-row' : '') + '">' +
            '<td style="padding:0.5rem; text-align:center;"><input type="checkbox" ' + checked + ' data-key="' + key + '" onclick="event.stopPropagation(); expToggleVar(\'' + key + '\')"></td>' +
            '<td style="padding:0.5rem;">' + escapeHtml(v.name) + '</td>' +
            '<td style="padding:0.5rem; color:#888;">' + escapeHtml(v.device_name) + '</td>' +
            '<td style="padding:0.5rem;"><span style="color:' + kindColor + '; font-size:0.8rem;">' + kindLabel + '</span></td>' +
            '<td style="padding:0.5rem; font-family:monospace; font-size:0.8rem;">' + escapeHtml(v.type) + '</td>' +
            '<td style="padding:0.5rem; font-family:monospace; font-size:0.8rem; color:#888;">' + escapeHtml(v.address) + '</td>' +
            '</tr>';
    });
    return html;
}

function expLoadMoreVars() {
    if (expIsLoadingMore || expDisplayedCount >= expFilteredItems.length) return;
    expIsLoadingMore = true;
    var indicator = document.getElementById('expLoadingIndicator');
    indicator.style.display = 'block';
    setTimeout(function() {
        var tbody = document.getElementById('expVarList');
        var nextBatch = expFilteredItems.slice(expDisplayedCount, expDisplayedCount + EXP_VAR_BATCH_SIZE);
        tbody.insertAdjacentHTML('beforeend', expRenderVarRows(nextBatch));
        expDisplayedCount += nextBatch.length;
        indicator.style.display = expDisplayedCount < expFilteredItems.length ? 'block' : 'none';
        expIsLoadingMore = false;
    }, 50);
}

function expSetupVarScrollListener() {
    var modalBody = document.querySelector('#expVarModal .exp-modal-body');
    if (!modalBody) return;
    var fresh = modalBody.cloneNode(true);
    modalBody.parentNode.replaceChild(fresh, modalBody);
    var ref = document.querySelector('#expVarModal .exp-modal-body');
    ref.addEventListener('scroll', function() {
        if (ref.scrollTop + ref.clientHeight >= ref.scrollHeight - 100) {
            if (!expIsLoadingMore && expDisplayedCount < expFilteredItems.length) {
                expLoadMoreVars();
            }
        }
    });
}

function expFilterVars() {
    expPopulateVarModal();
    expSetupVarScrollListener();
}

function expToggleVar(key) {
    if (expVarModalSelection[key]) {
        delete expVarModalSelection[key];
    } else {
        expVarModalSelection[key] = true;
    }
    // Update row in-place instead of re-rendering
    var cb = document.querySelector('#expVarList input[data-key="' + key + '"]');
    if (cb) {
        var isSelected = !!expVarModalSelection[key];
        cb.checked = isSelected;
        cb.closest('tr').className = isSelected ? 'selected-row' : '';
    }
    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expToggleVarCheckbox(key) { expToggleVar(key); }

function expToggleSelectAll() {
    var allChecked = document.getElementById('expSelectAll').checked;
    document.querySelectorAll('#expVarList input[type="checkbox"]').forEach(function(cb) {
        var key = cb.dataset.key;
        if (allChecked) {
            expVarModalSelection[key] = true;
            cb.checked = true;
            cb.closest('tr').className = 'selected-row';
        } else {
            delete expVarModalSelection[key];
            cb.checked = false;
            cb.closest('tr').className = '';
        }
    });
    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expApplyVarSelection() {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (!tab) return;

    var newVars = [];
    Object.keys(expVarModalSelection).forEach(function(key) {
        var parts = key.split(':');
        var kind = parts[0];
        var device_id = parts[1];
        var idx = parseInt(parts[2]);
        var source;
        if (kind === 'measurement') {
            source = ExpState.allMeasurements.find(function(m) { return m.device_id === device_id && m.idx === idx; });
            if (source) {
                newVars.push({
                    kind: 'measurement', device_id: source.device_id, device_name: source.device_name,
                    idx: source.idx, name: source.name, type: source.type || '',
                    unit: source.unit || '', isMapCurve: false,
                });
            }
        } else {
            source = ExpState.allCalibrations.find(function(c) { return c.device_id === device_id && c.idx === idx; });
            if (source) {
                var typeName = source.type_name || source.type || '';
                var charType = (source.characteristic_type || '').toUpperCase();
                newVars.push({
                    kind: 'calibration', device_id: source.device_id, device_name: source.device_name,
                    idx: source.idx, name: source.name, type: typeName,
                    unit: source.unit || '', calType: source.characteristic_type || typeName,
                    isMapCurve: charType === 'MAP' || charType === 'CURVE' || charType === 'VAL_BLK' || typeName.indexOf('Matrix') >= 0 || typeName.indexOf('Array') >= 0,
                });
            }
        }
    });

    tab.variables = newVars;
    expCloseVarModal();
    expRenderTabContent();
    expReadAllCalValues();
}

// ===== DAQ Control =====
function expStart() {
    if (ExpState.mode !== 'idle') return;

    // Collect unique measurements across all tabs, grouped by device
    var selections = {};
    var seen = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'measurement'; }).forEach(function(v) {
            var key = v.device_id + ':' + v.idx;
            if (!seen[key]) {
                seen[key] = true;
                if (!selections[v.device_id]) selections[v.device_id] = [];
                selections[v.device_id].push(v.idx);
            }
        });
    });

    if (Object.keys(selections).length === 0) {
        expToast('No measurement variables selected in any tab', 'error');
        return;
    }

    document.getElementById('btnStart').disabled = true;

    fetch('/api/experiment/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ selections: selections }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            ExpState.mode = 'running';
            expUpdateToolbarState();
            expStartDataPolling();
            expToast('DAQ started on ' + data.started + ' device(s)', 'success');
        } else {
            expToast('Start failed: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
        document.getElementById('btnStart').disabled = false;
    })
    .catch(function(e) {
        expToast('Start failed: ' + e, 'error');
        document.getElementById('btnStart').disabled = false;
    });
}

function expRecord() {
    if (ExpState.mode !== 'running') return;
    var title = document.getElementById('expTitle').value.trim() || 'experiment';

    fetch('/api/experiment/record/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ title: title }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            ExpState.mode = 'recording';
            expUpdateToolbarState();
            expToast('Recording started', 'success');
        } else {
            expToast('Record failed: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
    })
    .catch(function(e) { expToast('Record failed: ' + e, 'error'); });
}

function expStop() {
    if (ExpState.mode === 'idle') return;

    fetch('/api/experiment/stop', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        ExpState.mode = 'idle';
        expStopDataPolling();
        expUpdateToolbarState();
        if (data.success) {
            expToast('DAQ stopped on ' + data.stopped + ' device(s)', 'success');
        } else {
            expToast('Stop: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
    })
    .catch(function(e) {
        ExpState.mode = 'idle';
        expStopDataPolling();
        expUpdateToolbarState();
        expToast('Stop error: ' + e, 'error');
    });
}

function expUpdateToolbarState() {
    var btnStart = document.getElementById('btnStart');
    var btnRecord = document.getElementById('btnRecord');
    var btnStop = document.getElementById('btnStop');
    var btnAddVars = document.getElementById('btnAddVars');
    var stateLabel = document.getElementById('expStateLabel');

    switch (ExpState.mode) {
        case 'idle':
            btnStart.style.display = '';
            btnRecord.style.display = 'none';
            btnStop.style.display = 'none';
            btnAddVars.disabled = false;
            stateLabel.textContent = 'IDLE';
            stateLabel.style.color = '#888';
            btnRecord.classList.remove('recording');
            btnRecord.disabled = false;
            break;
        case 'running':
            btnStart.style.display = 'none';
            btnRecord.style.display = '';
            btnStop.style.display = '';
            btnAddVars.disabled = true;
            stateLabel.textContent = 'DAQ RUNNING';
            stateLabel.style.color = '#00ff88';
            btnRecord.classList.remove('recording');
            btnRecord.disabled = false;
            break;
        case 'recording':
            btnStart.style.display = 'none';
            btnRecord.style.display = '';
            btnRecord.classList.add('recording');
            btnRecord.disabled = true;
            btnStop.style.display = '';
            btnAddVars.disabled = true;
            stateLabel.textContent = '⏺ RECORDING';
            stateLabel.style.color = '#ff4444';
            break;
    }
    expRenderTabContent();
}

// ===== Data Polling =====
function expStartDataPolling() {
    if (ExpState.pollingInterval) return;
    ExpState.pollingInterval = setInterval(expPollData, 500);
}

function expStopDataPolling() {
    if (ExpState.pollingInterval) {
        clearInterval(ExpState.pollingInterval);
        ExpState.pollingInterval = null;
    }
}

function expPollData() {
    // Collect all measurement variables across tabs to build a filter list
    var varList = [];
    var seen = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'measurement'; }).forEach(function(v) {
            var k = v.device_id + ':' + v.name;
            if (!seen[k]) {
                seen[k] = true;
                varList.push({ device_id: v.device_id, name: v.name });
            }
        });
    });

    if (varList.length === 0) return;

    fetch('/api/daq/data', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ variables: varList }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success && data.values && Array.isArray(data.values)) {
            data.values.forEach(function(entry) {
                var key = entry.device_id + ':' + entry.var_name;
                ExpState.liveValues[key] = parseFloat(entry.value);
            });
            document.querySelectorAll('[data-live-key]').forEach(function(el) {
                var key = el.dataset.liveKey;
                if (ExpState.liveValues[key] !== undefined) {
                    el.textContent = formatValue(ExpState.liveValues[key]);
                }
            });
        }
    })
    .catch(function() {});
}

// ===== Status Polling =====
function expStartStatusPolling() {
    ExpState.statusInterval = setInterval(expPollStatus, 3000);
    expPollStatus();
}

function expPollStatus() {
    fetch('/api/experiment/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                expUpdateStatusBar(data.devices || []);
                // Sync mode if server says experiment is active but we think idle
                if (data.experiment_active && ExpState.mode === 'idle') {
                    if (data.daq_running_count > 0) {
                        ExpState.mode = data.recording_count > 0 ? 'recording' : 'running';
                        expUpdateToolbarState();
                        if (ExpState.mode !== 'idle') expStartDataPolling();
                    }
                }
            }
        })
        .catch(function() {});
}

function expUpdateStatusBar(devices) {
    var bar = document.getElementById('expStatusBar');
    if (devices.length === 0) {
        bar.innerHTML = '<span class="status-item">No devices loaded</span>';
        return;
    }
    var html = '';
    devices.forEach(function(d, i) {
        if (i > 0) html += '<span class="status-separator"></span>';
        var dotClass = d.connected ? 'connected' : 'disconnected';
        var name = d.device_name || d.device_id;
        var tooltip = name + '\nA2L: ' + (d.a2l_file || 'none') + '\nPage: ' + (d.page_mode || 'N/A') + '\nDAQ: ' + (d.daq_running ? 'running' : 'stopped');
        html += '<span class="status-item" title="' + escapeHtml(tooltip) + '"><span class="status-dot ' + dotClass + '"></span>' + escapeHtml(name) + '</span>';
    });
    bar.innerHTML = html;
}

// ===== Page Mode Toggle =====
function expTogglePageMode() {
    var newMode = ExpState.pageMode === 'reference' ? 'working' : 'reference';

    fetch('/api/experiment/pagemode', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ mode: newMode }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.switched > 0 || data.failed === 0) {
            ExpState.pageMode = newMode;
            var toggle = document.getElementById('pageModeToggle');
            if (newMode === 'working') toggle.classList.add('working');
            else toggle.classList.remove('working');

            if (data.results) {
                data.results.forEach(function(r) {
                    ExpState.pageModeResults[r.device_id] = {
                        success: r.success,
                        read_only: r.read_only || false,
                    };
                });
            }

            if (data.failed > 0) {
                expToast('Switched ' + data.switched + ' device(s), ' + data.failed + ' failed (read-only)', 'error');
            } else {
                expToast('Switched to ' + newMode + ' page', 'success');
            }
            expRenderTabContent();
        } else {
            expToast('Page mode switch failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Page mode switch failed: ' + e, 'error'); });
}

// ===== Calibration Read/Edit =====
function expReadAllCalValues() {
    var calVars = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'calibration'; }).forEach(function(v) {
            calVars[v.device_id + ':' + v.idx] = true;
        });
    });

    Object.keys(calVars).forEach(function(key) {
        var parts = key.split(':');
        var deviceId = parts[0];
        var idx = parts[1];
        fetch('/api/cal/value/' + deviceId + '/' + idx)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.value !== undefined) {
                    ExpState.calValues[key] = data.value;
                    document.querySelectorAll('[data-cal-key="' + key + '"]').forEach(function(el) {
                        el.textContent = String(data.value);
                    });
                }
            })
            .catch(function() {});
    });
}

var currentCalEdit = null;

function expEditCal(deviceId, idx, name) {
    if (ExpState.pageMode !== 'working') return;
    currentCalEdit = { deviceId: deviceId, idx: idx, name: name };
    document.getElementById('expCalEditTitle').textContent = 'Edit: ' + name;
    var key = deviceId + ':' + idx;
    document.getElementById('expCalEditValue').value = ExpState.calValues[key] || '';
    document.getElementById('expCalEditModal').style.display = 'flex';
    document.getElementById('expCalEditValue').focus();
}

function expCloseCalEdit() {
    document.getElementById('expCalEditModal').style.display = 'none';
    currentCalEdit = null;
}

function expSaveCalEdit() {
    if (!currentCalEdit) return;
    var deviceId = currentCalEdit.deviceId;
    var idx = currentCalEdit.idx;
    var value = document.getElementById('expCalEditValue').value;

    fetch('/api/cal/write/' + deviceId + '/' + idx, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: 'value=' + encodeURIComponent(value),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            var key = deviceId + ':' + idx;
            ExpState.calValues[key] = value;
            document.querySelectorAll('[data-cal-key="' + key + '"]').forEach(function(el) {
                el.textContent = value;
            });
            expCloseCalEdit();
            expToast('Value written successfully', 'success');
        } else {
            expToast('Write failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Write failed: ' + e, 'error'); });
}

// ===== Map/Curve Data Loading =====
function expLoadMapData(deviceId, idx) {
    expShowMatrix(deviceId, idx, '');
}

// ===== Variable Info Modal =====
function expShowInfo(varType, deviceId, idx, name) {
    document.getElementById('expInfoTitle').textContent = name;
    document.getElementById('expInfoModal').style.display = 'flex';
    document.getElementById('expInfoBody').innerHTML = '<p style="text-align:center; color:#888;">Loading...</p>';

    var apiPath = varType === 'cal' ? '/api/cal/detail/' + deviceId + '/' + idx : '/api/daq/detail/' + deviceId + '/' + idx;
    fetch(apiPath)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.detail) {
                expRenderInfo(data.detail, varType);
            } else {
                document.getElementById('expInfoBody').innerHTML = '<p style="color:#ff4444;">Error: ' + escapeHtml(data.error || 'Unknown') + '</p>';
            }
        })
        .catch(function(e) {
            document.getElementById('expInfoBody').innerHTML = '<p style="color:#ff4444;">Failed: ' + escapeHtml(e.message || String(e)) + '</p>';
        });
}

function expCloseInfo() {
    document.getElementById('expInfoModal').style.display = 'none';
}

function expRenderInfo(detail, varType) {
    var body = document.getElementById('expInfoBody');
    var html = '<table style="width:100%; border-collapse:collapse;">';

    function row(label, value) {
        if (value === undefined || value === null || value === '') return '';
        return '<tr class="exp-info-row"><td>' + escapeHtml(label) + '</td><td style="font-family:monospace; word-break:break-all;">' + escapeHtml(String(value)) + '</td></tr>';
    }

    html += row('Name', detail.name);
    html += row('Device', detail.device_name);
    html += row('Type', detail.type);
    html += row('Address', detail.address);
    html += row('Address Extension', detail.address_ext);

    if (varType === 'cal') {
        html += row('Description', detail.description);
        html += row('Unit', detail.unit);
        html += row('Range', detail.range);
        html += row('Characteristic Type', detail.characteristic_type);
        html += row('Storage Order', detail.storage_order);
        html += row('Data Size', detail.data_size);

        if (detail.axis_info && detail.axis_info.length > 0) {
            html += '<tr><td colspan="2" style="padding:1rem 0.5rem 0.5rem; border:none; font-weight:bold; color:#00ff88;">Axis Information</td></tr>';
            detail.axis_info.forEach(function(axis, i) {
                var axisRole = '';
                if (detail.characteristic_type === 'MAP' && detail.axis_info.length === 2) {
                    axisRole = i === 0 ? ' (X, columns)' : ' (Y, rows)';
                } else if (detail.characteristic_type === 'CURVE') {
                    axisRole = ' (X)';
                }
                html += '<tr><td colspan="2" style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' +
                    '<strong>Axis ' + (i + 1) + axisRole + ': ' + escapeHtml(axis.name) + '</strong>' +
                    (axis.unit ? ' (' + escapeHtml(axis.unit) + ')' : '') +
                    '<br>Points: ' + axis.num_points + ', Range: ' + axis.min + ' ~ ' + axis.max +
                    '</td></tr>';
            });
        }
    } else {
        html += row('Description', detail.description);
        html += row('Unit', detail.unit);
        html += row('Data Size', detail.data_size);
    }

    html += '</table>';
    body.innerHTML = html;
}

// ===== Matrix/Array Data Modal =====
var expMatrixDeviceId = null;
var expMatrixIdx = null;

function expShowMatrix(deviceId, idx, name) {
    expMatrixDeviceId = deviceId;
    expMatrixIdx = idx;
    document.getElementById('expMatrixTitle').textContent = name || 'Data Viewer';
    document.getElementById('expMatrixModal').style.display = 'flex';
    document.getElementById('expMatrixBody').innerHTML = '<p style="text-align:center; color:#888;">Loading data...</p>';
    document.getElementById('expMatrixAxisInfo').innerHTML = '';
    document.getElementById('expMatrixPageMode').innerHTML = '';

    fetch('/api/cal/value/' + deviceId + '/' + idx)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                expRenderMatrix(data);
            } else {
                document.getElementById('expMatrixBody').innerHTML = '<p style="color:#ff4444;">Error: ' + escapeHtml(data.error || '') + '</p>';
            }
        })
        .catch(function(e) {
            document.getElementById('expMatrixBody').innerHTML = '<p style="color:#ff4444;">Failed: ' + escapeHtml(String(e)) + '</p>';
        });
}

function expCloseMatrix() {
    document.getElementById('expMatrixModal').style.display = 'none';
    expMatrixDeviceId = null;
    expMatrixIdx = null;
}

function expRenderMatrix(data) {
    var container = document.getElementById('expMatrixBody');
    var isWorking = data.is_working_page;
    var axisValues = data.axis_values || [];
    var axisInfo = data.axis_info || [];

    // Page mode indicator
    var pageModeSpan = document.getElementById('expMatrixPageMode');
    if (isWorking) {
        pageModeSpan.innerHTML = '<span style="color:#4CAF50;">✏️ Working (editable)</span>';
    } else {
        pageModeSpan.innerHTML = '<span style="color:#888;">📖 Reference (read-only)</span>';
    }

    // Axis info
    var axisInfoDiv = document.getElementById('expMatrixAxisInfo');
    if (axisInfo.length === 2) {
        axisInfoDiv.innerHTML = 'X: ' + escapeHtml(axisInfo[0].name) + ' | Y: ' + escapeHtml(axisInfo[1].name);
    } else if (axisInfo.length === 1) {
        axisInfoDiv.innerHTML = 'X: ' + escapeHtml(axisInfo[0].name);
    }

    // Update title with name if available
    if (data.name) {
        document.getElementById('expMatrixTitle').textContent = data.name;
    }

    if (data.is_1d) {
        expRender1DTable(container, data, isWorking, axisValues, axisInfo);
    } else {
        expRender2DTable(container, data, isWorking, axisValues, axisInfo);
    }
}

function expRender1DTable(container, data, isWorking, axisValues, axisInfo) {
    var values = data.value;
    var cols = data.cols;
    var xLabels = [];
    if (axisValues.length > 0 && axisValues[0]) {
        xLabels = axisValues[0].map(function(v) { return String(v); });
    }

    var html = '<table style="width:100%; border-collapse:collapse;"><thead><tr>' +
        '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">Index</th>';
    for (var c = 0; c < cols; c++) {
        html += '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' + escapeHtml(xLabels[c] || String(c)) + '</th>';
    }
    html += '</tr></thead><tbody><tr><td style="padding:0.5rem; background:#1e1e1e; border:1px solid #444; font-weight:bold;">Value</td>';
    for (var c = 0; c < cols; c++) {
        var val = values[c] !== undefined ? values[c] : '-';
        if (isWorking) {
            html += '<td style="padding:0.25rem; border:1px solid #444; text-align:center;">' +
                '<input type="text" value="' + val + '" style="width:80px; text-align:center; background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem;" ' +
                'onchange="expSaveMatrixCell(0, ' + c + ', this.value)">' +
                '</td>';
        } else {
            html += '<td style="padding:0.5rem; border:1px solid #444; text-align:center; color:#00ff88;">' + val + '</td>';
        }
    }
    html += '</tr></tbody></table>';
    container.innerHTML = html;
}

function expRender2DTable(container, data, isWorking, axisValues, axisInfo) {
    var values = data.value;
    var rows = data.rows;
    var cols = data.cols;
    var xLabels = [], yLabels = [];
    if (axisValues.length > 1) {
        xLabels = axisValues[0] ? axisValues[0].map(function(v) { return String(v); }) : [];
        yLabels = axisValues[1] ? axisValues[1].map(function(v) { return String(v); }) : [];
    } else if (axisValues.length > 0) {
        yLabels = axisValues[0] ? axisValues[0].map(function(v) { return String(v); }) : [];
    }

    // Transpose for correct display (values[r][c] where r=X_points, c=Y_points -> display r=Y, c=X)
    var transposed = [];
    for (var c = 0; c < cols; c++) {
        transposed[c] = [];
        for (var r = 0; r < rows; r++) {
            transposed[c][r] = values[r] ? values[r][c] : '-';
        }
    }
    var displayRows = cols;
    var displayCols = rows;

    var html = '<table style="width:100%; border-collapse:collapse;"><thead><tr>' +
        '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;"></th>';
    for (var dc = 0; dc < displayCols; dc++) {
        html += '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' + escapeHtml(xLabels[dc] || String(dc)) + '</th>';
    }
    html += '</tr></thead><tbody>';

    for (var dr = 0; dr < displayRows; dr++) {
        html += '<tr><td style="padding:0.5rem; background:#2a2a2a; border:1px solid #444; font-weight:bold;">' + escapeHtml(yLabels[dr] || String(dr)) + '</td>';
        for (var dc = 0; dc < displayCols; dc++) {
            var val = transposed[dr] ? (transposed[dr][dc] !== undefined ? transposed[dr][dc] : '-') : '-';
            if (isWorking) {
                html += '<td style="padding:0.25rem; border:1px solid #444; text-align:center;">' +
                    '<input type="text" value="' + val + '" style="width:80px; text-align:center; background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem;" ' +
                    'onchange="expSaveMatrixCell(' + dc + ', ' + dr + ', this.value)">' +
                    '</td>';
            } else {
                html += '<td style="padding:0.5rem; border:1px solid #444; text-align:center; color:#00ff88;">' + val + '</td>';
            }
        }
        html += '</tr>';
    }
    html += '</tbody></table>';
    container.innerHTML = html;
}

function expSaveMatrixCell(row, col, newVal) {
    if (!expMatrixDeviceId || expMatrixIdx === null) return;
    fetch('/api/cal/write-element/' + expMatrixDeviceId + '/' + expMatrixIdx, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ row: row, col: col, value: newVal }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            expToast('Cell updated', 'success');
        } else {
            expToast('Write failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Write error: ' + e, 'error'); });
}

// ===== Save / Load =====
function expSave() {
    var experiment = {
        version: 1,
        title: document.getElementById('expTitle').value,
        config: ExpState.config,
        pageMode: ExpState.pageMode,
        tabs: ExpState.tabs.map(function(t) { return { id: t.id, title: t.title, variables: t.variables }; }),
        pageModeResults: ExpState.pageModeResults,
        savedAt: new Date().toISOString(),
    };

    var blob = new Blob([JSON.stringify(experiment, null, 2)], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = (experiment.title || 'experiment').replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';
    a.click();
    URL.revokeObjectURL(url);
    expToast('Experiment saved', 'success');
}

function expLoad() {
    if (ExpState.mode !== 'idle') {
        expToast('Stop DAQ before loading', 'error');
        return;
    }
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(ev) {
            try {
                var data = JSON.parse(ev.target.result);
                expApplyLoadedConfig(data);
                expToast('Experiment loaded: ' + (data.title || file.name), 'success');
            } catch (err) {
                expToast('Invalid experiment file: ' + err.message, 'error');
            }
        };
        reader.readAsText(file);
    };
    input.click();
}

function expApplyLoadedConfig(data) {
    if (data.title) document.getElementById('expTitle').value = data.title;
    if (data.config) {
        ExpState.config = { mf4Pattern: data.config.mf4Pattern || ExpState.config.mf4Pattern, mf4Dir: data.config.mf4Dir || ExpState.config.mf4Dir };
        document.getElementById('expMf4Pattern').value = ExpState.config.mf4Pattern;
        document.getElementById('expMf4Dir').value = ExpState.config.mf4Dir;
    }
    if (data.tabs && Array.isArray(data.tabs)) {
        ExpState.tabs = data.tabs;
        tabCounter = Math.max(tabCounter, data.tabs.length);
        ExpState.activeTabId = ExpState.tabs.length > 0 ? ExpState.tabs[0].id : null;
    }
    if (data.pageModeResults) ExpState.pageModeResults = data.pageModeResults;
    expRenderTabs();
    expRenderTabContent();
    expReadAllCalValues();
}

// ===== Config Dialog =====
function expConfig() {
    document.getElementById('expMf4Pattern').value = ExpState.config.mf4Pattern;
    document.getElementById('expMf4Dir').value = ExpState.config.mf4Dir;

    fetch('/api/experiment/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var container = document.getElementById('expConfigDevices');
            if (!data.devices || data.devices.length === 0) {
                container.innerHTML = '<p style="color:#666;">No devices loaded</p>';
            } else {
                container.innerHTML = data.devices.map(function(d) {
                    return '<div style="display:flex; align-items:center; gap:0.5rem; padding:0.5rem; border-bottom:1px solid #333;">' +
                        '<span class="status-dot ' + (d.connected ? 'connected' : 'disconnected') + '"></span>' +
                        '<input type="text" value="' + escapeHtml(d.device_name) + '" style="flex:1; font-size:0.85rem;" data-device-id="' + escapeHtml(d.device_id) + '" onblur="expRenameDevice(\'' + escapeHtml(d.device_id) + '\', this.value)">' +
                        '<span style="color:#666; font-size:0.75rem;">' + escapeHtml(d.a2l_file || '') + '</span>' +
                        '</div>';
                }).join('');
            }
        });

    document.getElementById('expConfigModal').style.display = 'flex';
}

function expCloseConfig() {
    document.getElementById('expConfigModal').style.display = 'none';
}

function expSaveConfig() {
    ExpState.config.mf4Pattern = document.getElementById('expMf4Pattern').value;
    ExpState.config.mf4Dir = document.getElementById('expMf4Dir').value;
    // Apply any device renames from config inputs
    var inputs = document.querySelectorAll('#expConfigDevices input[data-device-id]');
    inputs.forEach(function(inp) {
        var deviceId = inp.dataset.deviceId;
        var newName = inp.value.trim();
        if (newName) {
            expRenameDevice(deviceId, newName);
        }
    });
    expCloseConfig();
    expToast('Configuration saved', 'success');
}

function expRenameDevice(deviceId, newName) {
    if (!newName.trim()) return;
    fetch('/api/experiment/rename-slave/' + deviceId, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ name: newName.trim() }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            var trimmed = newName.trim();
            // Update tab variable names
            ExpState.tabs.forEach(function(tab) {
                tab.variables.forEach(function(v) {
                    if (v.device_id === deviceId) v.device_name = trimmed;
                });
            });
            // Update source lists so variable modal also reflects the new name
            ExpState.allMeasurements.forEach(function(m) {
                if (m.device_id === deviceId) m.device_name = trimmed;
            });
            ExpState.allCalibrations.forEach(function(c) {
                if (c.device_id === deviceId) c.device_name = trimmed;
            });
            expRenderTabContent();
            expToast('Device renamed to "' + trimmed + '"', 'success');
        }
    })
    .catch(function() {});
}

// ===== Connect =====
function expConnect() {
    window.location.href = '/connect';
}

// ===== Checksum =====
function expChecksum() {
    expToast('Running checksum verification...', 'success');

    fetch('/api/experiment/checksum', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        var container = document.getElementById('expChecksumResults');
        if (!data.results || data.results.length === 0) {
            container.innerHTML = '<p style="color:#888;">No devices to verify</p>';
        } else {
            var html = '';
            data.results.forEach(function(r) {
                var icon = r.success && r.passed ? '✅' : '❌';
                html +=
                    '<div class="card" style="margin-bottom:0.5rem; padding:0.75rem;">' +
                    '<div style="display:flex; justify-content:space-between; align-items:center;">' +
                    '<strong>' + icon + ' ' + escapeHtml(r.device_name) + '</strong>' +
                    '<span style="color:' + (r.success && r.passed ? '#00ff88' : '#ff4444') + ';">' + (r.success && r.passed ? 'PASS' : 'FAIL') + '</span>' +
                    '</div>' +
                    (r.error ? '<div style="color:#ff4444; font-size:0.85rem; margin-top:0.25rem;">' + escapeHtml(r.error) + '</div>' : '') +
                    '</div>';
            });
            container.innerHTML = html;
        }
        document.getElementById('expChecksumModal').style.display = 'flex';
    })
    .catch(function(e) { expToast('Checksum failed: ' + e, 'error'); });
}

// ===== Toast Notifications =====
function expToast(msg, type) {
    var toast = document.querySelector('.exp-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.className = 'exp-toast';
        document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.className = 'exp-toast ' + (type || '');
    setTimeout(function() { toast.classList.add('show'); }, 10);
    setTimeout(function() { toast.classList.remove('show'); }, 3000);
}

// Global keyboard shortcuts for modals: Esc = close, Enter = save & close
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        expCloseVarModal();
        expCloseConfig();
        expCloseCalEdit();
        expCloseInfo();
        expCloseMatrix();
        document.getElementById('expChecksumModal').style.display = 'none';
    } else if (e.key === 'Enter' && !e.target.matches('input, textarea, select')) {
        var varModal = document.getElementById('expVarModal');
        var configModal = document.getElementById('expConfigModal');
        var calEditModal = document.getElementById('expCalEditModal');
        if (varModal && varModal.style.display !== 'none') {
            expApplyVarSelection();
        } else if (configModal && configModal.style.display !== 'none') {
            expSaveConfig();
        } else if (calEditModal && calEditModal.style.display !== 'none') {
            expSaveCalEdit();
        }
    }
});
</script>
