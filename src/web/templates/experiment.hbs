    border-bottom: 1px solid #444;
}
.exp-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
}
.exp-modal-footer {
    padding: 1rem;
    border-top: 1px solid #444;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}
.exp-modal-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
}

/* Variable selection modal (wide) */
#expVarModal .exp-modal-content { width: 80%; min-width: 600px; max-width: 1200px; }

/* Filter bar in variable modal */
.exp-filter-bar {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #333;
    flex-wrap: wrap;
}
.exp-filter-bar input, .exp-filter-bar select {
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
}
.exp-filter-bar input { flex: 1; min-width: 200px; }
.exp-filter-bar select { min-width: 120px; }

/* Toast notification */
.exp-toast {
    position: fixed;
    bottom: 40px;
