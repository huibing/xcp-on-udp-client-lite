}
.exp-status-bar .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.exp-status-bar .status-dot.connected { background: #00ff88; }
.exp-status-bar .status-dot.disconnected { background: #ff4444; }
.exp-status-bar .status-separator {
    width: 1px;
    height: 14px;
    background: #444;
}

/* Modals */
.exp-modal {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}
.exp-modal-content {
    background: #1e1e1e;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    max-height: 80vh;
