// ===== Checksum =====
function expChecksum() {
    expToast('Running checksum verification...', 'success');

    fetch('/api/experiment/checksum', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        var container = document.getElementById('expChecksumResults');
        if (!data.results || data.results.length === 0) {
            container.innerHTML = '<p style="color:#888;">No devices to verify</p>';
        } else {
            var html = '';
            data.results.forEach(function(r) {
                var icon = r.success && r.passed ? '✅' : '❌';
                html +=
                    '<div class="card" style="margin-bottom:0.75rem; padding:0.75rem;">' +
                    '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">' +
                    '<strong>' + icon + ' ' + escapeHtml(r.device_name) + '</strong>' +
                    '<span style="color:' + (r.success && r.passed ? '#00ff88' : '#ff4444') + '; font-weight:bold;">' +
                    (r.success && r.passed ? 'PASS' : 'FAIL') + '</span>' +
                    '</div>';
                if (r.error) {
                    html += '<div style="color:#ff4444; font-size:0.85rem;">' + escapeHtml(r.error) + '</div>';
                }
                if (r.segments && r.segments.length > 0) {
                    html += '<table style="width:100%; border-collapse:collapse; font-size:0.8rem; margin-top:0.25rem;">' +
                        '<tr style="border-bottom:1px solid #444; color:#888;">' +
                        '<th style="text-align:left; padding:0.25rem;">Segment</th>' +
                        '<th style="text-align:left; padding:0.25rem;">Address</th>' +
                        '<th style="text-align:right; padding:0.25rem;">Size</th>' +
                        '<th style="text-align:left; padding:0.25rem;">Algorithm</th>' +
                        '<th style="text-align:left; padding:0.25rem;">Master</th>' +
                        '<th style="text-align:left; padding:0.25rem;">Slave</th>' +
                        '<th style="text-align:center; padding:0.25rem;">Status</th></tr>';
                    r.segments.forEach(function(seg) {
                        var mc = seg.match ? '#00ff88' : '#ff4444';
                        html += '<tr style="border-bottom:1px solid #333;">' +
                            '<td style="padding:0.25rem; color:#ccc;">' + escapeHtml(seg.name) + '</td>' +
                            '<td style="padding:0.25rem; font-family:monospace; color:#888;">' + escapeHtml(seg.address) + '</td>' +
                            '<td style="padding:0.25rem; text-align:right; color:#888;">' + seg.size + '</td>' +
                            '<td style="padding:0.25rem; color:#888;">' + escapeHtml(seg.algorithm || '') + '</td>' +
                            '<td style="padding:0.25rem; font-family:monospace; color:#aaa;">' + escapeHtml(seg.master_checksum || '') + '</td>' +
                            '<td style="padding:0.25rem; font-family:monospace; color:#aaa;">' + escapeHtml(seg.slave_checksum || '') + '</td>' +
                            '<td style="padding:0.25rem; text-align:center; color:' + mc + ';">' + escapeHtml(seg.status || (seg.match ? 'PASS' : 'FAIL')) + '</td></tr>';
                        if (seg.chunks && seg.chunks.length > 0) {
                            seg.chunks.forEach(function(ch, ci) {
                                var cc = ch.match ? '#00ff88' : '#ff4444';
                                html += '<tr style="border-bottom:1px solid #2a2a3a;">' +
                                    '<td style="padding:0.2rem 0.25rem 0.2rem 1.5rem; color:#777; font-size:0.75rem;">chunk ' + ci + '</td>' +
                                    '<td style="padding:0.2rem 0.25rem; font-family:monospace; color:#666; font-size:0.75rem;">' + escapeHtml(ch.offset) + '</td>' +
                                    '<td style="padding:0.2rem 0.25rem; text-align:right; color:#666; font-size:0.75rem;">' + ch.size + '</td>' +
                                    '<td style="padding:0.2rem 0.25rem;"></td>' +
                                    '<td style="padding:0.2rem 0.25rem; font-family:monospace; color:#777; font-size:0.75rem;">' + escapeHtml(ch.master_checksum) + '</td>' +
                                    '<td style="padding:0.2rem 0.25rem; font-family:monospace; color:#777; font-size:0.75rem;">' + escapeHtml(ch.slave_checksum) + '</td>' +
                                    '<td style="padding:0.2rem 0.25rem; text-align:center; color:' + cc + '; font-size:0.75rem;">' + (ch.match ? '✓' : '✗') + '</td></tr>';
                            });
                        }
                    });
                    html += '</table>';
                }
                html += '</div>';
            });
            container.innerHTML = html;
        }
        document.getElementById('expChecksumModal').style.display = 'flex';
    })
    .catch(function(e) { expToast('Checksum failed: ' + e, 'error'); });
}

// ===== DCM Export =====
var expDcmChangedData = []; // cached list of all cal vars in experiment (with changed flag)

function expOpenDcmExport() {
    document.getElementById('expDcmVarList').innerHTML = '';
    document.getElementById('expDcmEmpty').style.display = 'none';
    document.getElementById('expDcmModal').style.display = 'flex';

    // Collect ALL calibration variables from all tabs (deduplicated by device_id:idx)
    var seen = {};
    var deviceMap = {};
    ExpState.tabs.forEach(function(tab) {
        if (!tab.variables) return;
        tab.variables.forEach(function(v) {
            if (v.kind !== 'calibration') return;
            var key = v.device_id + ':' + v.idx;
            if (seen[key]) return;
            seen[key] = true;

            if (!deviceMap[v.device_id]) {
                deviceMap[v.device_id] = {
                    device_id: v.device_id,
                    device_name: v.device_name || v.device_id,
                    variables: []
                };
            }
            var changed = ExpState.sessionChangedParams[key];
            deviceMap[v.device_id].variables.push({
                idx: v.idx,
                name: v.name,
                characteristic_type: v.calType || v.type || '',
                unit: v.unit || '',
                type_name: v.calType || v.type || '',
                original_value: changed ? (changed.original_value || '') : '',
                current_value: changed ? (changed.current_value || '') : '',
                is_changed: !!changed,
            });
        });
    });
    expDcmChangedData = Object.values(deviceMap);
    expRenderDcmVarList();
}

function expCloseDcmModal() {
    document.getElementById('expDcmModal').style.display = 'none';
}

function expRenderDcmVarList() {
    var list = document.getElementById('expDcmVarList');
    var total = 0;
    var html = '';

    expDcmChangedData.forEach(function(device) {
        if (!device.variables || device.variables.length === 0) return;
        html += '<div style="margin-bottom:0.75rem;">' +
            '<div style="font-size:0.75rem; color:#888; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.4rem; padding-bottom:0.2rem; border-bottom:1px solid #333;">' +
            escapeHtml(device.device_name) + '</div>';

        device.variables.forEach(function(v) {
            total++;
            var changedBadge = v.is_changed
                ? '<span style="color:#ffaa00; font-size:0.7rem; font-weight:600; margin-left:0.4rem;">● MODIFIED</span>'
                : '';
            var changeDetail = '';
            if (v.is_changed) {
                var isMatrixCurve = v.current_value === '' && v.original_value === '';
                changeDetail = isMatrixCurve
                    ? '<em style="color:#888;">[map/curve: elements edited]</em>'
                    : (v.current_value !== '' && v.original_value !== '')
                        ? escapeHtml(v.original_value) + ' → ' + escapeHtml(v.current_value)
                        : '';
            }
            html += '<label style="display:flex; align-items:flex-start; gap:0.6rem; padding:0.3rem 0.4rem; border-radius:3px; cursor:pointer; transition:background 0.15s;" ' +
                'onmouseover="this.style.background=\'#1a1a2e\'" onmouseout="this.style.background=\'\'">' +
                '<input type="checkbox" checked class="dcm-var-cb" ' +
                'data-device-id="' + escapeHtml(device.device_id) + '" ' +
                'data-idx="' + v.idx + '" ' +
                'onchange="expDcmUpdateCount()">' +
                '<div style="min-width:0; flex:1;">' +
                '<span style="color:#00ff88; font-size:0.85rem; font-family:monospace;">' + escapeHtml(v.name) + '</span>' +
                '<span style="color:#888; font-size:0.75rem; margin-left:0.5rem;">[' + escapeHtml(v.characteristic_type) + ']</span>' +
                changedBadge +
                (changeDetail ? '<div style="color:#aaa; font-size:0.75rem; margin-top:0.1rem;">' + changeDetail + '</div>' : '') +
                '</div></label>';
        });
        html += '</div>';
    });

    if (total === 0) {
        list.innerHTML = '';
        document.getElementById('expDcmEmpty').style.display = 'block';
        document.getElementById('dcmSelectAll').checked = false;
        document.getElementById('dcmSelectedCount').textContent = '';
        return;
    }

    list.innerHTML = html;
    document.getElementById('dcmSelectAll').checked = true;
    document.getElementById('dcmSelectedCount').textContent = total + ' variable' + (total !== 1 ? 's' : '') + ' selected';
}

function expDcmSelectAll(checked) {
    document.querySelectorAll('.dcm-var-cb').forEach(function(cb) { cb.checked = checked; });
    expDcmUpdateCount();
}

function expDcmUpdateCount() {
    var total = document.querySelectorAll('.dcm-var-cb').length;
    var selected = document.querySelectorAll('.dcm-var-cb:checked').length;
    document.getElementById('dcmSelectedCount').textContent = selected + '/' + total + ' selected';
    document.getElementById('dcmSelectAll').checked = selected === total;
    document.getElementById('dcmSelectAll').indeterminate = selected > 0 && selected < total;
}

function expDoDcmExport() {
    var selected = [];
    document.querySelectorAll('.dcm-var-cb:checked').forEach(function(cb) {
        selected.push({ device_id: cb.dataset.deviceId, idx: parseInt(cb.dataset.idx, 10) });
    });
    if (selected.length === 0) {
        expToast('No variables selected', 'error');
        return;
    }

    var title = (document.getElementById('expTitle').value || 'experiment').trim();
    document.getElementById('btnDcmExport').disabled = true;
    document.getElementById('btnDcmExport').textContent = 'Generating...';

    fetch('/api/experiment/dcm/export', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ title: title, variables: selected }),
    })
    .then(function(r) {
        if (!r.ok) return r.json().then(function(d) { throw new Error(d.error || 'Export failed'); });
        // Extract filename from Content-Disposition header
        var cd = r.headers.get('Content-Disposition') || '';
        var match = cd.match(/filename="?([^";]+)"?/);
        var filename = match ? match[1] : title + '.dcm';
        return r.blob().then(function(blob) { return { blob: blob, filename: filename }; });
    })
    .then(function(result) {
        var url = URL.createObjectURL(result.blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = result.filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        expCloseDcmModal();
        expToast('DCM exported: ' + result.filename, 'success');
    })
    .catch(function(e) { expToast('Export failed: ' + e, 'error'); })
    .finally(function() {
        document.getElementById('btnDcmExport').disabled = false;
        document.getElementById('btnDcmExport').textContent = 'Export DCM';
    });
}
// ===== Event Change Modal =====
var expEventModalTarget = null; // { deviceId, configDeviceId, idx }

function expOpenEventModal(deviceId, configDeviceId, idx, currentChannel) {
    if (ExpState.mode !== 'idle') {
        expToast('Cannot change event while DAQ is running', 'error');
        return;
    }
    expEventModalTarget = { deviceId: deviceId, configDeviceId: configDeviceId, idx: idx };

    // Find variable name for description
    var varName = '';
    for (var i = 0; i < ExpState.tabs.length; i++) {
        var v = (ExpState.tabs[i].variables || []).find(function(v) {
            return v.kind === 'measurement' && v.device_id === deviceId && v.idx === idx;
        });
        if (v) { varName = v.name; break; }
    }
    document.getElementById('expEventModalDesc').textContent = varName
        ? 'Variable: ' + varName
        : 'Measurement index: ' + idx;

    var evts = expGetEventsForDevice(configDeviceId);
    var sel = document.getElementById('expEventModalSelect');
    sel.innerHTML = evts.map(function(e) {
        var label = e.name + (e.cycle_time_ms > 0 ? ' (' + e.cycle_time_ms.toFixed(1) + 'ms)' : '');
        var selected = e.channel === currentChannel ? ' selected' : '';
        return '<option value="' + e.channel + '"' + selected + '>' + escapeHtml(label) + '</option>';
    }).join('');
    if (evts.length === 0) {
        sel.innerHTML = '<option>No events available</option>';
    }
    document.getElementById('expEventModal').style.display = 'flex';
}

function expCloseEventModal() {
    document.getElementById('expEventModal').style.display = 'none';
    expEventModalTarget = null;
}

function expApplyEventChange() {
    if (!expEventModalTarget) return;
    var deviceId = expEventModalTarget.deviceId;
    var configDeviceId = expEventModalTarget.configDeviceId;
    var idx = expEventModalTarget.idx;
    var channel = parseInt(document.getElementById('expEventModalSelect').value, 10);

    if (isNaN(channel)) { expCloseEventModal(); return; }

    // Update all tabs in memory
    var updated = false;
    ExpState.tabs.forEach(function(tab) {
        (tab.variables || []).forEach(function(v) {
            if (v.kind === 'measurement' && v.device_id === deviceId && v.idx === idx) {
                v.event_channel = channel;
                updated = true;
            }
        });
    });

    if (updated) {
        // Persist to backend
        fetch('/api/experiment/set-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ device_id: deviceId, measurement_idx: idx, event_channel: channel }),
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.success) {
                expToast('Set event failed: ' + (data.error || ''), 'error');
            } else {
                expToast('Event updated to ' + expGetEventName(configDeviceId, channel), 'success');
            }
        })
        .catch(function(e) { expToast('Set event failed: ' + e, 'error'); });

        expSaveStateToStorage();
        expRenderTabContent();
    }
    expCloseEventModal();
}

// ===== Signal Graph =====

function expGraphKey(deviceId, name) { return deviceId + ':' + name; }

function expIsGraphed(deviceId, name) {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    return tab && (tab.graphedKeys || []).indexOf(expGraphKey(deviceId, name)) >= 0;
}

function expToggleGraph(deviceId, name) {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (!tab) return;
    if (!tab.graphedKeys) tab.graphedKeys = [];
    var key = expGraphKey(deviceId, name);
    var idx = tab.graphedKeys.indexOf(key);
    if (idx >= 0) tab.graphedKeys.splice(idx, 1);
    else tab.graphedKeys.push(key);
    expSaveStateToStorage();
    expRenderTabContent();
    expUpdateGraphPanel();
}

function expCloseGraph() {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (tab) { tab.graphedKeys = []; }
    expSaveStateToStorage();
    expRenderTabContent();
    expUpdateGraphPanel();
}

function expGraphOnWindowChange(val) {
    expGraphWindowIdx = parseInt(val, 10);
    var secs = EXP_GRAPH_WINDOWS[expGraphWindowIdx] || 30;
    var label = secs >= 60 ? (secs / 60) + ' min' : secs + ' s';
    document.getElementById('expGraphWinLabel').textContent = label;
    expDrawGraph();
}

function expStartGraphInterval() {
    expStopGraphInterval();
    expGraphInterval = setInterval(expDrawGraph, 200);
}

function expStopGraphInterval() {
    if (expGraphInterval) { clearInterval(expGraphInterval); expGraphInterval = null; }
}

function expUpdateGraphPanel() {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    var keys = (tab && tab.graphedKeys) || [];
    var panel = document.getElementById('expGraphPanel');
    if (!panel) return;
    if (keys.length === 0) {
        panel.style.display = 'none';
        return;
    }
    panel.style.display = 'flex';
    var badge = document.getElementById('expGraphLiveBadge');
    if (badge) badge.style.display = ExpState.mode !== 'idle' ? 'inline' : 'none';
    var legend = document.getElementById('expGraphLegend');
    if (legend) {
        legend.innerHTML = keys.map(function(key, i) {
            var parts = key.split(':');
            var name = parts.slice(1).join(':');
            var color = EXP_GRAPH_COLORS[i % EXP_GRAPH_COLORS.length];
            return '<span class="exp-graph-legend-item">' +
                '<span class="exp-graph-legend-line" style="background:' + color + '"></span>' +
                '<span>' + escapeHtml(name) + '</span>' +
                '</span>';
        }).join('');
    }
    expDrawGraph();
}

function expDrawGraph() {
    var canvas = document.getElementById('expGraphCanvas');
    if (!canvas) return;
    var wrap = canvas.parentElement;
    if (!wrap) return;
    var W = wrap.clientWidth - 16;
    var H = wrap.clientHeight - 10;
    if (W <= 0 || H <= 0) return;
    canvas.width = W;
    canvas.height = H;
    var ctx = canvas.getContext('2d');

    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    var keys = (tab && tab.graphedKeys) || [];

    ctx.fillStyle = '#0d0d1a';
    ctx.fillRect(0, 0, W, H);

    if (keys.length === 0) return;

    var winSecs = EXP_GRAPH_WINDOWS[expGraphWindowIdx] || 30;
    var nowSecs = expGraphStartTime ? (Date.now() - expGraphStartTime) / 1000 : 0;
    var xMax = Math.max(winSecs, nowSecs);
    var xMin = xMax - winSecs;

    var mx = 52, mr = 10, mt = 8, mb = 28;
    var plotW = W - mx - mr;
    var plotH = H - mt - mb;
    if (plotW <= 0 || plotH <= 0) return;

    var yMin = Infinity, yMax = -Infinity;
    keys.forEach(function(key) {
        var h = expSignalHistory[key];
        if (!h || !h.times.length) return;
        for (var i = 0; i < h.times.length; i++) {
            if (h.times[i] < xMin - 1 || h.times[i] > xMax + 1) continue;
            if (h.values[i] < yMin) yMin = h.values[i];
            if (h.values[i] > yMax) yMax = h.values[i];
        }
    });
    if (!isFinite(yMin) || !isFinite(yMax)) { yMin = -1; yMax = 1; }
    if (Math.abs(yMax - yMin) < 1e-9) { yMin -= 1; yMax += 1; }
    var yRange = yMax - yMin;
    var yPad = yRange * 0.1;
    yMin -= yPad; yMax += yPad; yRange = yMax - yMin;

    ctx.strokeStyle = 'rgba(0,200,100,0.1)';
    ctx.lineWidth = 1;
    var yTicks = 5, xTicks = 6;
    for (var i = 0; i <= yTicks; i++) {
        var gy = mt + (i / yTicks) * plotH;
        ctx.beginPath(); ctx.moveTo(mx, gy); ctx.lineTo(mx + plotW, gy); ctx.stroke();
    }

    keys.forEach(function(key, ki) {
        var h = expSignalHistory[key];
        if (!h || !h.times.length) return;
        ctx.strokeStyle = EXP_GRAPH_COLORS[ki % EXP_GRAPH_COLORS.length];
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        var first = true;
        for (var i = 0; i < h.times.length; i++) {
            var t = h.times[i];
            if (t < xMin - 1 || t > xMax + 1) continue;
            var px = mx + ((t - xMin) / winSecs) * plotW;
            var py = mt + plotH - ((h.values[i] - yMin) / yRange) * plotH;
            if (first) { ctx.moveTo(px, py); first = false; }
            else ctx.lineTo(px, py);
        }
        ctx.stroke();
    });

    ctx.fillStyle = '#00aa33';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (var i = 0; i <= xTicks; i++) {
        var t = xMin + (i / xTicks) * winSecs;
        var px = mx + (i / xTicks) * plotW;
        ctx.fillText(t.toFixed(1) + 's', px, mt + plotH + 4);
    }

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (var i = 0; i <= yTicks; i++) {
        var v = yMin + (i / yTicks) * yRange;
        var py = mt + plotH - (i / yTicks) * plotH;
        var vStr = Math.abs(v) >= 1000 ? v.toExponential(1) : (Math.abs(v) < 0.001 && v !== 0 ? v.toExponential(1) : v.toPrecision(4));
        ctx.fillText(vStr, mx - 3, py);
    }

    ctx.strokeStyle = 'rgba(0,200,100,0.3)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(mx, mt);
    ctx.lineTo(mx, mt + plotH);
    ctx.stroke();
}

function expToast(msg, type) {
    var toast = document.querySelector('.exp-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.className = 'exp-toast';
        document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.className = 'exp-toast ' + (type || '');
    setTimeout(function() { toast.classList.add('show'); }, 10);
    setTimeout(function() { toast.classList.remove('show'); }, 3000);
}

// Global keyboard shortcuts for modals: Esc = close, Enter = save & close
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        expCloseVarModal();
        expCloseConfig();
        expCloseCalEdit();
        expCloseInfo();
        expCloseMatrix();
        expCancelDeviceMap();
        expCloseEventModal();
        document.getElementById('expChecksumModal').style.display = 'none';
    } else if (e.key === 'Enter' && !e.target.matches('input, textarea, select')) {
        var varModal = document.getElementById('expVarModal');
        var configModal = document.getElementById('expConfigModal');
        var calEditModal = document.getElementById('expCalEditModal');
        if (varModal && varModal.style.display !== 'none') {
            expApplyVarSelection();
        } else if (configModal && configModal.style.display !== 'none') {
            expSaveConfig();
        } else if (calEditModal && calEditModal.style.display !== 'none') {
            expSaveCalEdit();
        }
    }
});
</script>
