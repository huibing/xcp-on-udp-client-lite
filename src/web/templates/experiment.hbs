<script>
// ===== Utility =====
function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ===== Experiment Page State =====
const EXP_MAX_TABS = 20;

const ExpState = {
    mode: 'idle',          // 'idle' | 'running' | 'recording'
    pageMode: 'reference', // 'reference' | 'working'
    tabs: [],
    activeTabId: null,
    allMeasurements: [],
    allCalibrations: [],
    liveValues: {},        // "device_id:name" -> value (raw float)
    calValues: {},         // "device_id:idx" -> display value string (enum text or number)
    calOriginalValues: {}, // "device_id:idx" -> original display value string
    calOriginalMatrix: {}, // "device_id:idx:row:col" -> original cell value string
    sessionChangedParams: {}, // "device_id:idx" -> {device_id, idx, name, calType, device_name, unit, description, original_value, current_value}
    pageModeResults: {},   // device_id -> {success, read_only}
    calEnumOptions: {},    // "device_id:idx" -> [{raw, text}, ...]
    measEnumOptions: {},   // "device_id:name" -> [{raw, text}, ...]
    availableEventsByDevice: {}, // config_device_id -> [{channel, name, short_name, cycle_time_ms}]
    config: {
        mf4Pattern: '{title}_{YYYYMMDD}_{HHMMSS}.mf4',
        mf4Dir: 'records/',
    },
    pollingInterval: null,
    statusInterval: null,
};

// ===== Tab Management =====
let tabCounter = 0;

// ===== Event Selections (for variable selection modal) =====
// Maps "device_id:idx" -> event channel (u16)
var expEventSelections = {};

// ===== Signal Graph State =====
var EXP_GRAPH_WINDOWS = [5, 10, 20, 30, 60, 120, 300];
var EXP_GRAPH_COLORS = ['#00ff88','#4488ff','#ff8844','#ff44ff','#ffff44','#44ffff','#88ff44','#ff4488'];
var EXP_MAX_HIST = 6000;
var expSignalHistory = {};    // "device_id:name" -> {times:[], values:[]}
var expGraphStartTime = null; // Date.now() when current DAQ session started
var expGraphInterval = null;  // canvas redraw interval handle
var expGraphWindowIdx = 3;    // index into EXP_GRAPH_WINDOWS (default 30s)

// ===== LocalStorage Persistence =====
const EXP_STORAGE_KEY = 'experiment_state';

function expSaveStateToStorage() {
    try {
        var data = {
            tabs: ExpState.tabs,
            activeTabId: ExpState.activeTabId,
            tabCounter: tabCounter,
            config: ExpState.config,
        };
        localStorage.setItem(EXP_STORAGE_KEY, JSON.stringify(data));
    } catch (e) { /* ignore quota errors */ }
}

function expLoadStateFromStorage() {
    try {
        var raw = localStorage.getItem(EXP_STORAGE_KEY);
        if (!raw) return false;
        var data = JSON.parse(raw);
        if (!data.tabs || !data.tabs.length) return false;
        ExpState.tabs = data.tabs;
        ExpState.tabs.forEach(function(tab) {
            tab.graphedKeys = tab.graphedKeys || [];
        });
        ExpState.activeTabId = data.activeTabId || data.tabs[0].id;
        tabCounter = data.tabCounter || data.tabs.length;
        if (data.config) {
            ExpState.config = Object.assign(ExpState.config, data.config);
        }
        return true;
    } catch (e) { return false; }
}

// ===== Initialization =====
(function init() {
    var restored = expLoadStateFromStorage();
    if (!restored) {
        expAddTab();
    } else {
        expRenderTabs();
        expRenderTabContent();
        expUpdateGraphPanel();
        expReadAllCalValues();
    }
    expStartStatusPolling();
    expRefreshVariables();
    expLoadEvents();

    // Intercept nav links: prevent leaving when DAQ is running/recording
    document.querySelectorAll('.nav a').forEach(function(link) {
        var href = link.getAttribute('href');
        if (href === '/experiment') return; // allow staying on experiment page
        link.addEventListener('click', function(e) {
            if (ExpState.mode !== 'idle') {
                e.preventDefault();
                expToast('Please stop DAQ before leaving the Experiment page', 'error');
            }
        });
    });
})();

function expAddTab() {
    if (ExpState.tabs.length >= EXP_MAX_TABS) {
        expToast('Maximum ' + EXP_MAX_TABS + ' tabs reached', 'error');
        return;
    }
    tabCounter++;
    const tab = { id: 'tab-' + tabCounter, title: 'Tab ' + tabCounter, variables: [], graphedKeys: [] };
    ExpState.tabs.push(tab);
    ExpState.activeTabId = tab.id;
    expRenderTabs();
    expRenderTabContent();
    expUpdateGraphPanel();
}

function expCloseTab(tabId, ev) {
    if (ev) ev.stopPropagation();
    if (ExpState.tabs.length <= 1) {
        expToast('Cannot close the last tab', 'error');
        return;
    }
    const idx = ExpState.tabs.findIndex(t => t.id === tabId);
    ExpState.tabs.splice(idx, 1);
    if (ExpState.activeTabId === tabId) {
        ExpState.activeTabId = ExpState.tabs[Math.min(idx, ExpState.tabs.length - 1)].id;
    }
    expRenderTabs();
    expRenderTabContent();
    expUpdateGraphPanel();
}

function expSelectTab(tabId) {
    ExpState.activeTabId = tabId;
    expRenderTabs();
    expRenderTabContent();
    expUpdateGraphPanel();
}

function expRenameTab(tabId, ev) {
    if (ev) ev.stopPropagation();
    const tabEl = document.querySelector('.exp-tab[data-id="' + tabId + '"] .tab-title');
    if (!tabEl) return;
    const input = document.getElementById('expTabRenameInput');
    const rect = tabEl.getBoundingClientRect();
    input.style.display = 'block';
    input.style.left = rect.left + 'px';
    input.style.top = rect.top + 'px';
    input.style.width = rect.width + 'px';
    const tab = ExpState.tabs.find(t => t.id === tabId);
    input.value = tab.title;
    input.focus();
    input.select();
    input.onblur = function() {
        tab.title = input.value.trim() || tab.title;
        input.style.display = 'none';
        expRenderTabs();
    };
    input.onkeydown = function(e) {
        if (e.key === 'Enter') input.blur();
        if (e.key === 'Escape') { input.value = tab.title; input.blur(); }
    };
}

function expRenderTabs() {
    const bar = document.getElementById('expTabBar');
    bar.querySelectorAll('.exp-tab').forEach(function(el) { el.remove(); });
    ExpState.tabs.forEach(function(tab) {
        const el = document.createElement('div');
        el.className = 'exp-tab' + (tab.id === ExpState.activeTabId ? ' active' : '');
        el.dataset.id = tab.id;
        el.onclick = function() { expSelectTab(tab.id); };
        el.ondblclick = function(ev) { expRenameTab(tab.id, ev); };
        el.innerHTML =
            '<span class="tab-title">' + escapeHtml(tab.title) + '</span>' +
            '<span class="tab-close" onclick="expCloseTab(\'' + tab.id + '\', event)" title="Close tab">&times;</span>';
        bar.appendChild(el);
    });
    expSaveStateToStorage();
}

// ===== Tab Content Rendering =====
function expRenderTabContent() {
    var container = document.getElementById('expTabContent');
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (!tab) {
        container.innerHTML = '<div class="exp-empty-tab"><div class="icon">📋</div><p>No tabs open</p></div>';
        return;
    }

    if (tab.variables.length === 0) {
        container.innerHTML =
            '<div class="exp-empty-tab">' +
            '<div class="icon">📋</div>' +
            '<p>No variables in this tab</p>' +
            '<p style="font-size:0.85rem;">Click "Variables" in the toolbar to add measurements and calibration parameters</p>' +
            '<button class="exp-tb-btn" onclick="expOpenVarModal()">📋 Add Variables</button>' +
            '</div>';
        return;
    }

    var measurements = tab.variables.filter(function(v) { return v.kind === 'measurement'; });
    var scalarCals = tab.variables.filter(function(v) { return v.kind === 'calibration' && !v.isMapCurve; });
    var mapCurveCals = tab.variables.filter(function(v) { return v.kind === 'calibration' && v.isMapCurve; });

    var html = '';

    // Measurement cards
    if (measurements.length > 0) {
        html += '<div class="exp-cards-section"><h3>📊 Measurements (' + measurements.length + ')</h3><div class="exp-cards-grid">';
        measurements.forEach(function(v) {
            var key = v.device_id + ':' + v.name;
            var val = ExpState.liveValues[key];
            var displayVal = val !== undefined ? expMeasDisplayVal(key, val) : '—';
            var configDevId = v.config_device_id || '';
            var evtCh = v.event_channel !== undefined ? v.event_channel : expGetFirstEventChannel(configDevId);
            var evtName = expGetEventName(configDevId, evtCh);
            var evtBadge = '<div class="exp-evt-badge" title="Event: ' + escapeHtml(evtName) + '">⏱ ' + escapeHtml(evtName) + '</div>';
            var evtBtn = ExpState.mode === 'idle'
                ? '<span class="card-evt-btn" onclick="event.stopPropagation(); expOpenEventModal(\'' + v.device_id + '\', \'' + escapeHtml(configDevId) + '\', ' + v.idx + ', ' + evtCh + ')" title="Change event">⏱</span>'
                : '';
            var isGraphed = (tab.graphedKeys || []).indexOf(key) >= 0;
            html +=
                '<div class="exp-var-card measurement' + (isGraphed ? ' graphed-card' : '') + '" title="' + escapeHtml(v.device_name + ' / ' + v.name) + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-value"><span data-live-key="' + escapeHtml(key) + '">' + displayVal + '</span><span class="card-unit">' + escapeHtml(v.unit || '') + '</span></div>' +
                evtBadge +
                '<span class="card-info-btn" onclick="event.stopPropagation(); expShowInfo(\'measurement\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')" title="Variable info">ℹ️</span>' +
                '<span class="card-graph-btn' + (isGraphed ? ' graphed' : '') + '" onclick="event.stopPropagation(); expToggleGraph(\'' + v.device_id + '\', \'' + escapeHtml(v.name) + '\')" title="Toggle graph">📈</span>' +
                evtBtn +
                (ExpState.mode === 'idle' ? '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' : '') +
                '</div>';
        });
        html += '</div></div>';
    }

    // Scalar calibration cards
    if (scalarCals.length > 0) {
        var isWorking = ExpState.pageMode === 'working';
        html += '<div class="exp-cards-section"><h3>🔧 Calibration (' + scalarCals.length + ')</h3><div class="exp-cards-grid">';
        scalarCals.forEach(function(v) {
            var calKey = v.device_id + ':' + v.idx;
            var val = ExpState.calValues[calKey];
            var displayVal = val !== undefined ? val : '—';
            var deviceResult = ExpState.pageModeResults[v.device_id];
            var readOnly = !isWorking || (deviceResult && deviceResult.read_only);
            var editableClass = isWorking && !readOnly ? 'editable' : 'readonly';
            var clickHandler = isWorking && !readOnly ? 'onclick="expEditCal(\'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')"' : '';
            var markClass = expGetChangeMark(calKey);
            var markHtml = markClass ? '<span class="change-mark ' + markClass + '" data-mark-key="' + escapeHtml(calKey) + '"></span>' : '<span class="change-mark" data-mark-key="' + escapeHtml(calKey) + '"></span>';
            html +=
                '<div class="exp-var-card calibration ' + editableClass + '" ' + clickHandler + ' title="' + escapeHtml(v.device_name + ' / ' + v.name) + (readOnly ? ' (read-only)' : '') + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-value"><span data-cal-key="' + escapeHtml(calKey) + '">' + escapeHtml(String(displayVal)) + '</span>' + markHtml + '<span class="card-unit">' + escapeHtml(v.unit || '') + '</span></div>' +
                '<span class="card-info-btn" onclick="event.stopPropagation(); expShowInfo(\'cal\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')" title="Variable info">ℹ️</span>' +
                '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' +
                '</div>';
        });
        html += '</div></div>';
    }

    // Map/Curve calibration cards (no value, info + table buttons)
    if (mapCurveCals.length > 0) {
        html += '<div class="exp-cards-section"><h3>📐 Maps & Curves (' + mapCurveCals.length + ')</h3><div class="exp-cards-grid">';
        mapCurveCals.forEach(function(v) {
            html +=
                '<div class="exp-var-card calibration map-curve" title="' + escapeHtml(v.device_name + ' / ' + v.name) + '">' +
                '<div class="card-device">' + escapeHtml(v.device_name) + '</div>' +
                '<div class="card-name">' + escapeHtml(v.name) + '</div>' +
                '<div class="card-type" style="color:#888; font-size:0.75rem; margin-top:0.15rem;">' + escapeHtml(v.calType || '') + '</div>' +
                '<div class="card-map-actions" style="display:flex; gap:0.5rem; margin-top:0.5rem;">' +
                '<button class="exp-tb-btn" style="font-size:0.75rem; padding:0.25rem 0.5rem;" onclick="event.stopPropagation(); expShowInfo(\'cal\', \'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')">ℹ️ Info</button>' +
                '<button class="exp-tb-btn" style="font-size:0.75rem; padding:0.25rem 0.5rem;" onclick="event.stopPropagation(); expShowMatrix(\'' + v.device_id + '\', ' + v.idx + ', \'' + escapeHtml(v.name) + '\')">📊 Table</button>' +
                '</div>' +
                '<span class="card-remove" onclick="event.stopPropagation(); expRemoveVar(\'' + tab.id + '\', \'' + v.device_id + '\', ' + v.idx + ', \'' + v.kind + '\')" title="Remove">✕</span>' +
                '</div>';
        });
        html += '</div></div>';
    }

    container.innerHTML = html;
}

function formatValue(val) {
    if (typeof val === 'number') {
        return Number.isInteger(val) ? val.toString() : val.toFixed(4);
    }
    return String(val);
}

// Lookup enum text from options array by raw numeric value.
// Returns the text label, or null if not found.
function expEnumLookup(opts, rawVal) {
    if (!opts || opts.length === 0) return null;
    var raw = Math.round(parseFloat(String(rawVal)));
    if (isNaN(raw)) return null;
    for (var i = 0; i < opts.length; i++) {
        if (opts[i].raw === raw) return opts[i].text;
    }
    return null;
}

// Display a live measurement value, converting to enum text when applicable.
function expMeasDisplayVal(measKey, rawVal) {
    var text = expEnumLookup(ExpState.measEnumOptions[measKey], rawVal);
    return text !== null ? text : formatValue(rawVal);
}

// ===== Calibration Change Marks =====

// Find a calibration variable in any tab by device_id + idx.
function expFindVarInTabs(deviceId, idx) {
    for (var i = 0; i < ExpState.tabs.length; i++) {
        var tab = ExpState.tabs[i];
        for (var j = 0; j < (tab.variables || []).length; j++) {
            var v = tab.variables[j];
            if (v.kind === 'calibration' && v.device_id === deviceId && String(v.idx) === String(idx)) {
                return v;
            }
        }
    }
    return null;
}

// Returns the CSS extra class for the change-mark span, or '' for no mark.
function expGetChangeMark(calKey) {
    var orig = ExpState.calOriginalValues[calKey];
    var cur = ExpState.calValues[calKey];
    if (orig === undefined || orig === '' || cur === undefined) return '';
    var origNum = parseFloat(orig);
    var curNum = parseFloat(cur);
    if (isNaN(origNum) || isNaN(curNum)) {
        // Non-numeric (enum/bool): any difference = mark-up
        return String(cur) !== String(orig) ? 'change-mark-up' : '';
    }
    if (curNum > origNum) return 'change-mark-up';
    if (curNum < origNum) return 'change-mark-down';
    return '';
}

// Update the change-mark span in-place for a scalar cal card.
function expUpdateChangeMark(calKey) {
    var markClass = expGetChangeMark(calKey);
    document.querySelectorAll('[data-mark-key="' + calKey + '"]').forEach(function(el) {
        el.className = 'change-mark' + (markClass ? ' ' + markClass : '');
    });
}

// Fetch original (reference) values from the backend for all scalar cal variables
// that don't yet have an original stored. Only fetches once per key per session.
function expFetchOriginalValues() {
    var calVars = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'calibration' && !v.isMapCurve; }).forEach(function(v) {
            var key = v.device_id + ':' + v.idx;
            if (ExpState.calOriginalValues[key] === undefined) {
                calVars[key] = true;
            }
        });
    });
    Object.keys(calVars).forEach(function(key) {
        var parts = key.split(':');
        var deviceId = parts[0];
        var idx = parts[1];
        fetch('/api/experiment/cal/original/' + deviceId + '/' + idx)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success && data.value !== undefined) {
                    // Convert to enum text if applicable (backend returns raw number string)
                    var text = expEnumLookup(ExpState.calEnumOptions[key], data.value);
                    ExpState.calOriginalValues[key] = text !== null ? text : data.value;
                    expUpdateChangeMark(key);
                }
            })
            .catch(function() {});
    });
}

// Refresh all calibration values (re-read from ECU) and update marks.
function expRefreshCalValues() {
    expReadAllCalValues();
    expToast('Calibration values refreshed', 'success');
}

// ===== Variable Removal =====
function expRemoveVar(tabId, deviceId, idx, kind) {
    if (ExpState.mode !== 'idle' && kind === 'measurement') return;
    var tab = ExpState.tabs.find(function(t) { return t.id === tabId; });
    if (!tab) return;
    var removed = tab.variables.find(function(v) {
        return v.device_id === deviceId && v.idx === idx && v.kind === kind;
    });
    tab.variables = tab.variables.filter(function(v) {
        return !(v.device_id === deviceId && v.idx === idx && v.kind === kind);
    });
    if (removed && removed.kind === 'measurement') {
        tab.graphedKeys = (tab.graphedKeys || []).filter(function(key) {
            return key !== expGraphKey(removed.device_id, removed.name);
        });
    }
    expRenderTabContent();
    expUpdateGraphPanel();
    expSaveStateToStorage();
}

// ===== Variable Selection Modal =====
var expVarModalSelection = {};  // "kind:device_id:idx" -> true
var expFilteredItems = [];
var expDisplayedCount = 0;
var expIsLoadingMore = false;
var EXP_VAR_BATCH_SIZE = 500;

function expOpenVarModal() {
    document.getElementById('expVarModal').style.display = 'flex';
    expVarModalSelection = {};
    expEventSelections = {};
    expFilteredItems = [];
    expDisplayedCount = 0;
    expIsLoadingMore = false;
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (tab) {
        tab.variables.forEach(function(v) {
            expVarModalSelection[v.kind + ':' + v.device_id + ':' + v.idx] = true;
            if (v.kind === 'measurement' && v.event_channel !== undefined) {
                expEventSelections[v.device_id + ':' + v.idx] = v.event_channel;
            }
        });
    }
    expPopulateVarModal();
    expSetupVarScrollListener();
}

function expCloseVarModal() {
    document.getElementById('expVarModal').style.display = 'none';
}

function expRefreshVariables() {
    fetch('/api/experiment/variables')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                ExpState.allMeasurements = data.measurements || [];
                ExpState.allCalibrations = data.calibrations || [];
                // Merge enum options lookup tables (don't reset — expReadAllCalValues may have already populated some)
                (data.calibrations || []).forEach(function(c) {
                    if (c.is_enum && c.enum_options && c.enum_options.length > 0) {
                        ExpState.calEnumOptions[c.device_id + ':' + c.idx] = c.enum_options;
                    }
                });
                (data.measurements || []).forEach(function(m) {
                    if (m.is_enum && m.enum_options && m.enum_options.length > 0) {
                        ExpState.measEnumOptions[m.device_id + ':' + m.name] = m.enum_options;
                    }
                });
                expPopulateVarFilterDevices();
            }
        })
        .catch(function(e) { console.error('Failed to load variables:', e); });
}

function expLoadEvents() {
    fetch('/api/experiment/events')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.devices) {
                data.devices.forEach(function(d) {
                    var key = d.config_device_id || d.device_id;
                    ExpState.availableEventsByDevice[key] = d.events || [];
                });
            }
        })
        .catch(function(e) { console.error('Failed to load events:', e); });
}

function expGetEventsForDevice(configDeviceId) {
    return ExpState.availableEventsByDevice[configDeviceId] || [];
}

function expGetFirstEventChannel(configDeviceId) {
    var evts = expGetEventsForDevice(configDeviceId);
    return evts.length > 0 ? evts[0].channel : 0;
}

function expGetEventName(configDeviceId, channel) {
    var evts = expGetEventsForDevice(configDeviceId);
    var evt = evts.find(function(e) { return e.channel === channel; });
    if (!evt) return channel !== undefined ? 'Ch' + channel : '—';
    if (evt.cycle_time_ms > 0) {
        return evt.name + ' (' + evt.cycle_time_ms.toFixed(1) + 'ms)';
    }
    return evt.name;
}

function expPopulateVarFilterDevices() {
    var sel = document.getElementById('expVarFilterDevice');
    var devices = {};
    ExpState.allMeasurements.forEach(function(v) { devices[v.device_id] = v.device_name; });
    ExpState.allCalibrations.forEach(function(v) { devices[v.device_id] = v.device_name; });
    sel.innerHTML = '<option value="">All Devices</option>';
    Object.keys(devices).forEach(function(id) {
        sel.innerHTML += '<option value="' + escapeHtml(id) + '">' + escapeHtml(devices[id]) + '</option>';
    });
}

function expPopulateVarModal() {
    var tbody = document.getElementById('expVarList');
    var search = document.getElementById('expVarSearch').value.toLowerCase();
    var deviceFilter = document.getElementById('expVarFilterDevice').value;
    var typeFilter = document.getElementById('expVarFilterType').value;

    var items = [];

    if (typeFilter !== 'calibration') {
        ExpState.allMeasurements.forEach(function(m) {
            items.push({
                kind: 'measurement', device_id: m.device_id, config_device_id: m.config_device_id || '',
                device_name: m.device_name,
                idx: m.idx, name: m.name, type: m.type || '', address: m.address_hex || '',
                unit: m.unit || '', connected: m.connected,
            });
        });
    }

    if (typeFilter !== 'measurement') {
        ExpState.allCalibrations.forEach(function(c) {
            var tn = c.type_name || c.type || '';
            var ct = (c.characteristic_type || '').toUpperCase();
            items.push({
                kind: 'calibration', device_id: c.device_id, device_name: c.device_name,
                idx: c.idx, name: c.name, type: tn,
                address: c.address_hex || (c.address ? ('0x' + Number(c.address).toString(16).toUpperCase().padStart(8, '0')) : ''),
                unit: c.unit || '', connected: c.connected, calType: c.characteristic_type || tn,
                isMapCurve: ct === 'MAP' || ct === 'CURVE' || ct === 'VAL_BLK' || tn.indexOf('Matrix') >= 0 || tn.indexOf('Array') >= 0,
            });
        });
    }

    if (search) {
        items = items.filter(function(v) { return v.name.toLowerCase().indexOf(search) >= 0 || v.device_name.toLowerCase().indexOf(search) >= 0; });
    }
    if (deviceFilter) {
        items = items.filter(function(v) { return v.device_id === deviceFilter; });
    }

    expFilteredItems = items;
    expDisplayedCount = 0;
    tbody.innerHTML = '';

    var firstBatch = expFilteredItems.slice(0, EXP_VAR_BATCH_SIZE);
    tbody.innerHTML = expRenderVarRows(firstBatch);
    expDisplayedCount = firstBatch.length;

    var indicator = document.getElementById('expLoadingIndicator');
    indicator.style.display = expDisplayedCount < expFilteredItems.length ? 'block' : 'none';

    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expRenderVarRows(items) {
    var html = '';
    var daqActive = ExpState.mode !== 'idle';
    items.forEach(function(v) {
        var key = v.kind + ':' + v.device_id + ':' + v.idx;
        var selKey = v.device_id + ':' + v.idx;
        var checked = expVarModalSelection[key] ? 'checked' : '';
        var kindLabel = v.kind === 'measurement' ? '📊 Meas' : '🔧 Cal';
        var kindColor = v.kind === 'measurement' ? '#4488ff' : '#ff8844';
        var measLocked = daqActive && v.kind === 'measurement';
        var disabledAttr = measLocked ? 'disabled' : '';
        var rowStyle = measLocked ? 'cursor:not-allowed; opacity:0.5;' : 'cursor:pointer;';
        var rowClick = measLocked ? '' : 'onclick="expToggleVarCheckbox(\'' + key + '\')"';

        // Build event cell
        var eventCell;
        if (v.kind === 'measurement') {
            var configDevId = v.config_device_id || '';
            var evts = expGetEventsForDevice(configDevId);
            var curCh = expEventSelections[selKey] !== undefined ? expEventSelections[selKey] : expGetFirstEventChannel(configDevId);
            if (evts.length > 0) {
                var opts = evts.map(function(e) {
                    var label = e.name + (e.cycle_time_ms > 0 ? ' (' + e.cycle_time_ms.toFixed(1) + 'ms)' : '');
                    var sel = e.channel === curCh ? ' selected' : '';
                    return '<option value="' + e.channel + '"' + sel + '>' + escapeHtml(label) + '</option>';
                }).join('');
                eventCell = '<td style="padding:0.3rem;" onclick="event.stopPropagation();">' +
                    '<select data-evt-key="' + escapeHtml(selKey) + '" ' + disabledAttr +
                    ' style="width:100%; font-size:0.78rem; background:#1a1a2e; color:#ccc; border:1px solid #444; border-radius:3px; padding:2px 4px;"' +
                    ' onchange="expEventSelections[this.dataset.evtKey]=parseInt(this.value)">' +
                    opts + '</select></td>';
            } else {
                eventCell = '<td style="padding:0.5rem; color:#555; font-size:0.8rem;">—</td>';
            }
        } else {
            eventCell = '<td style="padding:0.5rem; color:#555; font-size:0.8rem;">—</td>';
        }

        html +=
            '<tr ' + rowClick + ' style="' + rowStyle + '" class="' + (checked ? 'selected-row' : '') + '">' +
            '<td style="padding:0.5rem; text-align:center;"><input type="checkbox" ' + checked + ' ' + disabledAttr + ' data-key="' + key + '" onclick="event.stopPropagation(); expToggleVar(\'' + key + '\')"></td>' +
            '<td style="padding:0.5rem;">' + escapeHtml(v.name) + '</td>' +
            '<td style="padding:0.5rem; color:#888;">' + escapeHtml(v.device_name) + '</td>' +
            '<td style="padding:0.5rem;"><span style="color:' + kindColor + '; font-size:0.8rem;">' + kindLabel + '</span></td>' +
            '<td style="padding:0.5rem; font-family:monospace; font-size:0.8rem;">' + escapeHtml(v.type) + '</td>' +
            '<td style="padding:0.5rem; font-family:monospace; font-size:0.8rem; color:#888;">' + escapeHtml(v.address) + '</td>' +
            eventCell +
            '</tr>';
    });
    return html;
}

function expLoadMoreVars() {
    if (expIsLoadingMore || expDisplayedCount >= expFilteredItems.length) return;
    expIsLoadingMore = true;
    var indicator = document.getElementById('expLoadingIndicator');
    indicator.style.display = 'block';
    setTimeout(function() {
        var tbody = document.getElementById('expVarList');
        var nextBatch = expFilteredItems.slice(expDisplayedCount, expDisplayedCount + EXP_VAR_BATCH_SIZE);
        tbody.insertAdjacentHTML('beforeend', expRenderVarRows(nextBatch));
        expDisplayedCount += nextBatch.length;
        indicator.style.display = expDisplayedCount < expFilteredItems.length ? 'block' : 'none';
        expIsLoadingMore = false;
    }, 50);
}

function expSetupVarScrollListener() {
    var modalBody = document.querySelector('#expVarModal .exp-modal-body');
    if (!modalBody) return;
    var fresh = modalBody.cloneNode(true);
    modalBody.parentNode.replaceChild(fresh, modalBody);
    var ref = document.querySelector('#expVarModal .exp-modal-body');
    ref.addEventListener('scroll', function() {
        if (ref.scrollTop + ref.clientHeight >= ref.scrollHeight - 100) {
            if (!expIsLoadingMore && expDisplayedCount < expFilteredItems.length) {
                expLoadMoreVars();
            }
        }
    });
}

function expFilterVars() {
    expPopulateVarModal();
    expSetupVarScrollListener();
}

function expToggleVar(key) {
    // Prevent toggling measurement variables while DAQ is running
    if (ExpState.mode !== 'idle' && key.startsWith('measurement:')) {
        return;
    }
    if (expVarModalSelection[key]) {
        delete expVarModalSelection[key];
    } else {
        expVarModalSelection[key] = true;
    }
    // Update row in-place instead of re-rendering
    var cb = document.querySelector('#expVarList input[data-key="' + key + '"]');
    if (cb) {
        var isSelected = !!expVarModalSelection[key];
        cb.checked = isSelected;
        cb.closest('tr').className = isSelected ? 'selected-row' : '';
    }
    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expToggleVarCheckbox(key) { expToggleVar(key); }

function expToggleSelectAll() {
    var allChecked = document.getElementById('expSelectAll').checked;
    var daqActive = ExpState.mode !== 'idle';
    document.querySelectorAll('#expVarList input[type="checkbox"]').forEach(function(cb) {
        var key = cb.dataset.key;
        if (daqActive && key.startsWith('measurement:')) return;
        if (allChecked) {
            expVarModalSelection[key] = true;
            cb.checked = true;
            cb.closest('tr').className = 'selected-row';
        } else {
            delete expVarModalSelection[key];
            cb.checked = false;
            cb.closest('tr').className = '';
        }
    });
    var count = Object.keys(expVarModalSelection).length;
    document.getElementById('expVarCount').textContent = count + ' selected';
}

function expApplyVarSelection() {
    var tab = ExpState.tabs.find(function(t) { return t.id === ExpState.activeTabId; });
    if (!tab) return;

    var newVars = [];
    Object.keys(expVarModalSelection).forEach(function(key) {
        var parts = key.split(':');
        var kind = parts[0];
        var device_id = parts[1];
        var idx = parseInt(parts[2]);
        var source;
        if (kind === 'measurement') {
            source = ExpState.allMeasurements.find(function(m) { return m.device_id === device_id && m.idx === idx; });
            if (source) {
                var selKey = device_id + ':' + idx;
                var configDevId = source.config_device_id || '';
                var eventCh = expEventSelections[selKey] !== undefined
                    ? expEventSelections[selKey]
                    : expGetFirstEventChannel(configDevId);
                newVars.push({
                    kind: 'measurement', device_id: source.device_id, device_name: source.device_name,
                    config_device_id: configDevId,
                    idx: source.idx, name: source.name, type: source.type || '',
                    unit: source.unit || '', isMapCurve: false,
                    event_channel: eventCh,
                });
            }
        } else {
            source = ExpState.allCalibrations.find(function(c) { return c.device_id === device_id && c.idx === idx; });
            if (source) {
                var typeName = source.type_name || source.type || '';
                var charType = (source.characteristic_type || '').toUpperCase();
                newVars.push({
                    kind: 'calibration', device_id: source.device_id, device_name: source.device_name,
                    idx: source.idx, name: source.name, type: typeName,
                    unit: source.unit || '', calType: source.characteristic_type || typeName,
                    isMapCurve: charType === 'MAP' || charType === 'CURVE' || charType === 'VAL_BLK' || typeName.indexOf('Matrix') >= 0 || typeName.indexOf('Array') >= 0,
                });
            }
        }
    });

    tab.variables = newVars;
    tab.graphedKeys = (tab.graphedKeys || []).filter(function(graphKey) {
        return newVars.some(function(v) {
            return v.kind === 'measurement' && expGraphKey(v.device_id, v.name) === graphKey;
        });
    });
    expCloseVarModal();
    expRenderTabContent();
    expUpdateGraphPanel();
    expReadAllCalValues();
    expSaveStateToStorage();
}

// ===== DAQ Control =====
function expStart() {
    if (ExpState.mode !== 'idle') return;

    // Collect unique measurements across all tabs, grouped by device
    var selections = {};
    var events = {};  // config_device_id -> { idx_str: channel }
    var seen = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'measurement'; }).forEach(function(v) {
            var key = v.device_id + ':' + v.idx;
            if (!seen[key]) {
                seen[key] = true;
                if (!selections[v.device_id]) selections[v.device_id] = [];
                selections[v.device_id].push(v.idx);
                // Record event assignment keyed by config_device_id for backend
                var configDevId = v.config_device_id || v.device_id;
                if (!events[configDevId]) events[configDevId] = {};
                if (v.event_channel !== undefined) {
                    events[configDevId][String(v.idx)] = v.event_channel;
                }
            }
        });
    });

    if (Object.keys(selections).length === 0) {
        expToast('No measurement variables selected in any tab', 'error');
        return;
    }

    document.getElementById('btnStart').disabled = true;

    fetch('/api/experiment/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ selections: selections, events: events }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            ExpState.mode = 'running';
            expUpdateToolbarState();
            expSignalHistory = {};
            expGraphStartTime = Date.now();
            expStartDataPolling();
            expStartGraphInterval();
            expUpdateGraphPanel();
            expToast('DAQ started on ' + data.started + ' device(s)', 'success');
        } else {
            expToast('Start failed: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
        document.getElementById('btnStart').disabled = false;
    })
    .catch(function(e) {
        expToast('Start failed: ' + e, 'error');
        document.getElementById('btnStart').disabled = false;
    });
}

function expRecord() {
    if (ExpState.mode !== 'running') return;
    var title = document.getElementById('expTitle').value.trim() || 'experiment';
    var dir = ExpState.config.mf4Dir || 'records';

    fetch('/api/experiment/record/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ title: title, dir: dir }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            ExpState.mode = 'recording';
            expUpdateToolbarState();
            expToast('Recording started', 'success');
        } else {
            expToast('Record failed: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
    })
    .catch(function(e) { expToast('Record failed: ' + e, 'error'); });
}

function expStop() {
    if (ExpState.mode === 'idle') return;

    fetch('/api/experiment/stop', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        ExpState.mode = 'idle';
        expStopDataPolling();
        expStopGraphInterval();
        expUpdateToolbarState();
        expUpdateGraphPanel();
        if (data.success) {
            expToast('DAQ stopped on ' + data.stopped + ' device(s)', 'success');
        } else {
            expToast('Stop: ' + (data.error || (data.errors ? data.errors.join('; ') : '')), 'error');
        }
    })
    .catch(function(e) {
        ExpState.mode = 'idle';
        expStopDataPolling();
        expStopGraphInterval();
        expUpdateToolbarState();
        expUpdateGraphPanel();
        expToast('Stop error: ' + e, 'error');
    });
}

function expUpdateToolbarState() {
    var btnStart = document.getElementById('btnStart');
    var btnRecord = document.getElementById('btnRecord');
    var btnStop = document.getElementById('btnStop');
    var btnAddVars = document.getElementById('btnAddVars');
    var stateLabel = document.getElementById('expStateLabel');

    switch (ExpState.mode) {
        case 'idle':
            btnStart.style.display = '';
            btnRecord.style.display = 'none';
            btnStop.style.display = 'none';
            btnAddVars.disabled = false;
            stateLabel.textContent = 'IDLE';
            stateLabel.style.color = '#888';
            btnRecord.classList.remove('recording');
            btnRecord.disabled = false;
            break;
        case 'running':
            btnStart.style.display = 'none';
            btnRecord.style.display = '';
            btnStop.style.display = '';
            btnAddVars.disabled = false;
            stateLabel.textContent = 'DAQ RUNNING';
            stateLabel.style.color = '#00ff88';
            btnRecord.classList.remove('recording');
            btnRecord.disabled = false;
            break;
        case 'recording':
            btnStart.style.display = 'none';
            btnRecord.style.display = '';
            btnRecord.classList.add('recording');
            btnRecord.disabled = true;
            btnStop.style.display = '';
            btnAddVars.disabled = false;
            stateLabel.textContent = '⏺ RECORDING';
            stateLabel.style.color = '#ff4444';
            break;
    }
    expRenderTabContent();
}

// ===== Data Polling =====
function expStartDataPolling() {
    if (ExpState.pollingInterval) return;
    ExpState.pollingInterval = setInterval(expPollData, 500);
}

function expStopDataPolling() {
    if (ExpState.pollingInterval) {
        clearInterval(ExpState.pollingInterval);
        ExpState.pollingInterval = null;
    }
}

function expPollData() {
    // Collect all measurement variables across tabs to build a filter list
    var varList = [];
    var seen = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'measurement'; }).forEach(function(v) {
            var k = v.device_id + ':' + v.name;
            if (!seen[k]) {
                seen[k] = true;
                varList.push({ device_id: v.device_id, name: v.name });
            }
        });
    });

    if (varList.length === 0) return;

    fetch('/api/daq/data', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ variables: varList }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success && data.values && Array.isArray(data.values)) {
            data.values.forEach(function(entry) {
                var key = entry.device_id + ':' + entry.var_name;
                ExpState.liveValues[key] = parseFloat(entry.value);
                if (expGraphStartTime !== null) {
                    var relT = (Date.now() - expGraphStartTime) / 1000;
                    if (!expSignalHistory[key]) expSignalHistory[key] = { times: [], values: [] };
                    var h = expSignalHistory[key];
                    h.times.push(relT);
                    h.values.push(isNaN(ExpState.liveValues[key]) ? 0 : ExpState.liveValues[key]);
                    if (h.times.length > EXP_MAX_HIST) {
                        h.times.splice(0, 500);
                        h.values.splice(0, 500);
                    }
                }
            });
            document.querySelectorAll('[data-live-key]').forEach(function(el) {
                var key = el.dataset.liveKey;
                if (ExpState.liveValues[key] !== undefined) {
                    el.textContent = expMeasDisplayVal(key, ExpState.liveValues[key]);
                }
            });
        }
    })
    .catch(function() {});
}

// ===== Status Polling =====
function expStartStatusPolling() {
    ExpState.statusInterval = setInterval(expPollStatus, 3000);
    expPollStatus();
}

function expPollStatus() {
    fetch('/api/experiment/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                expUpdateStatusBar(data.devices || []);
                // Sync mode if server says experiment is active but we think idle
                if (data.experiment_active && ExpState.mode === 'idle') {
                    if (data.daq_running_count > 0) {
                        ExpState.mode = data.recording_count > 0 ? 'recording' : 'running';
                        expUpdateToolbarState();
                        if (ExpState.mode !== 'idle') {
                            expStartDataPolling();
                            if (expGraphStartTime === null) {
                                expSignalHistory = {};
                                expGraphStartTime = Date.now();
                                expStartGraphInterval();
                            }
                            expUpdateGraphPanel();
                        }
                    }
                }
            }
        })
        .catch(function() {});
}

function expUpdateStatusBar(devices) {
    var bar = document.getElementById('expStatusBar');
    if (devices.length === 0) {
        bar.innerHTML = '<span class="status-item">No devices loaded</span>';
        return;
    }
    var html = '';
    devices.forEach(function(d, i) {
        if (i > 0) html += '<span class="status-separator"></span>';
        var dotClass = d.connected ? 'connected' : 'disconnected';
        var name = d.device_name || d.device_id;
        var tooltip = name + '\nA2L: ' + (d.a2l_file || 'none') + '\nPage: ' + (d.page_mode || 'N/A') + '\nDAQ: ' + (d.daq_running ? 'running' : 'stopped');
        html += '<span class="status-item" title="' + escapeHtml(tooltip) + '"><span class="status-dot ' + dotClass + '"></span>' + escapeHtml(name) + '</span>';
    });
    bar.innerHTML = html;
}

// ===== Page Mode Toggle =====
function expTogglePageMode() {
    var newMode = ExpState.pageMode === 'reference' ? 'working' : 'reference';

    fetch('/api/experiment/pagemode', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ mode: newMode }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.switched > 0 || data.failed === 0) {
            ExpState.pageMode = newMode;
            var toggle = document.getElementById('pageModeToggle');
            if (newMode === 'working') toggle.classList.add('working');
            else toggle.classList.remove('working');

            if (data.results) {
                data.results.forEach(function(r) {
                    ExpState.pageModeResults[r.device_id] = {
                        success: r.success,
                        read_only: r.read_only || false,
                    };
                });
            }

            if (data.failed > 0) {
                expToast('Switched ' + data.switched + ' device(s), ' + data.failed + ' failed (read-only)', 'error');
            } else {
                expToast('Switched to ' + newMode + ' page', 'success');
            }
            expRenderTabContent();
        } else {
            expToast('Page mode switch failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Page mode switch failed: ' + e, 'error'); });
}

// ===== Calibration Read/Edit =====
function expReadAllCalValues() {
    var calVars = {};
    ExpState.tabs.forEach(function(tab) {
        tab.variables.filter(function(v) { return v.kind === 'calibration'; }).forEach(function(v) {
            calVars[v.device_id + ':' + v.idx] = true;
        });
    });

    Object.keys(calVars).forEach(function(key) {
        var parts = key.split(':');
        var deviceId = parts[0];
        var idx = parts[1];
        fetch('/api/cal/value/' + deviceId + '/' + idx)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.value !== undefined) {
                    // Update enum options cache if provided by this endpoint
                    if (data.is_enum && data.enum_options && data.enum_options.length > 0) {
                        ExpState.calEnumOptions[key] = data.enum_options;
                    }
                    // Extract scalar from array format [rawVal] returned by cal_value_api
                    var rawVal = Array.isArray(data.value) ? data.value[0] : data.value;
                    var text = expEnumLookup(ExpState.calEnumOptions[key], rawVal);
                    var displayVal = text !== null ? text : String(rawVal);
                    ExpState.calValues[key] = displayVal;
                    document.querySelectorAll('[data-cal-key="' + key + '"]').forEach(function(el) {
                        el.textContent = displayVal;
                    });
                    expUpdateChangeMark(key);
                }
            })
            .catch(function() {});
    });
    // Fetch originals for any vars that don't have one yet
    expFetchOriginalValues();
}

var currentCalEdit = null;

function expEditCal(deviceId, idx, name) {
    if (ExpState.pageMode !== 'working') return;
    currentCalEdit = { deviceId: deviceId, idx: idx, name: name };
    document.getElementById('expCalEditTitle').textContent = 'Edit: ' + name;
    var key = deviceId + ':' + idx;
    var opts = ExpState.calEnumOptions[key];
    var inputEl = document.getElementById('expCalEditValue');
    var selectEl = document.getElementById('expCalEditSelect');
    if (opts && opts.length > 0) {
        // Enum var — show dropdown selector
        document.getElementById('expCalEditLabel').textContent = 'Select value:';
        inputEl.style.display = 'none';
        selectEl.innerHTML = opts.map(function(opt) {
            return '<option value="' + escapeHtml(opt.text) + '">' + escapeHtml(opt.text) + '</option>';
        }).join('');
        var curVal = ExpState.calValues[key] || '';
        selectEl.value = curVal;
        selectEl.style.display = '';
        document.getElementById('expCalEditModal').style.display = 'flex';
        selectEl.focus();
    } else {
        // Scalar var — show text input
        document.getElementById('expCalEditLabel').textContent = 'Current value:';
        selectEl.style.display = 'none';
        inputEl.value = ExpState.calValues[key] || '';
        inputEl.style.display = '';
        document.getElementById('expCalEditModal').style.display = 'flex';
        inputEl.focus();
    }
}

function expCloseCalEdit() {
    document.getElementById('expCalEditModal').style.display = 'none';
    currentCalEdit = null;
}

function expSaveCalEdit() {
    if (!currentCalEdit) return;
    var deviceId = currentCalEdit.deviceId;
    var idx = currentCalEdit.idx;
    var key = deviceId + ':' + idx;
    // Read value from select (enum) or text input (scalar)
    var opts = ExpState.calEnumOptions[key];
    var selectEl = document.getElementById('expCalEditSelect');
    var value = (opts && opts.length > 0 && selectEl && selectEl.style.display !== 'none')
        ? selectEl.value
        : document.getElementById('expCalEditValue').value;

    fetch('/api/experiment/cal/write/' + deviceId + '/' + idx, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: 'value=' + encodeURIComponent(value),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            var key = deviceId + ':' + idx;
            ExpState.calValues[key] = value;
            document.querySelectorAll('[data-cal-key="' + key + '"]').forEach(function(el) {
                el.textContent = value;
            });
            expUpdateChangeMark(key);
            // Track (or un-track) this write as a session-changed parameter
            var varInfo = expFindVarInTabs(deviceId, idx);
            if (varInfo) {
                var origVal = ExpState.calOriginalValues[key] || '';
                if (value === origVal) {
                    // Written back to original — remove from session-changed tracking
                    delete ExpState.sessionChangedParams[key];
                } else {
                    ExpState.sessionChangedParams[key] = {
                        device_id: deviceId,
                        idx: idx,
                        name: varInfo.name,
                        calType: varInfo.calType || '',
                        device_name: varInfo.device_name || '',
                        unit: varInfo.unit || '',
                        original_value: origVal,
                        current_value: value,
                    };
                }
            }
            expCloseCalEdit();
            expToast('Value written successfully', 'success');
        } else {
            expToast('Write failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Write failed: ' + e, 'error'); });
}

// ===== Map/Curve Data Loading =====
function expLoadMapData(deviceId, idx) {
    expShowMatrix(deviceId, idx, '');
}

// ===== Variable Info Modal =====
function expShowInfo(varType, deviceId, idx, name) {
    document.getElementById('expInfoTitle').textContent = name;
    document.getElementById('expInfoModal').style.display = 'flex';
    document.getElementById('expInfoBody').innerHTML = '<p style="text-align:center; color:#888;">Loading...</p>';

    var apiPath = varType === 'cal' ? '/api/cal/detail/' + deviceId + '/' + idx : '/api/daq/detail/' + deviceId + '/' + idx;
    fetch(apiPath)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.detail) {
                expRenderInfo(data.detail, varType);
            } else {
                document.getElementById('expInfoBody').innerHTML = '<p style="color:#ff4444;">Error: ' + escapeHtml(data.error || 'Unknown') + '</p>';
            }
        })
        .catch(function(e) {
            document.getElementById('expInfoBody').innerHTML = '<p style="color:#ff4444;">Failed: ' + escapeHtml(e.message || String(e)) + '</p>';
        });
}

function expCloseInfo() {
    document.getElementById('expInfoModal').style.display = 'none';
}

function expRenderInfo(detail, varType) {
    var body = document.getElementById('expInfoBody');
    var html = '<table style="width:100%; border-collapse:collapse;">';

    function row(label, value) {
        if (value === undefined || value === null || value === '') return '';
        return '<tr class="exp-info-row"><td>' + escapeHtml(label) + '</td><td style="font-family:monospace; word-break:break-all;">' + escapeHtml(String(value)) + '</td></tr>';
    }

    html += row('Name', detail.name);
    html += row('Device', detail.device_name);
    html += row('Type', detail.type);
    html += row('Address', detail.address);
    html += row('Address Extension', detail.address_ext);

    if (varType === 'cal') {
        html += row('Description', detail.description);
        html += row('Unit', detail.unit);
        html += row('Range', detail.range);
        html += row('Characteristic Type', detail.characteristic_type);
        html += row('Storage Order', detail.storage_order);
        html += row('Data Size', detail.data_size);

        if (detail.axis_info && detail.axis_info.length > 0) {
            html += '<tr><td colspan="2" style="padding:1rem 0.5rem 0.5rem; border:none; font-weight:bold; color:#00ff88;">Axis Information</td></tr>';
            detail.axis_info.forEach(function(axis, i) {
                var axisRole = '';
                if (detail.characteristic_type === 'MAP' && detail.axis_info.length === 2) {
                    axisRole = i === 0 ? ' (X, columns)' : ' (Y, rows)';
                } else if (detail.characteristic_type === 'CURVE') {
                    axisRole = ' (X)';
                }
                html += '<tr><td colspan="2" style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' +
                    '<strong>Axis ' + (i + 1) + axisRole + ': ' + escapeHtml(axis.pts_ref_name || 'unnamed') + '</strong>' +
                    (axis.unit ? ' (' + escapeHtml(axis.unit) + ')' : '') +
                    '<br>Points: ' + axis.num_points + ', Range: ' + axis.min + ' ~ ' + axis.max +
                    '</td></tr>';
            });
        }
    } else {
        html += row('Description', detail.description);
        html += row('Unit', detail.unit);
        html += row('Data Size', detail.data_size);
    }

    html += '</table>';
    body.innerHTML = html;
}

// ===== Matrix/Array Data Modal =====
var expMatrixDeviceId = null;
var expMatrixIdx = null;

function expShowMatrix(deviceId, idx, name) {
    expMatrixDeviceId = deviceId;
    expMatrixIdx = idx;
    document.getElementById('expMatrixTitle').textContent = name || 'Data Viewer';
    document.getElementById('expMatrixModal').style.display = 'flex';
    document.getElementById('expMatrixBody').innerHTML = '<p style="text-align:center; color:#888;">Loading data...</p>';
    document.getElementById('expMatrixAxisInfo').innerHTML = '';
    document.getElementById('expMatrixPageMode').innerHTML = '';

    fetch('/api/cal/value/' + deviceId + '/' + idx)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                expRenderMatrix(data);
            } else {
                document.getElementById('expMatrixBody').innerHTML = '<p style="color:#ff4444;">Error: ' + escapeHtml(data.error || '') + '</p>';
            }
        })
        .catch(function(e) {
            document.getElementById('expMatrixBody').innerHTML = '<p style="color:#ff4444;">Failed: ' + escapeHtml(String(e)) + '</p>';
        });
}

function expCloseMatrix() {
    document.getElementById('expMatrixModal').style.display = 'none';
    expMatrixDeviceId = null;
    expMatrixIdx = null;
}

function expRenderMatrix(data) {
    var container = document.getElementById('expMatrixBody');
    var isWorking = data.is_working_page;
    var axisValues = data.axis_values || [];
    var axisInfo = data.axis_info || [];

    // Page mode indicator
    var pageModeSpan = document.getElementById('expMatrixPageMode');
    if (isWorking) {
        pageModeSpan.innerHTML = '<span style="color:#4CAF50;">✏️ Working (editable)</span>';
    } else {
        pageModeSpan.innerHTML = '<span style="color:#888;">📖 Reference (read-only)</span>';
    }

    // Axis info
    var axisInfoDiv = document.getElementById('expMatrixAxisInfo');
    if (axisInfo.length === 2) {
        var xLabel = axisInfo[0].pts_ref_name || 'unnamed';
        var yLabel = axisInfo[1].pts_ref_name || 'unnamed';
        axisInfoDiv.innerHTML = 'X: ' + escapeHtml(xLabel) + ' | Y: ' + escapeHtml(yLabel);
    } else if (axisInfo.length === 1) {
        var xLabel = axisInfo[0].pts_ref_name || 'unnamed';
        axisInfoDiv.innerHTML = 'X: ' + escapeHtml(xLabel);
    }

    // Update title with name if available
    if (data.name) {
        document.getElementById('expMatrixTitle').textContent = data.name;
    }

    // Capture original cell values on first show (so we can detect changes)
    expCaptureMatrixOriginals(expMatrixDeviceId, expMatrixIdx, data);

    if (data.is_1d) {
        expRender1DTable(container, data, isWorking, axisValues, axisInfo);
    } else {
        expRender2DTable(container, data, isWorking, axisValues, axisInfo);
    }
}

// Store original matrix values for change tracking (only stores if not yet captured)
function expCaptureMatrixOriginals(deviceId, idx, data) {
    var values = data.value;
    var enumOpts = data.enum_options || [];
    if (!values) return;

    function toOrigStr(v) {
        var s = String(v !== undefined ? v : '-');
        if (enumOpts.length > 0) {
            var raw = Math.round(parseFloat(s));
            if (!isNaN(raw)) {
                for (var i = 0; i < enumOpts.length; i++) {
                    if (enumOpts[i].raw === raw) return enumOpts[i].text;
                }
            }
        }
        return s;
    }

    if (data.is_1d) {
        for (var c = 0; c < data.cols; c++) {
            var origKey = deviceId + ':' + idx + ':0:' + c;
            if (ExpState.calOriginalMatrix[origKey] === undefined) {
                ExpState.calOriginalMatrix[origKey] = toOrigStr(values[c]);
            }
        }
    } else {
        for (var r = 0; r < data.rows; r++) {
            for (var c = 0; c < data.cols; c++) {
                var origKey = deviceId + ':' + idx + ':' + r + ':' + c;
                if (ExpState.calOriginalMatrix[origKey] === undefined) {
                    var rowVals = values[r];
                    ExpState.calOriginalMatrix[origKey] = toOrigStr(rowVals && rowVals[c] !== undefined ? rowVals[c] : '-');
                }
            }
        }
    }
}

// Returns mark CSS classes for a matrix cell given its original and current value strings
function expGetMatrixCellMark(origStr, curStr) {
    if (origStr === undefined) return '';
    var o = parseFloat(origStr), n = parseFloat(curStr);
    if (isNaN(o) || isNaN(n)) return curStr !== origStr ? 'matrix-cell-changed' : '';
    if (n > o) return 'matrix-cell-changed';
    if (n < o) return 'matrix-cell-changed matrix-cell-changed-down';
    return '';
}

function expRender1DTable(container, data, isWorking, axisValues, axisInfo) {
    var values = data.value;
    var cols = data.cols;
    var enumOpts = data.enum_options || [];
    var xLabels = [];
    if (axisValues.length > 0 && axisValues[0]) {
        xLabels = axisValues[0].map(function(v) { return String(v); });
    }

    function cellDisplay(val) {
        if (!enumOpts.length) return String(val);
        var raw = Math.round(parseFloat(String(val)));
        if (isNaN(raw)) return String(val);
        for (var i = 0; i < enumOpts.length; i++) {
            if (enumOpts[i].raw === raw) return enumOpts[i].text;
        }
        return String(val);
    }

    function cellInput(row, col, val) {
        var displayText = cellDisplay(val);
        if (enumOpts.length > 0) {
            var opts = enumOpts.map(function(o) {
                var sel = o.text === displayText ? ' selected' : '';
                return '<option value="' + escapeHtml(o.text) + '"' + sel + '>' + escapeHtml(o.text) + '</option>';
            }).join('');
            return '<select style="background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem; max-width:140px;" ' +
                'onchange="expSaveMatrixCell(' + row + ', ' + col + ', this.value, this)">' + opts + '</select>';
        }
        return '<input type="text" value="' + escapeHtml(String(val)) + '" style="width:80px; text-align:center; background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem;" ' +
            'onchange="expSaveMatrixCell(' + row + ', ' + col + ', this.value, this)">';
    }

    var html = '<table style="width:100%; border-collapse:collapse;"><thead><tr>' +
        '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">Index</th>';
    for (var c = 0; c < cols; c++) {
        html += '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' + escapeHtml(xLabels[c] || String(c)) + '</th>';
    }
    html += '</tr></thead><tbody><tr><td style="padding:0.5rem; background:#1e1e1e; border:1px solid #444; font-weight:bold;">Value</td>';
    for (var c = 0; c < cols; c++) {
        var val = values[c] !== undefined ? values[c] : '-';
        var dispVal = cellDisplay(val);
        var origKey = expMatrixDeviceId + ':' + expMatrixIdx + ':0:' + c;
        var markClass = expGetMatrixCellMark(ExpState.calOriginalMatrix[origKey], dispVal);
        if (isWorking) {
            html += '<td style="padding:0.25rem; border:1px solid #444; text-align:center;" class="' + markClass + '" data-cell-key="' + escapeHtml(origKey) + '">' +
                cellInput(0, c, val) + '</td>';
        } else {
            html += '<td style="padding:0.5rem; border:1px solid #444; text-align:center; color:#00ff88;" class="' + markClass + '">' + escapeHtml(dispVal) + '</td>';
        }
    }
    html += '</tr></tbody></table>';
    container.innerHTML = html;
}

function expRender2DTable(container, data, isWorking, axisValues, axisInfo) {
    var values = data.value;
    var rows = data.rows;
    var cols = data.cols;
    var enumOpts = data.enum_options || [];
    var xLabels = [], yLabels = [];
    if (axisValues.length > 1) {
        xLabels = axisValues[0] ? axisValues[0].map(function(v) { return String(v); }) : [];
        yLabels = axisValues[1] ? axisValues[1].map(function(v) { return String(v); }) : [];
    } else if (axisValues.length > 0) {
        yLabels = axisValues[0] ? axisValues[0].map(function(v) { return String(v); }) : [];
    }

    function cellDisplay(val) {
        if (!enumOpts.length) return String(val);
        var raw = Math.round(parseFloat(String(val)));
        if (isNaN(raw)) return String(val);
        for (var i = 0; i < enumOpts.length; i++) {
            if (enumOpts[i].raw === raw) return enumOpts[i].text;
        }
        return String(val);
    }

    function cellInput(row, col, val) {
        var displayText = cellDisplay(val);
        if (enumOpts.length > 0) {
            var opts = enumOpts.map(function(o) {
                var sel = o.text === displayText ? ' selected' : '';
                return '<option value="' + escapeHtml(o.text) + '"' + sel + '>' + escapeHtml(o.text) + '</option>';
            }).join('');
            return '<select style="background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem; max-width:140px;" ' +
                'onchange="expSaveMatrixCell(' + row + ', ' + col + ', this.value, this)">' + opts + '</select>';
        }
        return '<input type="text" value="' + escapeHtml(String(val)) + '" style="width:80px; text-align:center; background:#1e1e1e; border:1px solid #0f3460; color:#00ff88; padding:0.25rem;" ' +
            'onchange="expSaveMatrixCell(' + row + ', ' + col + ', this.value, this)">';
    }

    // Transpose for correct display (values[r][c] where r=X_points, c=Y_points -> display r=Y, c=X)
    var transposed = [];
    for (var c = 0; c < cols; c++) {
        transposed[c] = [];
        for (var r = 0; r < rows; r++) {
            transposed[c][r] = values[r] ? values[r][c] : '-';
        }
    }
    var displayRows = cols;
    var displayCols = rows;

    var html = '<table style="width:100%; border-collapse:collapse;"><thead><tr>' +
        '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;"></th>';
    for (var dc = 0; dc < displayCols; dc++) {
        html += '<th style="padding:0.5rem; background:#2a2a2a; border:1px solid #444;">' + escapeHtml(xLabels[dc] || String(dc)) + '</th>';
    }
    html += '</tr></thead><tbody>';

    for (var dr = 0; dr < displayRows; dr++) {
        html += '<tr><td style="padding:0.5rem; background:#2a2a2a; border:1px solid #444; font-weight:bold;">' + escapeHtml(yLabels[dr] || String(dr)) + '</td>';
        for (var dc = 0; dc < displayCols; dc++) {
            var val = transposed[dr] ? (transposed[dr][dc] !== undefined ? transposed[dr][dc] : '-') : '-';
            var dispVal = cellDisplay(val);
            // original matrix stores [original_row][original_col]; transpose mapping: dc=row, dr=col
            var origKey = expMatrixDeviceId + ':' + expMatrixIdx + ':' + dc + ':' + dr;
            var markClass = expGetMatrixCellMark(ExpState.calOriginalMatrix[origKey], dispVal);
            if (isWorking) {
                html += '<td style="padding:0.25rem; border:1px solid #444; text-align:center;" class="' + markClass + '" data-cell-key="' + escapeHtml(origKey) + '">' +
                    cellInput(dc, dr, val) + '</td>';
            } else {
                html += '<td style="padding:0.5rem; border:1px solid #444; text-align:center; color:#00ff88;" class="' + markClass + '">' + escapeHtml(dispVal) + '</td>';
            }
        }
        html += '</tr>';
    }
    html += '</tbody></table>';
    container.innerHTML = html;
}

function expSaveMatrixCell(row, col, newVal, inputEl) {
    if (!expMatrixDeviceId || expMatrixIdx === null) return;
    fetch('/api/cal/write-element/' + expMatrixDeviceId + '/' + expMatrixIdx, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ row: row, col: col, value: newVal }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            expToast('Cell updated', 'success');
            // Track this matrix parameter as session-changed (once, on first cell write)
            var mKey = expMatrixDeviceId + ':' + expMatrixIdx;
            if (!ExpState.sessionChangedParams[mKey]) {
                var varInfo = expFindVarInTabs(expMatrixDeviceId, String(expMatrixIdx));
                if (varInfo) {
                    ExpState.sessionChangedParams[mKey] = {
                        device_id: expMatrixDeviceId,
                        idx: expMatrixIdx,
                        name: varInfo.name,
                        calType: varInfo.calType || '',
                        device_name: varInfo.device_name || '',
                        unit: varInfo.unit || '',
                        original_value: '',
                        current_value: '',
                    };
                }
            }
            // Update cell mark in-place
            if (inputEl) {
                var td = inputEl.closest ? inputEl.closest('td') : inputEl.parentNode;
                if (td) {
                    var origKey = td.dataset.cellKey;
                    if (origKey) {
                        var markClass = expGetMatrixCellMark(ExpState.calOriginalMatrix[origKey], String(newVal));
                        td.className = markClass;
                    }
                }
            }
        } else {
            expToast('Write failed: ' + (data.error || ''), 'error');
        }
    })
    .catch(function(e) { expToast('Write error: ' + e, 'error'); });
}

// ===== Save / Load =====
function expSave() {
    // Collect device info for future resolution
    var deviceInfo = {};
    ExpState.tabs.forEach(function(t) {
        t.variables.forEach(function(v) {
            if (v.device_id && !deviceInfo[v.device_id]) {
                deviceInfo[v.device_id] = { name: v.device_name || '' };
            }
        });
    });

    var experiment = {
        version: 1,
        title: document.getElementById('expTitle').value,
        config: ExpState.config,
        pageMode: ExpState.pageMode,
        tabs: ExpState.tabs.map(function(t) { return { id: t.id, title: t.title, variables: t.variables }; }),
        pageModeResults: ExpState.pageModeResults,
        devices: deviceInfo,
        savedAt: new Date().toISOString(),
    };

    var blob = new Blob([JSON.stringify(experiment, null, 2)], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = (experiment.title || 'experiment').replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';
    a.click();
    URL.revokeObjectURL(url);
    expToast('Experiment saved', 'success');
}

function expLoad() {
    if (ExpState.mode !== 'idle') {
        expToast('Stop DAQ before loading', 'error');
        return;
    }
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(ev) {
            try {
                var data = JSON.parse(ev.target.result);
                expResolveAndLoad(data);
            } catch (err) {
                expToast('Invalid experiment file: ' + err.message, 'error');
            }
        };
        reader.readAsText(file);
    };
    input.click();
}

// Pending load data while device mapping dialog is open
var expPendingLoadData = null;
var expPendingDeviceMap = {};

function expResolveAndLoad(data) {
    // Collect all unique saved device IDs and their names
    var savedDevices = {};
    if (data.devices) {
        // Use saved device info if available
        Object.keys(data.devices).forEach(function(id) {
            savedDevices[id] = data.devices[id].name || id;
        });
    }
    if (data.tabs) {
        data.tabs.forEach(function(tab) {
            if (tab.variables) {
                tab.variables.forEach(function(v) {
                    if (v.device_id && !savedDevices[v.device_id]) {
                        savedDevices[v.device_id] = v.device_name || v.device_id;
                    }
                });
            }
        });
    }
    var savedDeviceIds = Object.keys(savedDevices);
    if (savedDeviceIds.length === 0) {
        expApplyLoadedConfig(data, {});
        expToast('Experiment loaded: ' + (data.title || 'untitled'), 'success');
        return;
    }

    // Refresh variables first, then resolve devices
    fetch('/api/experiment/variables')
        .then(function(r) { return r.json(); })
        .then(function(varData) {
            if (varData.success) {
                ExpState.allMeasurements = varData.measurements || [];
                ExpState.allCalibrations = varData.calibrations || [];
                expPopulateVarFilterDevices();
            }
            return fetch('/api/experiment/status');
        })
        .then(function(r) { return r.json(); })
        .then(function(statusData) {
            var currentDevices = statusData.devices || [];
            var deviceMap = {};
            var unmapped = [];

            // Try auto-resolution: match by device_id first, then by name
            savedDeviceIds.forEach(function(savedId) {
                var savedName = savedDevices[savedId];
                // Exact ID match
                var exactMatch = currentDevices.find(function(d) { return d.device_id === savedId; });
                if (exactMatch) {
                    deviceMap[savedId] = exactMatch.device_id;
                    return;
                }
                // Name match (case-insensitive)
                var nameMatch = currentDevices.find(function(d) {
                    return d.device_name && savedName &&
                           d.device_name.toLowerCase() === savedName.toLowerCase();
                });
                if (nameMatch) {
                    deviceMap[savedId] = nameMatch.device_id;
                    return;
                }
                unmapped.push(savedId);
            });

            if (unmapped.length === 0) {
                // All resolved automatically
                expApplyLoadedConfig(data, deviceMap);
                expToast('Experiment loaded: ' + (data.title || 'untitled'), 'success');
            } else {
                // Show mapping dialog for unresolved devices
                expPendingLoadData = data;
                expPendingDeviceMap = deviceMap;
                expShowDeviceMapDialog(unmapped, savedDevices, currentDevices);
            }
        })
        .catch(function(e) {
            expToast('Failed to check devices: ' + e, 'error');
        });
}

function expShowDeviceMapDialog(unmapped, savedDevices, currentDevices) {
    var container = document.getElementById('expDeviceMapRows');
    var html = '';
    unmapped.forEach(function(savedId) {
        var savedName = savedDevices[savedId];
        html +=
            '<div style="display:flex; align-items:center; gap:0.75rem; padding:0.5rem; border-bottom:1px solid #333;">' +
            '<div style="flex:1;">' +
            '<div style="color:#ccc;">' + escapeHtml(savedName) + '</div>' +
            '<div style="color:#666; font-size:0.7rem; font-family:monospace;">' + escapeHtml(savedId) + '</div>' +
            '</div>' +
            '<span style="color:#888;">→</span>' +
            '<select data-saved-id="' + escapeHtml(savedId) + '" style="flex:1; font-size:0.85rem;">' +
            '<option value="">(Skip - drop variables)</option>';
        currentDevices.forEach(function(d) {
            var label = escapeHtml(d.device_name) + (d.connected ? ' ✓' : ' (disconnected)');
            html += '<option value="' + escapeHtml(d.device_id) + '">' + label + '</option>';
        });
        html += '</select></div>';
    });
    container.innerHTML = html;
    document.getElementById('expDeviceMapModal').style.display = 'flex';
}

function expCancelDeviceMap() {
    document.getElementById('expDeviceMapModal').style.display = 'none';
    expPendingLoadData = null;
    expPendingDeviceMap = {};
    expToast('Load cancelled', '');
}

function expApplyDeviceMap() {
    var selects = document.querySelectorAll('#expDeviceMapRows select[data-saved-id]');
    selects.forEach(function(sel) {
        var savedId = sel.dataset.savedId;
        var mappedTo = sel.value;
        if (mappedTo) {
            expPendingDeviceMap[savedId] = mappedTo;
        }
        // If empty (skip), do NOT add to map — variables will be dropped
    });
    document.getElementById('expDeviceMapModal').style.display = 'none';
    expApplyLoadedConfig(expPendingLoadData, expPendingDeviceMap);
    var droppedCount = 0;
    selects.forEach(function(sel) { if (!sel.value) droppedCount++; });
    var msg = 'Experiment loaded: ' + (expPendingLoadData.title || 'untitled');
    if (droppedCount > 0) msg += ' (' + droppedCount + ' device(s) skipped)';
    expToast(msg, 'success');
    expPendingLoadData = null;
    expPendingDeviceMap = {};
}

function expApplyLoadedConfig(data, deviceMap) {
    if (data.title) document.getElementById('expTitle').value = data.title;
    if (data.config) {
        ExpState.config = { mf4Pattern: data.config.mf4Pattern || ExpState.config.mf4Pattern, mf4Dir: data.config.mf4Dir || ExpState.config.mf4Dir };
        document.getElementById('expMf4Pattern').value = ExpState.config.mf4Pattern;
        document.getElementById('expMf4Dir').value = ExpState.config.mf4Dir;
    }
    if (data.tabs && Array.isArray(data.tabs)) {
        // Remap device IDs and resolve variable indices
        data.tabs.forEach(function(tab) {
            if (tab.variables) {
                tab.variables = tab.variables.filter(function(v) {
                    if (!v.device_id) return false;
                    if (deviceMap.hasOwnProperty(v.device_id)) {
                        v.device_id = deviceMap[v.device_id];
                    }
                    // Resolve current index by name + device_id
                    if (v.kind === 'measurement') {
                        var m = ExpState.allMeasurements.find(function(x) { return x.device_id === v.device_id && x.name === v.name; });
                        if (m) {
                            v.idx = m.idx;
                            v.device_name = m.device_name;
                            v.unit = m.unit || v.unit || '';
                            return true;
                        }
                    } else if (v.kind === 'calibration') {
                        var c = ExpState.allCalibrations.find(function(x) { return x.device_id === v.device_id && x.name === v.name; });
                        if (c) {
                            v.idx = c.idx;
                            v.device_name = c.device_name;
                            v.unit = c.unit || v.unit || '';
                            v.calType = c.characteristic_type || v.calType || '';
                            var ct = (c.characteristic_type || '').toUpperCase();
                            v.isMapCurve = ct === 'MAP' || ct === 'CURVE' || ct === 'VAL_BLK';
                            return true;
                        }
                    }
                    // Variable not found on current device — drop it
                    return false;
                });
            }
        });
        // Remove empty tabs
        data.tabs = data.tabs.filter(function(tab) { return tab.variables && tab.variables.length > 0; });
        if (data.tabs.length === 0) {
            expToast('No variables could be resolved to connected devices', 'error');
        }
        ExpState.tabs = data.tabs;
        tabCounter = Math.max(tabCounter, data.tabs.length);
        ExpState.activeTabId = ExpState.tabs.length > 0 ? ExpState.tabs[0].id : null;
    }
    if (data.pageModeResults) ExpState.pageModeResults = data.pageModeResults;
    expRenderTabs();
    expRenderTabContent();
    expReadAllCalValues();
}

