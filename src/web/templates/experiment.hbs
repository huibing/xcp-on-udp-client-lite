<!-- Experiment Page Template -->
<!-- VSCode-like layout with toolbar, tabs, and status bar -->

<style>
/* ===== Experiment Page Layout ===== */
.exp-container {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 80px);
    margin: -2rem;
    overflow: hidden;
}

/* Title Bar */
.exp-title-bar {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #1e1e2e;
    border-bottom: 1px solid #333;
    gap: 0.5rem;
}
.exp-title-bar input {
    background: transparent;
    border: 1px solid transparent;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    width: 300px;
}
.exp-title-bar input:hover { border-color: #555; }
.exp-title-bar input:focus { border-color: #00ff88; outline: none; }

/* Toolbar */
.exp-toolbar {
    display: flex;
    align-items: center;
    padding: 0.35rem 1rem;
    background: #252535;
    border-bottom: 1px solid #333;
    gap: 0.25rem;
    flex-wrap: wrap;
}
.exp-toolbar .separator {
    width: 1px;
    height: 24px;
    background: #444;
    margin: 0 0.35rem;
}
.exp-tb-btn {
    background: none;
    border: 1px solid transparent;
    color: #ccc;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
    transition: all 0.15s;
}
.exp-tb-btn:hover { background: #3a3a4a; color: #fff; border-color: #555; }
.exp-tb-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.exp-tb-btn:disabled:hover { background: none; color: #ccc; border-color: transparent; }
.exp-tb-btn.active { background: #00ff88; color: #1a1a2e; }
.exp-tb-btn.danger { color: #ff6666; }
.exp-tb-btn.danger:hover { background: #4a2020; }
.exp-tb-btn.recording { color: #ff4444; animation: pulse-rec 1.5s infinite; }
@keyframes pulse-rec { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

/* Page mode toggle */
.exp-pagemode {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0 0.25rem;
}
.exp-pagemode label { color: #888; font-size: 0.8rem; cursor: pointer; }
.exp-pagemode .toggle {
    position: relative;
    width: 40px;
    height: 20px;
    background: #555;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.3s;
}
.exp-pagemode .toggle.working { background: #00ff88; }
.exp-pagemode .toggle::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    background: #fff;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    transition: left 0.3s;
}
.exp-pagemode .toggle.working::after { left: 22px; }

/* Main area with tabs */
.exp-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Tab bar */
.exp-tab-bar {
    display: flex;
    align-items: center;
    background: #1e1e2e;
    border-bottom: 1px solid #333;
    overflow-x: auto;
    min-height: 36px;
}
.exp-tab-bar::-webkit-scrollbar { height: 3px; }
.exp-tab-bar::-webkit-scrollbar-thumb { background: #555; border-radius: 2px; }
.exp-tab {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    background: #252535;
    border-right: 1px solid #333;
    cursor: pointer;
    font-size: 0.85rem;
    color: #888;
    white-space: nowrap;
    min-width: 100px;
    max-width: 200px;
    gap: 0.5rem;
    transition: all 0.15s;
}
.exp-tab:hover { background: #2a2a3a; color: #ccc; }
.exp-tab.active { background: #1a1a2e; color: #fff; border-bottom: 2px solid #00ff88; }
.exp-tab .tab-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}
.exp-tab .tab-close {
    opacity: 0;
    font-size: 0.75rem;
    padding: 0 2px;
    border-radius: 3px;
    transition: opacity 0.15s;
}
.exp-tab:hover .tab-close, .exp-tab.active .tab-close { opacity: 0.7; }
.exp-tab .tab-close:hover { opacity: 1; background: #ff444444; }
.exp-tab-add {
    padding: 0.4rem 0.6rem;
    color: #666;
    cursor: pointer;
    font-size: 1rem;
    border: none;
    background: none;
}
.exp-tab-add:hover { color: #00ff88; }

/* Tab content area */
.exp-tab-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    background: #1a1a2e;
}

/* Variable cards */
.exp-cards-section { margin-bottom: 1.5rem; }
.exp-cards-section h3 {
    color: #888;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
}
.exp-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
}
.exp-var-card {
    background: #252535;
    border: 1px solid #333;
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    position: relative;
    transition: border-color 0.15s;
}
.exp-var-card:hover { border-color: #555; }
.exp-var-card .card-name {
    font-size: 0.8rem;
    color: #aaa;
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.exp-var-card .card-device {
    font-size: 0.65rem;
    color: #666;
    margin-bottom: 0.15rem;
}
.exp-var-card .card-value {
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    color: #00ff88;
    font-weight: 600;
}
.exp-var-card .card-unit {
    font-size: 0.7rem;
    color: #888;
    margin-left: 0.25rem;
}
.exp-var-card.measurement { border-left: 3px solid #4488ff; }
.exp-var-card.calibration { border-left: 3px solid #ff8844; }
.exp-var-card.calibration.editable { cursor: pointer; }
.exp-var-card.calibration.editable:hover { border-color: #ff8844; }
.exp-var-card.calibration.readonly { opacity: 0.7; }
.exp-var-card .card-remove {
    position: absolute;
    top: 4px;
    right: 4px;
    opacity: 0;
    color: #ff4444;
    cursor: pointer;
    font-size: 0.7rem;
    padding: 2px 4px;
    border-radius: 3px;
    transition: opacity 0.15s;
}
.exp-var-card:hover .card-remove { opacity: 0.7; }
.exp-var-card .card-remove:hover { opacity: 1; background: #ff444433; }
.exp-var-card .card-info-btn {
    position: absolute;
    bottom: 4px;
    right: 4px;
    opacity: 0;
    cursor: pointer;
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 3px;
    color: #4488ff;
    transition: opacity 0.15s;
}
.exp-var-card:hover .card-info-btn { opacity: 1; }
.exp-var-card .card-info-btn:hover { background: #4488ff33; }
.exp-var-card.map-curve {
    border-left-color: #ff8844;
}
.exp-info-row td {
    padding: 0.5rem;
    border-bottom: 1px solid #333;
}
.exp-info-row td:first-child {
    color: #888;
    width: 40%;
}

/* Map/Curve section */
.exp-map-section {
    margin-top: 1rem;
    border-top: 1px solid #333;
    padding-top: 1rem;
}
.exp-map-section h3 { color: #ff8844; }
.exp-map-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
}
.exp-map-table th, .exp-map-table td {
    padding: 0.4rem 0.6rem;
    border: 1px solid #333;
    text-align: center;
    font-size: 0.85rem;
}
.exp-map-table th { background: #252535; color: #888; }
.exp-map-table td { font-family: monospace; }
.exp-map-table td.editable { cursor: pointer; }
.exp-map-table td.editable:hover { background: #2a3a2a; }
.exp-map-table input {
    width: 80px;
    background: #1a1a2e;
    border: 1px solid #00ff88;
